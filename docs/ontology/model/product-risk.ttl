# =============================================================================
# 产商品运营本体 —— 场景②：产商品风险稽核（product-risk.ttl）
# -----------------------------------------------------------------------------
# 业务叙事：月度巡检。对存量产商品清理零元资费、异常全额赠送、长期零销、
#           低效产商品、逾期未复核等风险，并给出风险等级与整改动作。
#
# 入口端点：POST /api/v1/product-ontology/ops/risk-audit
#           body {"offeringIds":["84176765"]}
#           出参：items[].risks[].ruleId / items[].actions[] / 结论类型 getTypes()
#           批量：POST /api/v1/product-ontology/ops/batch-audit
#
# 引擎：R-B01~R-B05 + R-HR.* 全部 engine=swrl（Openllet），
#       失败回退 java-rules（OpsRiskAuditEngine，字段口径相同）。
#       阈值单源：ops_rules.json#/risk（RiskRules-v1.2）。
#
# 建模要点：
#   - 所有风险结论类均 ⊑ :Offering，逐规则一类便于回读命中规则。
#   - R-B01 同时产出两个结论类（零元资费 / 异常全额赠送）。
#   - HighRiskOffering 只由 R-HR.b02 / R-HR.discount 提升，不含 zeroFee 单点命中；
#     R-B05 再以 HighRiskOffering + 在架天数越阈 判定逾期未复核。
#   - lowRevenueFlag / lowEffCategoryFlag / emptyTargetGroup 为后端预计算布尔，
#     本体不再承载分位数计算（percentile 属 Java 引擎职责）。
# =============================================================================

@prefix :          <http://prodai.sitech.com/ontology/product#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix swrl:      <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb:     <http://www.w3.org/2003/11/swrlb#> .

<http://prodai.sitech.com/ontology/product-risk> rdf:type owl:Ontology ;
    rdfs:label "产商品运营本体-场景②风险稽核"@zh ;
    owl:versionInfo "1.0" ;
    rdfs:comment "零元资费 / 异常全额赠送 / 零元无合约在架 / 长期零销 / 低效品 / 逾期未复核。"@zh ;
    owl:imports <http://prodai.sitech.com/ontology/product-core> .


#################################################################
# 1. 类：风险结论（SWRL head）
#################################################################

:ZeroFeeRiskOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "零元资费风险"@zh ;
    rdfs:comment "R-B01.zeroFee：月费=0 且 一次性费=0 且 非白名单。"@zh .

:AbnormalDiscountOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "异常全额赠送"@zh ;
    rdfs:comment "R-B01.discount：折扣>=100 且 可重复订购 且 目标客户群为空。"@zh .

:ZeroFeeNoContractOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "零元无合约在架"@zh ;
    rdfs:comment "R-B02：零元资费 + 在架 + 无合约，等同长期白送。"@zh .

:ZeroSalesOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "长期零销"@zh ;
    rdfs:comment "R-B03：30日销量=0 且 在架天数 > 阈值。"@zh .

:LowEffOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "低效产商品"@zh ;
    rdfs:comment "R-B04：低效品类 且 低收益 且 非战略标签。"@zh .

:HighRiskOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "高风险产商品"@zh ;
    rdfs:comment "由 R-HR.b02（零元无合约在架）/ R-HR.discount（异常全额赠送）提升。"@zh .

:UrgentReviewOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "需紧急复核"@zh ;
    rdfs:comment "R-B05：高风险 且 在架天数 > 复核阈值。"@zh .

# 风险结论互斥性：零元资费与异常全额赠送为不同风险形态，不应同时为真
:ZeroFeeRiskOffering owl:disjointWith :AbnormalDiscountOffering .


#################################################################
# 2. 数据属性：风险判定事实（运行时断言，含预计算布尔）
#################################################################

:monthlyFee rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "月费"@zh ; rdfs:comment "货架字段直断言；0 为 R-B01.zeroFee 的必要条件。"@zh .

:oneTimeFee rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "一次性费用"@zh .

:salesCnt30d rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "30日销量"@zh .

:shelfDays rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "在架天数"@zh .

:revenue30d rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "30日收入"@zh ;
    rdfs:comment "断言入本体供核查；低效判定改用预计算布尔 lowRevenueFlag。"@zh .

:discountPercent rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "折扣百分比"@zh ; rdfs:comment "缺省 -1；正常取值 0~100。"@zh .

:hasContract rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "是否有合约"@zh .

:onShelf rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "是否在架"@zh .

:inWhitelist rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "是否白名单"@zh ;
    rdfs:comment "由 whitelistTag 或商品名包含白名单词计算。"@zh .

:repeatableFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "可重复订购"@zh ;
    rdfs:comment "源字段 repeatable；注意与配置侧 repeatableOrderFlag 不同名。"@zh .

:emptyTargetGroup rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "目标客户群为空"@zh ;
    rdfs:comment "源 targetCustomerGroup 为空或空白。"@zh .

:strategicTagFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "战略标签"@zh .

:lowEffCategoryFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "低效品类"@zh ;
    rdfs:comment "category ∈ R-B04.categories（low_eff / threshold_demo）。"@zh .

:lowRevenueFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "低收益"@zh ;
    rdfs:comment "revenue30d <= 低效分位阈值（lowRevenuePercentile=0.05），Java 预计算。"@zh .


#################################################################
# 3. 命名阈值个体（运行时按 ops_rules.json#/risk 覆写）
#################################################################

:th_RB01_fullDiscountPercentGte rdf:type owl:NamedIndividual , :RuleThreshold ;
    :thresholdValue "100"^^xsd:decimal ; rdfs:label "R-B01.fullDiscountPercentGte"@en .
:th_RB03_zeroSalesShelfDays rdf:type owl:NamedIndividual , :RuleThreshold ;
    :thresholdValue "180"^^xsd:decimal ; rdfs:label "R-B03.zeroSalesShelfDays"@en .
:th_RB05_highRiskReviewDays rdf:type owl:NamedIndividual , :RuleThreshold ;
    :thresholdValue "30"^^xsd:decimal ; rdfs:label "R-B05.highRiskReviewDays"@en .


#################################################################
# 4. SWRL 变量声明
#################################################################

:v_b1o rdf:type swrl:Variable . :v_b1mf rdf:type swrl:Variable . :v_b1ot rdf:type swrl:Variable . :v_b1wl rdf:type swrl:Variable .
:v_b1do rdf:type swrl:Variable . :v_b1dd rdf:type swrl:Variable . :v_b1dr rdf:type swrl:Variable . :v_b1de rdf:type swrl:Variable .
:v_b1t rdf:type swrl:Variable .
:v_b2o rdf:type swrl:Variable . :v_b2s rdf:type swrl:Variable . :v_b2c rdf:type swrl:Variable .
:v_b3o rdf:type swrl:Variable . :v_b3s rdf:type swrl:Variable . :v_b3d rdf:type swrl:Variable . :v_b3t rdf:type swrl:Variable .
:v_b4o rdf:type swrl:Variable . :v_b4c rdf:type swrl:Variable . :v_b4r rdf:type swrl:Variable . :v_b4s rdf:type swrl:Variable .
:v_b5o rdf:type swrl:Variable . :v_b5d rdf:type swrl:Variable . :v_b5t rdf:type swrl:Variable .
:v_hr1 rdf:type swrl:Variable . :v_hr2 rdf:type swrl:Variable .


#################################################################
# 5. SWRL 规则（R-B01 ~ R-B05 + R-HR.*）
#################################################################

# R-B01.zeroFee：月费=0 且 一次性费=0 且 非白名单 → 零元资费风险
[ rdf:type swrl:Imp ;
  rdfs:label "R-B01.zeroFee"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_b1o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :monthlyFee ; swrl:argument1 :v_b1o ; swrl:argument2 :v_b1mf ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :oneTimeFee ; swrl:argument1 :v_b1o ; swrl:argument2 :v_b1ot ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :inWhitelist ; swrl:argument1 :v_b1o ; swrl:argument2 :v_b1wl ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b1mf "0"^^xsd:decimal ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b1ot "0"^^xsd:decimal ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b1wl "false"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ZeroFeeRiskOffering ; swrl:argument1 :v_b1o ] ) ] .

# R-B01.discount：折扣>=阈值 且 可重复订购 且 目标客户群为空 → 异常全额赠送
[ rdf:type swrl:Imp ;
  rdfs:label "R-B01.discount"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_b1do ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :discountPercent ; swrl:argument1 :v_b1do ; swrl:argument2 :v_b1dd ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :repeatableFlag ; swrl:argument1 :v_b1do ; swrl:argument2 :v_b1dr ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :emptyTargetGroup ; swrl:argument1 :v_b1do ; swrl:argument2 :v_b1de ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RB01_fullDiscountPercentGte ; swrl:argument2 :v_b1t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :v_b1dd :v_b1t ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b1dr "true"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b1de "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AbnormalDiscountOffering ; swrl:argument1 :v_b1do ] ) ] .

# R-B02：零元资费风险 且 在架 且 无合约 → 零元无合约在架
[ rdf:type swrl:Imp ;
  rdfs:label "R-B02"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ZeroFeeRiskOffering ; swrl:argument1 :v_b2o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :onShelf ; swrl:argument1 :v_b2o ; swrl:argument2 :v_b2s ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasContract ; swrl:argument1 :v_b2o ; swrl:argument2 :v_b2c ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b2s "true"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b2c "false"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ZeroFeeNoContractOffering ; swrl:argument1 :v_b2o ] ) ] .

# R-B03：30日销量=0 且 在架天数 > 阈值 → 长期零销
[ rdf:type swrl:Imp ;
  rdfs:label "R-B03"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_b3o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :salesCnt30d ; swrl:argument1 :v_b3o ; swrl:argument2 :v_b3s ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :shelfDays ; swrl:argument1 :v_b3o ; swrl:argument2 :v_b3d ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RB03_zeroSalesShelfDays ; swrl:argument2 :v_b3t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b3s "0"^^xsd:decimal ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( :v_b3d :v_b3t ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ZeroSalesOffering ; swrl:argument1 :v_b3o ] ) ] .

# R-B04：低效品类 且 低收益 且 非战略 → 低效产商品
[ rdf:type swrl:Imp ;
  rdfs:label "R-B04"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_b4o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :lowEffCategoryFlag ; swrl:argument1 :v_b4o ; swrl:argument2 :v_b4c ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :lowRevenueFlag ; swrl:argument1 :v_b4o ; swrl:argument2 :v_b4r ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :strategicTagFlag ; swrl:argument1 :v_b4o ; swrl:argument2 :v_b4s ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b4c "true"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b4r "true"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_b4s "false"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :LowEffOffering ; swrl:argument1 :v_b4o ] ) ] .

# R-B05：高风险 且 在架天数 > 复核阈值 → 需紧急复核
[ rdf:type swrl:Imp ;
  rdfs:label "R-B05"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :HighRiskOffering ; swrl:argument1 :v_b5o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :shelfDays ; swrl:argument1 :v_b5o ; swrl:argument2 :v_b5d ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RB05_highRiskReviewDays ; swrl:argument2 :v_b5t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( :v_b5d :v_b5t ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :UrgentReviewOffering ; swrl:argument1 :v_b5o ] ) ] .

# R-HR.b02：零元无合约在架 → 高风险
[ rdf:type swrl:Imp ;
  rdfs:label "R-HR.b02"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ZeroFeeNoContractOffering ; swrl:argument1 :v_hr1 ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :HighRiskOffering ; swrl:argument1 :v_hr1 ] ) ] .

# R-HR.discount：异常全额赠送 → 高风险
[ rdf:type swrl:Imp ;
  rdfs:label "R-HR.discount"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AbnormalDiscountOffering ; swrl:argument1 :v_hr2 ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :HighRiskOffering ; swrl:argument1 :v_hr2 ] ) ] .
