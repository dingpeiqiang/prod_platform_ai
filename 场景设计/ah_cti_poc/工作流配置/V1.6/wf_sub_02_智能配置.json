        "code": "import json, re\nfrom typing import Any, Dict\nasync def main(args):\n    raw = args.params['list']\n    if not isinstance(raw, str):\n        raw = json.dumps(raw, ensure_ascii=False)\n    s = raw.strip()\n    try:\n        data = json.loads(s)\n    except Exception:\n        m = re.search(r'\\[[\\s\\S]*\\]', s)\n        data = None\n        if m:\n            try:\n                data = json.loads(m.group(0))\n            except Exception:\n                data = None\n    if isinstance(data, dict):\n        recs = [data]\n    elif isinstance(data, list):\n        recs = data\n    else:\n        recs = []\n    plan_json = ''\n    for rec in recs:\n        if isinstance(rec, dict) and isinstance(rec.get('result_json'), str):\n            plan_json = rec['result_json']\n            break\n    if not plan_json:\n        plan_json = s\n    plan_id = ''\n    try:\n        obj = json.loads(plan_json)\n        if isinstance(obj, dict):\n            plan_id = str(obj.get('plan_id') or '')\n    except Exception:\n        pass\n    if not plan_id:\n        m2 = re.search(r'\"plan_id\"\\s*:\\s*\"([^\"]+)\"', plan_json)\n        if m2:\n            plan_id = m2.group(1)\n    ret: Output = {\n        \"plan_json\": plan_json,\n        \"plan_id\": plan_id\n    }\n    return ret",
