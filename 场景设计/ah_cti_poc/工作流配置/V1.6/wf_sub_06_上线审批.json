        "outputs": [
          {
            "relName": "a1b2c3d4-0000-4000-8000-000000005021,summary_json",
            "name": "summary_json",
            "type": "string"
          },
          {
            "relName": "a1b2c3d4-0000-4000-8000-000000005021,product_id",
