          },
          {
            "relName": "a1b2c3d4-0000-4000-8000-000000000501s,product_id",
            "name": "product_id",
            "type": "string"
          }
        ],
        "code": "import json, re\nfrom typing import Any, Dict\n\ndef pick_list(raw):\n    if isinstance(raw, str):\n        s = raw.strip()\n    else:\n        s = json.dumps(raw, ensure_ascii=False)\n    try:\n        data = json.loads(s)\n    except Exception:\n        m = re.search(r'\\[[\\s\\S]*\\]', s)\n        data = None\n        if m:\n            try:\n                data = json.loads(m.group(0))\n            except Exception:\n                data = None\n    if isinstance(data, dict):\n        return [data]\n    if isinstance(data, list):\n        return data\n    return []\n\ndef first_result_json(raw):\n    for rec in pick_list(raw):\n        if isinstance(rec, dict) and isinstance(rec.get('result_json'), str):\n            return rec['result_json']\n    return ''\n\ndef to_dict(text):\n    if not text:\n        return {}\n    try:\n        obj = json.loads(text)\n        return obj if isinstance(obj, dict) else {}\n    except Exception:\n        m = re.search(r'\\{[\\s\\S]*\\}', text)\n        if m:\n            try:\n                obj = json.loads(m.group(0))\n                return obj if isinstance(obj, dict) else {}\n            except Exception:\n                return {}\n    return {}\n\ndef to_str(v):\n    if v is None:\n        return ''\n    if isinstance(v, str):\n        return v\n    return json.dumps(v, ensure_ascii=False)\n\nasync def main(args):\n    p = args.params\n    plan = to_dict(first_result_json(p.get('list_req')))\n    cfg = to_dict(first_result_json(p.get('list_cfg')))\n    spec = to_dict(first_result_json(p.get('list_spec')))\n    fee = to_dict(first_result_json(p.get('list_fee')))\n    test = to_dict(first_result_json(p.get('list_test')))\n    fields = plan.get('fields')\n    if not isinstance(fields, list):\n        fields = []\n    similar = plan.get('similar_offers')\n    if not isinstance(similar, list):\n        similar = []\n    top = similar[0] if similar else {}\n    summary = {\n        \"execution_id\": to_str(p.get('req_id')),\n        \"requirement\": {\n            \"plan_id\": to_str(plan.get('plan_id')),\n            \"fields\": [{\"field\": str(f.get('field') if isinstance(f, dict) else f),\n                        \"value\": str(f.get('value') if isinstance(f, dict) else ''),\n                        \"source\": str(f.get('source') if isinstance(f, dict) else '')} for f in fields],\n            \"similar_offer_count\": len(similar),\n            \"top_similar_offer\": {k: str(v) for k, v in top.items()} if isinstance(top, dict) else {}\n        },\n        \"config\": {\n            \"product_id\": to_str(cfg.get('product_id')),\n            \"offer_id\": to_str(cfg.get('offer_id')),\n            \"save_result\": cfg.get('save_result'),\n            \"status\": to_str(cfg.get('status'))\n        },\n        \"spec_audit\": {\n            \"pass\": to_str(spec.get('pass')),\n            \"error_list\": spec.get('error_list'),\n            \"audit_summary\": to_str(spec.get('audit_summary')),\n            \"audit_suggest\": to_str(spec.get('audit_suggest'))\n        },\n        \"fee_check\": {\n            \"pass\": to_str(fee.get('pass')),\n            \"risk_list\": fee.get('risk_list'),\n            \"risk_summary\": to_str(fee.get('risk_summary'))\n        },\n        \"auto_test\": {\n            \"globalId\": to_str(test.get('globalId')),\n            \"orderId\": to_str(test.get('orderId')),\n            \"offerInstId\": to_str(test.get('offerInstId')),\n            \"test_passed\": to_str(test.get('test_passed')),\n            \"test_report\": to_str(test.get('test_report'))\n        }\n    }\n    ret: Output = {\n        \"summary_json\": json.dumps(summary, ensure_ascii=False),\n        \"product_id\": summary[\"config\"][\"product_id\"]\n    }\n    return ret",
