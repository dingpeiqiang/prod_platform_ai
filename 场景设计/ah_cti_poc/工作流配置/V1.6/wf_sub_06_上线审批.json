        "code": "import json, re\nfrom typing import Any, Dict\nasync def main(args):\n    raw = args.params['list']\n    if not isinstance(raw, str):\n        raw = json.dumps(raw, ensure_ascii=False)\n    s = raw.strip()\n    try:\n        data = json.loads(s)\n    except Exception:\n        m = re.search(r'\\[[\\s\\S]*\\]', s)\n        data = None\n        if m:\n            try:\n                data = json.loads(m.group(0))\n            except Exception:\n                data = None\n    recs = []\n    if isinstance(data, dict):\n        recs = [data]\n    elif isinstance(data, list):\n        recs = data\n    result_json = ''\n    for rec in recs:\n        if isinstance(rec, dict) and isinstance(rec.get('result_json'), str):\n            result_json = rec['result_json']\n            break\n    cfg = None\n    if result_json:\n        try:\n            cfg = json.loads(result_json)\n        except Exception:\n            m2 = re.search(r'\\{[\\s\\S]*\\}', result_json)\n            if m2:\n                try:\n                    cfg = json.loads(m2.group(0))\n                except Exception:\n                    cfg = None\n    product_id = ''\n    if isinstance(cfg, dict):\n        product_id = str(cfg.get('product_id') or '')\n    ret: Output = {\n        \"product_id\": product_id\n    }\n    return ret",
