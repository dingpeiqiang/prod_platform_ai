        "code": "import json, re\nfrom typing import Any, Dict\nasync def main(args):\n    raw = args.params['list']\n    if not isinstance(raw, str):\n        raw = json.dumps(raw, ensure_ascii=False)\n    s = raw.strip()\n    try:\n        data = json.loads(s)\n    except Exception:\n        m = re.search(r'\\[[\\s\\S]*\\]', s)\n        data = None\n        if m:\n            try:\n                data = json.loads(m.group(0))\n            except Exception:\n                data = None\n    recs = []\n    if isinstance(data, dict):\n        recs = [data]\n    elif isinstance(data, list):\n        recs = data\n    result_json = ''\n    for rec in recs:\n        if isinstance(rec, dict) and isinstance(rec.get('result_json'), str):\n            result_json = rec['result_json']\n            break\n    config_json = result_json\n    if result_json:\n        try:\n            cfg = json.loads(result_json)\n            if isinstance(cfg, dict):\n                save_result = cfg.get('save_result')\n                if save_result is not None and not isinstance(save_result, str):\n                    save_result = json.dumps(save_result, ensure_ascii=False)\n                if isinstance(save_result, str) and save_result:\n                    config_json = save_result\n        except Exception:\n            pass\n    ret: Output = {\n        \"config_json\": config_json\n    }\n    return ret",
