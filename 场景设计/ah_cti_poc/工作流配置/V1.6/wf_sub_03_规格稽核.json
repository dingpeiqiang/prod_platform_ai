        "code": "import json\nfrom typing import Any, Dict\nasync def main(args):\n    p = args.params\n    offer_id = p.get('offer_id') or ''\n    if not isinstance(offer_id, str):\n        offer_id = json.dumps(offer_id, ensure_ascii=False)\n    def to_str(v):\n        if v is None:\n            return ''\n        if isinstance(v, str):\n            return v\n        return json.dumps(v, ensure_ascii=False)\n    payload = {\n        \"offer_id\": offer_id,\n        \"pass\": to_str(p.get('pass')),\n        \"error_list\": p.get('error_list'),\n        \"audit_summary\": to_str(p.get('audit_summary')),\n        \"audit_suggest\": to_str(p.get('audit_suggest'))\n    }\n    ret: Output = {\n        \"result_json\": json.dumps(payload, ensure_ascii=False)\n    }\n    return ret",
