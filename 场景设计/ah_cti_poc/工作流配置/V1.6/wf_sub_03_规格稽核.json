        "code": "import json, re\nfrom typing import Any, Dict\nasync def main(args):\n    raw = args.params['list']\n    if not isinstance(raw, str):\n        raw = json.dumps(raw, ensure_ascii=False)\n    s = raw.strip()\n    try:\n        data = json.loads(s)\n    except Exception:\n        m = re.search(r'\\[[\\s\\S]*\\]', s)\n        data = None\n        if m:\n            try:\n                data = json.loads(m.group(0))\n            except Exception:\n                data = None\n    recs = []\n    if isinstance(data, dict):\n        recs = [data]\n    elif isinstance(data, list):\n        recs = data\n    result_json = ''\n    for rec in recs:\n        if isinstance(rec, dict) and isinstance(rec.get('result_json'), str):\n            result_json = rec['result_json']\n            break\n    cfg = None\n    if result_json:\n        try:\n            cfg = json.loads(result_json)\n        except Exception:\n            m2 = re.search(r'\\{[\\s\\S]*\\}', result_json)\n            if m2:\n                try:\n                    cfg = json.loads(m2.group(0))\n                except Exception:\n                    cfg = None\n    offer_id = ''\n    config_json = result_json\n    if isinstance(cfg, dict):\n        offer_id = str(cfg.get('offer_id') or '')\n        save_result = cfg.get('save_result')\n        if save_result is not None and not isinstance(save_result, str):\n            save_result = json.dumps(save_result, ensure_ascii=False)\n        config_json = save_result if isinstance(save_result, str) and save_result else result_json\n    ret: Output = {\n        \"offer_id\": offer_id,\n        \"config_json\": config_json\n    }\n    return ret",
        "flowJson": null,
