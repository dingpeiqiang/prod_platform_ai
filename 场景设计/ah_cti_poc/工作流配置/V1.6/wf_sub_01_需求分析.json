        "code": "import json, re, random\nfrom datetime import datetime\nfrom typing import Any, Dict\nasync def main(args):\n    raw = args.params['plan_output']\n    if not isinstance(raw, str):\n        raw = json.dumps(raw, ensure_ascii=False)\n    m = re.search(r'\\{[\\s\\S]*\\}', raw)\n    if not m:\n        obj = {}\n    else:\n        try:\n            obj = json.loads(m.group(0))\n        except Exception:\n            obj = {}\n    pf = obj.get('pending_fields') or ''\n    if isinstance(pf, list):\n        pf = ','.join([str(x) for x in pf])\n    plan_json = obj.get('plan_json')\n    if not isinstance(plan_json, str):\n        plan_json = json.dumps(plan_json if plan_json is not None else obj, ensure_ascii=False)\n    req_id = 'PLAN' + datetime.now().strftime('%Y%m%d%H%M%S') + '%03d' % random.randint(0, 999)\n    try:\n        pj = json.loads(plan_json)\n        if isinstance(pj, dict):\n            pj['req_id'] = req_id\n            plan_json = json.dumps(pj, ensure_ascii=False)\n    except Exception:\n        pass\n    ret: Output = {\n        \"plan_json\": plan_json,\n        \"plan_md\": str(obj.get('plan_md') or ''),\n        \"pending_fields\": str(pf),\n        \"req_id\": req_id\n    }\n    return ret",
