        "code": "import json\n\n\ndef _sub(tpl, vals):\n    s = tpl\n    for k in vals:\n        s = s.replace('{' + k + '}', vals[k])\n    return s\n\nSEG_0_TPL = '{approval_receipt}\\n\\n**页面地址：** 经 xsbot-panel 外链加载（配置工作台 / 环节业务页）：'\n\n\nPARTS = [\n    ('text', SEG_0_TPL),\n    ('panel', PANEL_00_TPL),\n]\n\nasync def main(args):\n    p = args.params\n\n    def _s(k):\n        v = p.get(k)\n        return '' if v is None else str(v)\n\n    vals = {\n        'approval_receipt': _s('approval_receipt'),\n    }\n\n    def _render_panel(tpl):\n        return \"\\n```xsbot-panel\\n\" + json.dumps(json.loads(_sub(tpl, vals)), ensure_ascii=False) + \"\\n```\\n\"\n\n    buf = []\n    for kind, tpl in PARTS:\n        if kind == 'text':\n            buf.append(_sub(tpl, vals))\n        else:\n            buf.append(_render_panel(tpl))\n    content = \"\".join(buf)\n\n    return {\n        'content': content\n    }",
