          },
          {
            "relName": "a1b2c3d4-0000-4000-8000-000000000107,fusion_status",
            "name": "fusion_status",
            "type": "string"
          }
        ],
        "code": "import json\nfrom typing import Any, Dict\n\ndef _load(text):\n    if not isinstance(text, str) or not text.strip():\n        return {}\n    try:\n        return json.loads(text)\n    except Exception:\n        try:\n            t = text.strip()\n            if ':' in t and not t.startswith('{') and not t.startswith('['):\n                t = t.split(':', 1)[1].strip()\n            return json.loads(t)\n        except Exception:\n            return {}\n\nasync def main(args):\n    p = args.params\n    cfg = _load(p.get('group_json') or '')\n    merged = cfg.get('group') if isinstance(cfg.get('group'), dict) else None\n    if not merged:\n        ret: Output = {'fusion_echo': '', 'fusion_status': str(p.get('status') or '')}\n        return ret\n    members = merged.get('members') or []\n    parts = []\n    for m in members:\n        role = str(m.get('role') or '')\n        oid = str(m.get('offer_id') or '')\n        if role:\n            parts.append('%s（offer_id %s）' % (role, oid))\n    main_id = str(merged.get('main_offer_id') or cfg.get('offer_id') or '')\n    line = '融合成员：'\n    if main_id:\n        line += '主 offer_id %s / ' % main_id\n    line += ' / '.join(parts) if parts else ''\n    ret: Output = {\n        \"fusion_echo\": line if parts else '',\n        \"fusion_status\": str(p.get('status') or ''),\n    }\n    return ret",
