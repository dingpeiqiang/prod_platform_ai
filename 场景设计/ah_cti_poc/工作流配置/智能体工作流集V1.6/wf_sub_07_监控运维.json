        "code": "import json, urllib.request\nfrom typing import Any, Dict\n\nANALYZE_URL = 'http://10.86.13.201:31281/api/v1/appstore/product/monitor/analyze'\n\ndef _load(v):\n    if isinstance(v, list):\n        return v\n    if isinstance(v, dict):\n        return [v]\n    if not isinstance(v, str) or not v.strip():\n        return []\n    try:\n        obj = json.loads(v)\n        if isinstance(obj, dict) and isinstance(obj.get('offers'), list):\n            return obj['offers']\n        return obj if isinstance(obj, list) else ([obj] if isinstance(obj, dict) else [])\n    except Exception:\n        return []\n\ndef _num(v):\n    try:\n        return float(str(v).strip() or 0)\n    except Exception:\n        return 0.0\n\ndef _fetch(req_id, offer_id, date_range):\n    body = json.dumps({'req_id': req_id, 'offer_id': offer_id, 'date_range': date_range}).encode('utf-8')\n    req = urllib.request.Request(ANALYZE_URL, data=body, method='POST',\n                                 headers={'Content-Type': 'application/json'})\n    with urllib.request.urlopen(req, timeout=30) as resp:\n        return json.loads(resp.read().decode('utf-8'))\n\nasync def main(args):\n    p = args.params\n    req_id = str(p.get('req_id') or '')\n    offer_id = str(p.get('offer_id') or '')\n    date_range = str(p.get('date_range') or '')\n    try:\n        info = _fetch(req_id, offer_id, date_range)\n    except Exception:\n        info = None\n    if info and info.get('offers'):\n        offers = info.get('offers') or []\n        first = next((o for o in offers if str(o.get('alert_level') or 'NONE') != 'NONE'),\n                     offers[0] if offers else {})\n        ret: Output = {\n            'any_abnormal': str(info.get('any_abnormal') or 'false'),\n            'monitor_lines': str(info.get('monitor_lines') or ''),\n            'summary': str(info.get('summary') or ''),\n            'alert_count': str(info.get('alert_count') or '0'),\n            'work_order_count': str(info.get('work_order_count') or '0'),\n            'first_offer_id': str(first.get('offer_id') or ''),\n            'first_offer_name': str(first.get('offer_name') or ''),\n            'offers': json.dumps(offers, ensure_ascii=False),\n        }\n        return ret\n    # ---- 本地兜底聚合（接口不可达）----\n    offers = [o for o in _load(p.get('offers')) if isinstance(o, dict)]\n    if not offers and offer_id:\n        offers = [{'offer_id': offer_id, 'offer_name': str(p.get('offer_name') or ''),\n                   'error_count': str(p.get('error_count') or '0')}]\n    any_ab = False\n    lines = []\n    first = {}\n    for o in offers:\n        ec = _num(o.get('error_count'))\n        ab = ec != 0\n        if ab and not first:\n            first = o\n        if ab:\n            any_ab = True\n        nm = str(o.get('offer_name') or o.get('offer_id') or '')\n        lines.append('- %s：订单量 %s（%s），异常量 %s（%s），计费差错率 %s，等级 %s'\n                     % (nm, str(o.get('order_count') or ''), str(o.get('order_trend') or ''),\n                        str(o.get('error_count') or ''), str(o.get('error_trend') or ''),\n                        str(o.get('fee_error_rate') or ''), '异常' if ab else '正常'))\n    if not first and offers:\n        first = offers[0]\n    ret: Output = {\n        'any_abnormal': 'true' if any_ab else 'false',\n        'monitor_lines': chr(10).join(lines),\n        'summary': '监控完成（本地兜底聚合，聚合分析接口不可达）',\n        'alert_count': '0',\n        'work_order_count': '0',\n        'first_offer_id': str(first.get('offer_id') or ''),\n        'first_offer_name': str(first.get('offer_name') or ''),\n        'offers': json.dumps(offers, ensure_ascii=False),\n    }\n    return ret\n\n",
