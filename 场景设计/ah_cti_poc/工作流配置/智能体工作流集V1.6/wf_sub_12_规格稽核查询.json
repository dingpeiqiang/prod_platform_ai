        "code": "import json\nimport asyncio\nimport urllib.request\nfrom typing import Any, Dict\n\nSQL_URL = 'http://10.86.13.201:31281/api/v1/appstore/audit/sql-query'\nINTERVAL = 5\nMAX_RETRY = 60\nMAX_CONSECUTIVE_FAIL = 5\nSQL_ID_FINISH = '20260626001'\n\nasync def main(args):\n    request_ids = str(args.params.get('requestIds') or '')\n    if not request_ids:\n        ret: Output = {'completed': 'false',\n                       'fail_reason': '缺少 requestIds，请先发起稽核（环节4a）'}\n        return ret\n    consecutive_fail = 0\n    for i in range(MAX_RETRY):\n        resp = {}\n        ok = False\n        try:\n            body = json.dumps({'sqlId': SQL_ID_FINISH,\n                               'params': {'requestIds': request_ids}}).encode('utf-8')\n            req = urllib.request.Request(SQL_URL, data=body,\n                                         headers={'Content-Type': 'application/json'})\n            with urllib.request.urlopen(req, timeout=30) as http_resp:\n                resp = json.loads(http_resp.read().decode('utf-8'))\n            ok = isinstance(resp, dict)\n        except Exception:\n            ok = False\n        if not ok:\n            consecutive_fail += 1\n            if consecutive_fail >= MAX_CONSECUTIVE_FAIL:\n                ret: Output = {'completed': 'false',\n                               'fail_reason': '连续查询失败5次，转人工（requestIds=' + request_ids + '）'}\n                return ret\n            await asyncio.sleep(INTERVAL)\n            continue\n        consecutive_fail = 0\n        finished = str(resp.get('isAllFinished', resp.get('finished', ''))).lower()\n        if finished in ('y', 'yes', 'true', '1'):\n            ret: Output = {'completed': 'true', 'fail_reason': ''}\n            return ret\n        await asyncio.sleep(INTERVAL)\n    ret: Output = {'completed': 'false',\n                   'fail_reason': '稽核处理中，请稍后回复【查询稽核结果】续查（requestIds=' + request_ids + '）'}\n    return ret",
