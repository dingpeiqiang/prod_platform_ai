        "code": "from typing import Any, Dict\n\ndef _csv(v):\n    # offers 入参可能是 JSON 数组字符串或已归一数组，拍平为 offer_id 逗号串\n    import json as _json\n    if isinstance(v, str):\n        s = v.strip()\n        if not s:\n            return ''\n        try:\n            v = _json.loads(s)\n        except Exception:\n            v = s\n    if isinstance(v, dict) and isinstance(v.get('offers'), list):\n        v = v['offers']\n    if not isinstance(v, list):\n        return ''\n    ids = []\n    for o in v:\n        oid = str((o or {}).get('offer_id') or '') if isinstance(o, dict) else ''\n        if oid:\n            ids.append(oid)\n    return ','.join(ids)\n\nasync def main(args):\n    p = args.params\n    chat_id = str(p.get('chat_id') or '')\n    offer_id = str(p.get('offer_id') or '')\n    offer_name = str(p.get('offer_name') or '')\n    req_id = str(p.get('req_id') or '')\n    offers_csv = _csv(p.get('offers'))\n    qs = ('?chatId=' + chat_id + '&req_id=' + req_id + '&stage=12&view=stage')\n    if offer_id:\n        qs = ('?offer_id=' + offer_id + '&name=' + offer_name + '&chatId=' + chat_id + '&req_id=' + req_id + '&stage=12&view=stage')\n    if offers_csv:\n        qs += '&offers=' + offers_csv\n    biz_url = 'http://10.86.13.201:31280/prod-ai/ops-web/config-workbench.html' + qs\n    panel = (\n        \"\\n\\n```xsbot-panel\\n\"\n        + '{\"version\":\"1.0\",\"message_id\":\"' + chat_id + '\",'\n        + '\"panels\":[{\"panel\":\"right\",\"mode\":\"external\",\"url\":\"' + biz_url + '\",\"title\":\"优化工单审批\"}]}'\n        + \"\\n```\\n\"\n    )\n    result: Output = {'panel': panel}\n    return result\n",
