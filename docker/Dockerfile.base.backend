# ============================================================
# AI驱动动态表单 - 后端基础镜像（Spring Boot / backend-app）
# 预装 JDK 17 + 完整 Maven 本地仓库（供无外网环境离线打包）
#
# 重要：本镜像必须在「能访问 Maven 仓库」的环境构建，再推到私有仓库；
# 公司无外网机器只拉此镜像做应用构建，不再访问外网。
# ============================================================

FROM maven:3.9.9-eclipse-temurin-17

LABEL maintainer="prod-platform"
LABEL version="2.1"
LABEL description="AI动态表单后端基础镜像 (JDK 17 + Maven offline deps)"

# 可选：构建时注入公司内网 Maven（不传则用 settings 默认）
# docker build --build-arg MAVEN_MIRROR_URL=http://nexus.company.local/repository/maven-public ...
ARG MAVEN_MIRROR_URL=

# 注意：maven:*-eclipse-temurin-17 已含 curl / ca-certificates，勿再 apt-get
# （国内访问 archive.ubuntu.com 极慢，单步常耗时 10~30 分钟）

WORKDIR /build

# Maven settings：默认阿里云；若传入 MAVEN_MIRROR_URL 则覆盖为公司仓库
COPY backend-app/.mvn/local-settings.xml /root/.m2/settings.xml
RUN if [ -n "$MAVEN_MIRROR_URL" ]; then \
      printf '%s\n' \
        '<?xml version="1.0" encoding="UTF-8"?>' \
        '<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">' \
        '  <mirrors><mirror>' \
        '    <id>company-mirror</id>' \
        '    <name>Company Maven</name>' \
        "    <url>${MAVEN_MIRROR_URL}</url>" \
        '    <mirrorOf>*</mirrorOf>' \
        '  </mirror></mirrors>' \
        '</settings>' > /root/.m2/settings.xml; \
    fi

# 复制完整工程以拉齐编译/插件依赖（比只拷 pom 更完整）
COPY backend-app/ ./

# 1) 在线拉齐依赖与插件并编译
# 2) 立刻用 mvn -o 自检离线可编（与 Sitech.BJ.Dockerfile.backend 一致），不通过则基础镜像构建失败
RUN mvn -B -U -DskipTests dependency:resolve dependency:resolve-plugins package \
    && mvn -o -B -DskipTests clean package \
    && rm -rf /build/target \
    && mkdir -p /app/logs /app/uploads

ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8" \
    TZ=Asia/Shanghai \
    LANG=C.UTF-8 \
    MAVEN_OPTS="-Dmaven.repo.local=/root/.m2/repository"

EXPOSE 6174
