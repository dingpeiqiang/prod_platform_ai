# ============================================================
# AI驱动动态表单 - 前端容器（使用预构建基础镜像）
# 基础镜像已包含：Nginx + Node.js 20 + npm依赖
# ============================================================

FROM  10.86.12.11:20200/crm-pgcent/prod-platform-frontend-base:1.0

LABEL maintainer="AI Platform"
LABEL version="1.0"
LABEL description="AI Dynamic Form Frontend Production"

WORKDIR /app

# 复制前端源码
COPY frontend/ ./

# 构建生产版本（node_modules 已在基础镜像中）
ARG VITE_API_BASE_URL=http://localhost:6173
ARG VITE_APP_TITLE="AI动态表单平台"
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_TITLE=$VITE_APP_TITLE

RUN npm run build

# 将构建产物复制到 nginx 目录
RUN cp -r dist/* /usr/share/nginx/html/ && \
    rm -rf dist 2>/dev/null || true

# 暴露端口
EXPOSE 80

# 启动 nginx
CMD ["nginx", "-g", "daemon off;"]
