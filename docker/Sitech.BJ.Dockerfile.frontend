# ============================================================
# AI驱动动态表单 - 前端容器（使用预构建基础镜像）
# 基础镜像已包含：Nginx 1.30.4（漏洞修复版）+ Node.js 20 + npm依赖
# 运行身份：非 root（uid=101 nginx）
# ============================================================

# 使用自定义基础镜像
# 注意：修改版本号时，请同步更新 docker-manager.ps1 中的配置
FROM 10.86.12.11:20200/y21127-crmpos/prod-platform-frontend-base:2.0

LABEL maintainer="AI Platform"
LABEL version="2.0"
LABEL description="AI Dynamic Form Frontend Production"

WORKDIR /app

# 构建参数（API 走相对路径，由 Nginx 反代到 backend:6174）
ARG VITE_API_BASE_URL=
ARG VITE_APP_TITLE="AI动态表单平台"
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_TITLE=$VITE_APP_TITLE

# ============================================================
# 构建阶段：源码 + vite build（node_modules 已预装于基础镜像）
# ============================================================

COPY frontend/ ./

RUN npm run build

# ============================================================
# 发布阶段：仅保留静态产物 + 配置，清除构建痕迹
# ============================================================

RUN cp -r dist/. /usr/share/nginx/html/ \
    && chown -R nginx:nginx /usr/share/nginx/html \
    && rm -rf dist node_modules /app/src

# 覆盖主配置（完整 nginx.conf → upstream backend:6174，listen 6173）
COPY frontend/nginx.conf /etc/nginx/nginx.conf

RUN chown nginx:nginx /etc/nginx/nginx.conf \
    && nginx -t

EXPOSE 6173

USER nginx

CMD ["nginx", "-g", "daemon off;"]
