# ============================================================
# AI驱动动态表单 - 前端基础镜像（优化版）
# 包含 Node.js（用于构建）+ Nginx（用于运行）+ 最小化依赖
# ============================================================

FROM node:20-alpine

LABEL maintainer="prod-platform"
LABEL version="1.0"
LABEL description="AI动态表单前端基础镜像 (Node.js + Nginx)"

# ============================================================
# 安装最小化依赖
# ============================================================

# 安装 nginx 和必要工具
RUN apk update && apk add --no-cache \
    nginx \
    && rm -rf /var/cache/apk/*

# 验证 Node.js 和 npm 版本
RUN node --version && npm --version

# ============================================================
# 配置 npm 和安装项目依赖（最小化）
# ============================================================

WORKDIR /app

# 配置 npm 国内镜像源
RUN npm config set registry https://registry.npmmirror.com

# 复制 package 文件
COPY frontend/package.json frontend/package-lock.json ./

# 安装完整依赖（包括开发依赖用于构建）
RUN npm ci --no-audit --no-fund \
    && npm cache clean --force 2>/dev/null || true \
    && rm -rf ~/.npm \
    && rm -rf node_modules/.cache 2>/dev/null || true \
    && find node_modules -type f -name "*.md" -delete 2>/dev/null || true \
    && find node_modules -type f -name "*.map" -delete 2>/dev/null || true \
    && find node_modules -type d -name "test" -exec rm -rf {} + 2>/dev/null || true \
    && find node_modules -type d -name "__tests__" -exec rm -rf {} + 2>/dev/null || true \
    && find node_modules -type d -name "examples" -exec rm -rf {} + 2>/dev/null || true \
    && find node_modules -type d -name "docs" -exec rm -rf {} + 2>/dev/null || true \
    && find node_modules -type d -name "*.log" -exec rm -rf {} + 2>/dev/null || true

# ============================================================
# 配置 Nginx（最小化）
# ============================================================

# 创建非 root 用户
RUN addgroup -S nginx-group -g 1001 && \
    adduser -S nginx-user -u 1001 -G nginx-group

# 设置默认 nginx 配置
COPY docker/nginx-default.conf /etc/nginx/conf.d/default.conf

# 创建必要的目录并设置权限
RUN mkdir -p /usr/share/nginx/html /var/cache/nginx /var/run && \
    chown -R nginx-user:nginx-group /usr/share/nginx/html /var/cache/nginx /var/run && \
    sed -i 's/^user root;/user nginx-user;/' /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
