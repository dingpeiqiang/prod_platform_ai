# ============================================================
# AI驱动动态表单 - 前端基础镜像
# 修复 2026-05 批量披露的 Nginx 系列高危漏洞（CVE-2026-42945 等 7 项），
# nginx 1.30.4 为官方安全公告确认的最终修复版本。
# 架构：Node 20（离线构建用）+ Nginx 1.30.4（运行用）+ 预装 npm 依赖
# 用途：公司无外网环境的应用镜像构建底座（Sitech.BJ.Dockerfile.frontend）
# ============================================================

FROM node:20-alpine AS base

LABEL maintainer="prod-platform"
LABEL version="2.0"
LABEL description="AI动态表单前端基础镜像 (Node.js 20 + Nginx 1.30.4)"

# ============================================================
# 阶段 1：安装 Nginx 1.30.4（官方 alpine 包，已含全部 CVE 修复）
# ============================================================

FROM base AS runtime

# node:20-alpine 基于 alpine 3.23，其仓库最高只有 nginx 1.28.3（漏洞版本）。
# 分两段解决：
#   1) 从 alpine 3.24 仓库安装 nginx 1.30.4-r1（CVE 修复版）
#   2) 用官方 nginx:1.30.4-alpine 的布局对齐配置
RUN set -eux; \
    echo "https://dl-cdn.alpinelinux.org/alpine/v3.24/main/" > /etc/apk/repositories; \
    apk add --no-cache nginx=1.30.4-r1 pcre2; \
    rm -rf /var/cache/apk/*
# 去掉官方包附带的 optional 动态模块（精简体积）
RUN apk del nginx-module-acme nginx-module-geoip nginx-module-image-filter \
           nginx-module-njs nginx-module-xslt 2>/dev/null || true

# ============================================================
# 阶段 2：预装项目 npm 依赖（供无外网环境执行 npm run build）
# ============================================================

WORKDIR /app

# npm 国内镜像源（基础镜像构建环境有外网；应用镜像构建阶段完全离线）
RUN npm config set registry https://registry.npmmirror.com

COPY frontend/package.json frontend/package-lock.json ./

# --omit=dev 会破坏 vite build（vite/terser 是 devDependencies），必须全量安装
RUN npm ci --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf ~/.npm node_modules/.cache \
    && find node_modules -type f \( -name "*.md" -o -name "*.map" \) -delete

# ============================================================
# 阶段 3：非 root 运行配置（对齐官方 nginx 镜像布局）
# ============================================================

# 官方 alpine 的 nginx 包内置 uid=100/101 的 nginx 用户及同组，
# apk add nginx 时自动创建。/var/run 是指向 /run 的符号链接，
# 日志/缓存/pid 目录须对 nginx 用户可写。
# 注意：alpine 的 nginx 默认站点在 /etc/nginx/http.d/（非 conf.d/）
RUN mkdir -p /usr/share/nginx/html /var/log/nginx /var/cache/nginx/client_temp \
             /var/cache/nginx/proxy_temp /var/cache/nginx/fastcgi_temp \
             /var/cache/nginx/uwsgi_temp /var/cache/nginx/scgi_temp /run/nginx \
    && chown -R nginx:nginx /usr/share/nginx/html /var/log/nginx /var/cache/nginx /run/nginx \
    && chmod 700 /var/cache/nginx/* \
    && rm -f /etc/nginx/http.d/default.conf

ENV NGINX_USER=nginx

# 应用镜像会把 frontend/nginx.conf 覆盖为 /etc/nginx/nginx.conf（listen 6173）
EXPOSE 6173

# 直接以非 root 身份运行 nginx（无需 su-exec；master 即非 root）
USER nginx

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:6173/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
