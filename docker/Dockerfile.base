# ============================================================
# AI驱动动态表单 - 后端基础镜像
# 包含所有依赖包，用于加速构建
# ============================================================

# 使用官方 Python 3.11 镜像（带有更新版本的 pip）
FROM python:3.11-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖（如需编译某些包）
RUN apt-get update && apt-get install -y \
    gcc \
    libssl-dev \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# 复制 requirements.txt
COPY backend/requirements.txt .

# 安装所有依赖（Python 3.11 默认 pip 版本较高）
RUN pip install --no-cache-dir -r requirements.txt

# 设置环境变量
ENV PYTHONUNBUFFERED=1

# 镜像标签
LABEL maintainer="prod-platform"
LABEL version="1.0"
LABEL description="AI动态表单后端基础镜像"
