# ============================================================
# AI驱动动态表单 - 后端容器
# 使用 vendor 目录的依赖包和源代码
# ============================================================

FROM 10.86.12.11:20200/aipaas-cloud/python:3.10-slim

WORKDIR /app

# 复制 vendor 目录（预下载的依赖包）
COPY backend/vendor/ ./vendor/

# 安装 vendor 目录中的依赖包
RUN pip install --no-cache-dir --find-links=./vendor/ -r backend/requirements.txt

# 复制源代码
COPY backend/app/ ./app/

# 复制配置文件
COPY config/ ./config/

# 创建必要目录
RUN mkdir -p backend/logs app/logs

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV PORT=6173
ENV DEBUG=False

EXPOSE 6173

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "6173", "--log-level", "info"]
