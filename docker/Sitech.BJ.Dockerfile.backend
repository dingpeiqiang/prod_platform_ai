# ============================================================
# AI驱动动态表单 - 后端容器（使用预构建基础镜像）
# ============================================================

# 使用自定义基础镜像（版本号通过构建参数传递）
ARG BASE_IMAGE_VERSION=1.1
FROM 10.86.12.11:20200/y21127-crmpos/prod-platform-backend-base:${BASE_IMAGE_VERSION}
WORKDIR /app

# 复制源代码
COPY backend/app/ ./app/

# 复制配置文件
COPY config/ ./config/

# 创建必要目录
RUN mkdir -p backend/logs app/logs

# 环境变量
ENV PORT=6173
ENV DEBUG=False

EXPOSE 6173

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "6173", "--log-level", "info"]
