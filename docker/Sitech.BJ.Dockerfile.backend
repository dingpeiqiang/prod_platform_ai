# ============================================================
# AI驱动动态表单 - 后端容器
# 直接使用 pip install 安装依赖
# ============================================================

FROM 10.86.12.11:20200/aipaas-cloud/python:3.10-slim

WORKDIR /app

# 安装系统依赖（gcc用于编译Python扩展）
RUN apt-get update && \
    apt-get install -y gcc python3-dev && \
    rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY backend/requirements.txt .

# 安装所有依赖
RUN pip install \
    --no-cache-dir \
    -r requirements.txt

# 复制后端代码
COPY backend/ ./backend/
COPY config/ ./config/

# 创建必要目录
RUN mkdir -p backend/logs backend/app/logs

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV PORT=6173
ENV DEBUG=False

EXPOSE 6173

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "6173", "--log-level", "info"]
