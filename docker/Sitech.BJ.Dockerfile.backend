# ============================================================
# AI驱动动态表单 - 后端容器
# 使用 wheel 包安装
# ============================================================

FROM 10.86.12.11:20200/aipaas-cloud/python:3.10-slim

WORKDIR /app

# 复制 wheel 包
COPY backend/dist/*.whl ./

# 安装 wheel 包
RUN pip install --no-cache-dir *.whl

# 复制配置文件
COPY config/ ./config/

# 创建必要目录
RUN mkdir -p backend/logs app/logs

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV PORT=6173
ENV DEBUG=False

EXPOSE 6173

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "6173", "--log-level", "info"]
