# ============================================================
# AI驱动动态表单 - 后端应用镜像（Spring Boot / backend-app）
# 依赖已在基础镜像 ~/.m2；本阶段离线打包，不访问外网
# ============================================================

# 注意：修改版本号时，请同步更新 docker-manager.ps1 中的配置
FROM 10.86.12.11:20200/y21127-crmpos/prod-platform-backend-base:2.3

LABEL maintainer="AI Platform"
LABEL version="2.0"
LABEL description="AI Dynamic Form Backend (Spring Boot)"

WORKDIR /build

# 复制后端源码（依赖已在基础镜像本地仓库）
COPY backend-app/ ./

# -o / --offline：禁止访问远程仓库，只用基础镜像已缓存的依赖
RUN mvn -o -B -DskipTests package \
    && mkdir -p /app/logs /app/uploads \
    && cp target/prod-platform-ai-*.jar /app/app.jar

WORKDIR /app

RUN rm -rf /build \
    && mkdir -p /config /app/logs /app/uploads

# 业务配置通过挂载 /config 注入，勿在 docker run 里堆 -e application 项
# 例：-v /path/to/config:/config:ro
ENV SERVER_PORT=6174 \
    JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8" \
    TZ=Asia/Shanghai

EXPOSE 6174

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${SERVER_PORT}/health" || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar --server.port=${SERVER_PORT} --spring.config.additional-location=optional:file:/config/"]
