# ============================================================
# AI驱动动态表单 - 后端容器
# 使用自定义基础镜像（包含所有依赖）
# ============================================================

# 使用自定义基础镜像
FROM prod-platform-backend-base:1.0

WORKDIR /app

# 复制源代码
COPY backend/app/ ./app/

# 复制配置文件
COPY config/ ./config/

# 创建必要目录
RUN mkdir -p backend/logs app/logs

# 环境变量
ENV PORT=6173
ENV DEBUG=False

EXPOSE 6173

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "6173", "--log-level", "info"]
