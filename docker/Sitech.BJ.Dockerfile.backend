# ============================================================
# AI驱动动态表单 - 后端容器
# 直接使用 requirements.txt 安装依赖
# ============================================================

FROM 10.86.12.11:20200/devops/python:3.7.0

WORKDIR /app

# 安装系统依赖（gcc用于编译Python扩展）
RUN pip install --no-cache-dir setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# 复制后端代码
COPY backend/ ./backend/
COPY config/ ./config/

# 创建必要目录
RUN mkdir -p backend/logs backend/app/logs

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV PORT=6173
ENV DEBUG=False

EXPOSE 6173

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "6173", "--log-level", "info"]
