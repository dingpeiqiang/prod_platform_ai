# ============================================================
# AI驱动动态表单 - 后端容器（vendor方案）
# ============================================================

FROM 10.86.12.11:20200/aipaas-cloud/python:3.10-slim

WORKDIR /app

# 复制依赖文件和vendor目录
COPY backend/requirements.txt .
COPY backend/vendor/ ./vendor/

# 设置环境变量禁用 PyYAML C 扩展编译
RUN YAML_FORCE_PURE_PYTHON=1 pip install \
    --no-cache-dir \
    --no-index \
    --find-links=./vendor \
    -r requirements.txt

# 复制后端代码
COPY backend/ ./backend/
COPY config/ ./config/

# 创建必要目录
RUN mkdir -p backend/logs backend/app/logs

# 环境变量
ENV PYTHONUNBUFFERED=1
ENV PORT=6173
ENV DEBUG=False

EXPOSE 6173

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "6173", "--log-level", "info"]
