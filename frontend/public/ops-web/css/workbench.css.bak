q {font-size:11.5px;font-weight:500;color:var(--text-lt);border-left:1px solid var(--line);padding-left:10px;margin-left:2px;}#ops-view-root .ops-mod-score {font-size:17px;font-weight:800;color:var(--blue);}#ops-view-root .ops-mod-score small {font-size:11px;color:var(--text-lt);font-weight:400;}#ops-view-root .ops-3col {display:grid;grid-template-columns:1fr 1.6fr 1fr;gap:16px;align-items:stretch;}@media(max-width:1100px){#ops-view-root .ops-3col {grid-template-columns:1fr 1fr;}#ops-view-root .ops-3col .ops-col:last-child {grid-column:1/-1;}}#ops-view-root .ops-col {min-width:0;}#ops-view-root .ops-bigbox {background:linear-gradient(160deg,#F2F8FF,#EAF3FD);border:1px solid #D6E8F7;border-radius:10px;padding:16px;display:flex;flex-direction:column;justify-content:center;}#ops-view-root .ops-biglabel {font-size:12px;color:var(--text-sub);}#ops-view-root .ops-bigvalue {font-size:32px;font-weight:800;color:#111827;line-height:1.15;margin:6px 0 10px;}#ops-view-root .ops-bigvalue small {font-size:14px;font-weight:600;color:var(--text-sub);}#ops-view-root .ops-bigchips {display:flex;flex-direction:column;gap:6px;}#ops-view-root .ops-chip {display:inline-flex;align-items:center;gap:5px;font-size:11.5px;}#ops-view-root .ops-chip .k {color:var(--text-lt);}#ops-view-root .ops-chip .v {font-weight:700;color:var(--green);}#ops-view-root .ops-chip .v.down {color:var(--red);}#ops-view-root .ops-stat {display:flex;justify-content:space-between;align-items:center;font-size:12px;padding:8px 0;border-bottom:1px dashed #EDF0F4;}#ops-view-root .ops-stat:last-child {border-bottom:none;}#ops-view-root .ops-stat span {color:var(--text-sub);}#ops-view-root .ops-stat b {font-weight:700;}#ops-view-root .ops-chartbox {width:100%;height:150px;}#ops-view-root .ops-legend {font-size:11px;color:var(--text-lt);display:flex;justify-content:center;gap:14px;margin-top:4px;}#ops-view-root .ops-legend span {display:inline-flex;align-items:center;gap:4px;}#ops-view-root .ops-dot {width:8px;height:8px;bo