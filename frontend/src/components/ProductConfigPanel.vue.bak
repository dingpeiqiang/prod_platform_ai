  font-weight: 600;
  color: #fff;
  margin-bottom: 6px;
}
.app-banner-fee {
  display: flex;
  align-items: baseline;
  gap: 2px;
  margin-bottom: 10px;
}
.fee-num {
  font-size: 32px;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}
.fee-unit {
  font-size: 12px;
  color: rgba(255,255,255,0.8);
}
.app-banner-tags {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}
.app-tag {
  font-size: 10px;
  padding: 3px 8px;
  border-radius: 10px;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-weight: 500;
  backdrop-filter: blur(4px);
}

/* 通用卡片 */
.app-card {
  background: #fff;
  border-radius: 12px;
  padding: 12px 14px;
}
.app-card-title {
  font-size: 13px;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 10px;
  display: flex;
  align-items: center;
  gap: 4px;
}
.app-card-title::before {
  content: '';
  width: 3px;
  height: 12px;
  background: #3b82f6;
  border-radius: 2px;
}

/* 資源網格 */
.app-resource-grid {
  display: flex;
  justify-content: space-around;
}
.app-resource-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.app-resource-icon {
  width: 38px;
  height: 38px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}
.app-resource-icon.flow { background: linear-gradient(135deg, #06a0ff, #3b82f6); }
.app-resource-icon.voice { background: linear-gradient(135deg, #10b981, #059669); }
.app-resource-icon.video { background: linear-gradient(135deg, #f59e0b, #ef4444); }
.app-resource-num {
  font-size: 16px;
  font-weight: 700;
  color: #1e293b;
}
.app-resource-num .unit {
  font-size: 10px;
  font-weight: 400;
  color: #64748b;
  margin-left: 2px;
}
.app-resource-label {
  font-size: 10px;
  color: #64748b;
}

/* 權益列表 */
.app-equity-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.app-equity-item {
  display: flex;
  align-items: center;
  gap: 10px;
}
.app-equity-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  flex-shrink: 0;
}
.app-equity-info {
  flex: 1;
  min-width: 0;
}
.app-equity-name {
  font-size: 12px;
  font-weight: 600;
  color: #1e293b;
}
.app-equity-desc {
  font-size: 10px;
  color: #94a3b8;
}

/* 費用列表 */
.app-fee-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.app-fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: #64748b;
  padding: 4px 0;
  border-bottom: 1px solid #f1f5f9;
}
.app-fee-row:last-child {
  border-bottom: none;
}
.app-fee-row.highlight {
  background: #eff6ff;
  margin: 0 -8px;
  padding: 6px 8px;
  border-radius: 6px;
  border-bottom: none;
}
.app-fee-row.highlight span {
  color: #2563eb;
  font-weight: 600;
}
.app-fee-val {
  font-weight: 500;
  color: #1e293b;
}

/* 規則列表 */
.app-rule-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.app-rule-item {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  font-size: 11px;
  color: #64748b;
  line-height: 1.5;
}
.app-rule-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #3b82f6;
  margin-top: 6px;
  flex-shrink: 0;
}

/* 操作按鈕�?*/
.app-action-bar {
  display: flex;
  gap: 8px;
  margin-top: 6px;
}
.app-btn-primary {
  flex: 1;
  height: 38px;
  border: none;
  border-radius: 19px;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
  transition: transform 0.1s;
}
.app-btn-primary:active {
  transform: scale(0.97);
}
.app-btn-primary.full {
  width: 100%;
}
.app-btn-secondary {
  flex: 1;
  height: 38px;
  border: 1.5px solid #e2e8f0;
  border-radius: 19px;
  background: #fff;
  color: #475569;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: transform 0.1s;
}
.app-btn-secondary:active {
  transform: scale(0.97);
}

/* 免填單列�?*/
.app-formfill-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.app-formfill-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 0;
  border-bottom: 1px solid #f1f5f9;
  font-size: 12px;
}
.app-formfill-row:last-child {
  border-bottom: none;
}
.app-formfill-label {
  color: #64748b;
  flex-shrink: 0;
}
.app-formfill-value {
  color: #1e293b;
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}
.app-formfill-value.highlight {
  color: #2563eb;
  font-weight: 600;
}

/* 優惠信息 */
.app-discount-box {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-radius: 8px;
}
.app-discount-tag {
  font-size: 11px;
  font-weight: 700;
  color: #fff;
  background: #f59e0b;
  padding: 3px 8px;
  border-radius: 4px;
  flex-shrink: 0;
}
.app-discount-title {
  font-size: 12px;
  font-weight: 600;
  color: #92400e;
}
.app-discount-desc {
  font-size: 10px;
  color: #b45309;
}

/* 短信對話 */
.app-sms-chat {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 4px 0;
}
.app-sms-time {
  text-align: center;
  font-size: 10px;
  color: #94a3b8;
  margin-bottom: 2px;
}
.app-sms-msg {
  display: flex;
  gap: 8px;
}
.app-sms-avatar {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: linear-gradient(135deg, #2563eb, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
}
.app-sms-bubble-wrap {
  flex: 1;
  min-width: 0;
}
.app-sms-label {
  font-size: 10px;
  color: #94a3b8;
  margin-bottom: 3px;
}
.app-sms-bubble {
  background: #fff;
  border-radius: 2px 12px 12px 12px;
  padding: 10px 12px;
  font-size: 12px;
  color: #1e293b;
  line-height: 1.6;
  word-break: break-all;
}

/* 底部Tab導航 */
.phone-tabbar {
  height: 56px;
  background: #fff;
  border-top: 1px solid #e2e8f0;
  display: flex;
  flex-shrink: 0;
}
.phone-tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  color: #94a3b8;
  cursor: pointer;
  transition: color 0.15s;
}
.phone-tab-item span {
  font-size: 10px;
  font-weight: 500;
}
.phone-tab-item.active {
  color: #2563eb;
}

/* Home�?*/
.phone-home-indicator {
  height: 5px;
  width: 100px;
  background: #1e293b;
  border-radius: 3px;
  margin: 0 auto 6px;
  flex-shrink: 0;
}

/* 底部操作�?*/
.config-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
  padding: 12px 16px;
  border-top: 1px solid #e5e7eb;
  background: #fff;
  flex-shrink: 0;
}
.batch-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  width: 100%;
  padding: 6px 0 2px;
  margin-bottom: 2px;
  border-bottom: 1px dashed #fde68a;
}
.batch-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 5px 12px;
  border: 1px solid #fcd34d;
  border-radius: 8px;
  background: #fffbeb;
  color: #b45309;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}
.batch-nav-btn:hover:not(:disabled) {
  background: #fef3c7;
  border-color: #f59e0b;
}
.batch-nav-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}
.batch-nav-count {
  font-size: 12px;
  font-weight: 600;
  color: #92400e;
  white-space: nowrap;
}
.footer-left {
  display: flex;
  gap: 8px;
}
.footer-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 7px 14px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #fff;
  color: #475569;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
}
.footer-btn:hover {
  border-color: #93c5fd;
  color: #2563eb;
  background: #f0f9ff;
}
.btn-smart {
  border-color: #a5b4fc;
  color: #4f46e5;
  background: #eef2ff;
}
.btn-smart:hover {
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  border-color: #6366f1;
  color: #fff;
}
.btn-submit {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 7px 18px;
  border: none;
  border-radius: 8px;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
  box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
}
.btn-submit:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
}
.footer-submitted {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 10px 14px;
  border-radius: 8px;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  color: #15803d;
  font-size: 12px;
  transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease;
}
.footer-submitted.submitted {
  background: #eff6ff;
  border-color: #bfdbfe;
  color: #1d4ed8;
}
.footer-submitted.submitted .footer-submitted-id {
  color: #2563eb;
}
.footer-submitted.testing {
  background: #eff6ff;
  border-color: #bfdbfe;
  color: #1d4ed8;
}
.footer-submitted.testing .footer-submitted-id {
  color: #2563eb;
}
.footer-submitted.tested {
  background: #eff6ff;
  border-color: #c7d7fe;
  color: #1d4ed8;
}
.footer-submitted.tested .footer-submitted-id {
  color: #2563eb;
}
.footer-submitted-text {
  font-weight: 600;
}
.footer-submitted-id {
  color: #16a34a;
  margin-left: auto;
}
.form-input:disabled,
.form-select:disabled,
.form-textarea:disabled,
.table-cell-input:disabled,
.checkbox-item input:disabled {
  background: #f8fafc;
  color: #94a3b8;
  cursor: not-allowed;
}
.table-add-btn:disabled,
.table-del-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

/* 智能稽核彈窗 */
.audit-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.audit-modal {
  width: 420px;
  max-height: 80vh;
  background: #fff;
  border-radius: 12px;
  box-shadow: 0 20px 60px rgba(15, 23, 42, 0.2);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.audit-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-bottom: 1px solid #e5e7eb;
}
.audit-modal-title {
  font-size: 14px;
  font-weight: 600;
  color: #1e293b;
}
.audit-close {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 6px;
  background: transparent;
  color: #64748b;
  cursor: pointer;
}
.audit-close:hover {
  background: #f1f5f9;
}
.audit-modal-body {
  padding: 20px;
  overflow-y: auto;
}
.audit-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  padding: 20px 0;
}
.audit-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid #e2e8f0;
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.audit-loading p {
  font-size: 13px;
  color: #64748b;
}
.audit-results {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.audit-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 8px;
}
.audit-item.success {
  background: #f0fdf4;
}
.audit-item.error {
  background: #fef2f2;
}
.audit-icon {
  flex-shrink: 0;
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.audit-item.success .audit-icon {
  color: #16a34a;
}
.audit-item.error .audit-icon {
  color: #ef4444;
}
.audit-text {
  flex: 1;
}
.audit-item-title {
  font-size: 13px;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 2px;
}
.audit-item-desc {
  font-size: 12px;
  color: #64748b;
}

/* 彈窗動畫 */
.audit-fade-enter-active,
.audit-fade-leave-active {
  transition: opacity 0.2s ease;
}
.audit-fade-enter-from,
.audit-fade-leave-to {
  opacity: 0;
}

/* ========== 測試報告 Tab ========== */
.test-report-tab {
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* 等待測試人員上傳 */
.tr-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 48px 20px;
  text-align: center;
  border: 1px dashed #c7d7fe;
  border-radius: 14px;
  background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
}
.tr-loading-spinner {
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: #eff6ff;
  border: 1px solid #dbeafe;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #2563eb;
  animation: tr-breathe 1.8s ease-in-out infinite;
}
@keyframes tr-breathe {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.08); opacity: 0.75; }
}
.tr-loading-title {
  font-size: 15px;
  font-weight: 700;
  color: #1e3a8a;
}
.tr-loading-desc {
  font-size: 13px;
  color: #475569;
  line-height: 1.6;
  margin: 0;
  max-width: 380px;
}
.tr-loading-tip {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  font-size: 11px;
  color: #64748b;
  line-height: 1.5;
  text-align: left;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 8px 10px;
  max-width: 380px;
}
.tr-loading-tip svg {
  flex-shrink: 0;
  color: #3b82f6;
  margin-top: 1px;
}

/* 報告概覽 */
.tr-overview {
  background: linear-gradient(135deg, #f0f9ff 0%, #eff6ff 100%);
  border: 1px solid #dbeafe;
  border-radius: 12px;
  padding: 14px;
}
.tr-overview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.tr-overview-title {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 700;
  color: #1e40af;
}
.tr-overview-title svg {
  color: #3b82f6;
}
.tr-status-badge {
  font-size: 12px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 999px;
}
.tr-status-badge.badge-pass {
  background: #d1fae5;
  color: #065f46;
}
.tr-status-badge.badge-fail {
  background: #fee2e2;
  color: #991b1b;
}
.tr-overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px 12px;
}
.tr-overview-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.tr-label {
  font-size: 11px;
  color: #64748b;
  font-weight: 600;
}
.tr-value {
  font-size: 12px;
  color: #0f172a;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tr-value.tr-number {
  font-family: 'SF Mono', 'Consolas', monospace;
  letter-spacing: 0.5px;
  color: #2563eb;
}

/* 核查明細 */
.tr-section {
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  overflow: hidden;
}
.tr-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}
.tr-section-title {
  font-size: 13px;
  font-weight: 700;
  color: #334155;
}
.tr-section-status {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 999px;
}
.tr-section-status.status-pass {
  background: #d1fae5;
  color: #065f46;
}
.tr-section-status.status-fail {
  background: #fee2e2;
  color: #991b1b;
}
.tr-section-body {
  display: flex;
  flex-direction: column;
}
.tr-check-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  border-bottom: 1px solid #f1f5f9;
}
.tr-check-item:last-child {
  border-bottom: none;
}
.tr-check-label {
  font-size: 12px;
  font-weight: 600;
  color: #475569;
  flex-shrink: 0;
  width: 90px;
  line-height: 1.5;
  padding-top: 1px;
}
.tr-check-detail {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.tr-check-row {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  font-size: 11px;
  line-height: 1.5;
}
.tr-check-key {
  color: #94a3b8;
  font-weight: 600;
  flex-shrink: 0;
}
.tr-check-val {
  color: #334155;
  word-break: break-all;
}
.tr-check-result {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  margin-top: 1px;
}
.tr-check-result.result-pass {
  background: #d1fae5;
  color: #10b981;
}
.tr-check-result.result-fail {
  background: #fee2e2;
  color: #ef4444;
}

/* 驗收結論 */
.tr-conclusion {
  border-radius: 12px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.tr-conclusion.conclusion-pass {
  background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%);
  border: 1px solid #bbf7d0;
}
.tr-conclusion.conclusion-fail {
  background: linear-gradient(135deg, #fef2f2 0%, #fff1f2 100%);
  border: 1px solid #fecaca;
}
.tr-conclusion-header {
  display: flex;
  align-items: center;
  gap: 8px;
