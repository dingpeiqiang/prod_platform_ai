# ============================================================
# Prod Platform AI - 后端环境变量模板（tar 包内 conf/）
# 安装目标: /etc/prod-ai/backend.env   （权限 600，root 属主）
# 生产必须填入真实值，禁止明文提交仓库
# ============================================================

# ---- 数据库（MySQL）----
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/prodplatformai?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
SPRING_DATASOURCE_USERNAME=prodplatformai
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# ---- 认证（JWT，多实例需一致）----
AUTH_JWT_SECRET=CHANGE_ME_32_BYTES_RANDOM

# ---- LLM 总开关 ----
LLM_ENABLED=true

# ---- 可选：JVM 内存 / 端口覆盖 ----
# JAVA_OPTS=-Xms1g -Xmx3g -Dfile.encoding=UTF-8
# SERVER_PORT=6174

# ---- 可选：本体 ABOX/指标 JDBC 直连（按环境启用）----
# ABOX_SOURCE=jdbc
# ABOX_JDBC_URL=jdbc:mysql://<host>:3306/<biz_db>
# ABOX_JDBC_USERNAME=readonly
# ABOX_JDBC_PASSWORD=xxxx
