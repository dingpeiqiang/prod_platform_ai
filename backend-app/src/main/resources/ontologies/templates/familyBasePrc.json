    { "set_default": { "channelScope": "全渠道" }, "if_missing": true },
    { "set_default": { "categoryCode": "familyBasePrc" }, "if_missing": true },
    { "set_default": { "messageRootKey": "familyBasePrc" }, "if_missing": true },
    { "when": { "ifFloorsPrc": "是" }, "visible": ["fav1Method", "fav1Fee", "fav1ItemType", "fav1Group", "fav1Validity"] },
    { "when": { "ifFloorsPrc": "否" }, "hidden": ["fav1Method", "fav1Fee", "fav1ItemType", "fav1Group", "fav1Validity", "fav1ValidityVAlue"] },
    { "when": { "fav1Validity": "长期有效" }, "hidden": ["fav1ValidityVAlue"] },
    { "derive": { "roleMax": "phoneMbrMax + kdMbrMax" }, "note": "数值派生归 SHACL/Java（不在模板引擎硬解）" }
