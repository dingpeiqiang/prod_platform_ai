{
  "template_id": "deviceMainPrc",
  "template_name": "终端销售",
  "version": "1.0.0",
  "extends": "commonBasePrc",
  "status": "published",
  "category_code": "deviceMainPrc",
  "message_root_key": "deviceMainPrc",
  "category_meta": {
    "product_line": "终端",
    "is_main_offer": true,
    "required_elements": [
      "SalesPolicy",
      "ReleaseScope",
      "ChargePlan",
      "AccountPreferential",
      "PrintNotice",
      "SmsNotice"
    ]
  },
  "matchers": {
    "keywords": [
      "终端销售",
      "终端",
      "手机",
      "宽带电视",
      "IPTV",
      "机顶盒",
      "智能硬件",
      "合约机"
    ],
    "priority": 10
  },
  "sections": [
    {
      "code": "deviceInfo",
      "label": "终端信息",
      "message_path": "baseInfo"
    }
  ],
  "fields": [
    {
      "field_code": "deviceModel",
      "label": "终端型号",
      "type": "input",
      "required": true,
      "section": "deviceInfo",
      "field_class": "draft",
      "source": "fs",
      "slot_aliases": [
        "型号",
        "机型",
        "终端型号"
      ],
      "extract_hint": "如 A1/B2/IPTV-BOX",
      "message_path": "baseInfo.deviceModel",
      "business_key": "deviceModel"
    },
    {
      "field_code": "devicePrice",
      "label": "终端价格（元）",
      "type": "number",
      "required": false,
      "section": "deviceInfo",
      "field_class": "projection",
      "source": "fs",
      "unit": "元",
      "precision": 8,
      "decimal_places": 2,
      "message_path": "baseInfo.devicePrice",
      "business_key": "devicePrice"
    },
    {
      "field_code": "isContractPhone",
      "label": "是否合约机",
      "type": "select",
      "required": false,
      "section": "deviceInfo",
      "field_class": "projection",
      "source": "dict",
      "default_value": "非合约机",
      "enum_config": {
        "type": "static",
        "enum_map": [
          {
            "display": "合约机",
            "value": "1"
          },
          {
            "display": "非合约机",
            "value": "0"
          }
        ]
      },
      "message_path": "baseInfo.isContractPhone",
      "business_key": "isContractPhone"
    }
  ],
  "derive_rules": [
    {
      "set_default": {
        "channelScope": "全渠道"
      },
      "if_missing": true
    },
    {
      "set_default": {
        "categoryCode": "deviceMainPrc"
      },
      "if_missing": true
    },
    {
      "set_default": {
        "messageRootKey": "deviceMainPrc"
      },
      "if_missing": true
    }
  ],
  "compliance_bindings": {
    "rule_ids": [
      "R-C03",
      "R-C04",
      "R-C05",
      "R-C06",
      "R-C07",
      "R-C08",
      "R-C09"
    ]
  },
  "message_projection": {
    "mode": "observe",
    "root_key": "deviceMainPrc",
    "aligned_with": "ontology/config_message_projection.json#categoryMappings.deviceMainPrc",
    "defaults": {
      "orderEffectMode": "1001",
      "cancelEffectMode": "1023",
      "saleEndDate": "20991231",
      "taxSplitFlag": "0",
      "smsOpTypes": "0"
    }
  }
}
