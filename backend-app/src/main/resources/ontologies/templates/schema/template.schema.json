{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "template.schema.json",
  "title": "产品配置模板 Schema（R4 单源契约）",
  "description": "ontologies/templates/*.json 的结构契约。JSON 模板为单一事实源（SSOT）：xlsx 经 scripts/import_template_from_xlsx.py 导入，TTL/投影/compliance-shacl 由 TemplateTtlGenerator / ProjectionConfigGenerator / TemplateConstraintCompiler 从本源生成。CI 门禁：TemplateSingleSourceConsistencyTest。",
  "type": "object",
  "required": [
    "template_id",
    "template_name",
    "version",
    "category_code",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "template_id": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$",
      "maxLength": 64
    },
    "template_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "extends": {
      "type": [
        "string",
        "null"
      ],
      "description": "父模板 template_id；子按 field_code 覆盖合并（ProductTemplateRegistry）。"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "deprecated"
      ]
    },
    "category_code": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*$"
    },
    "message_root_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "category_meta": {
      "type": "object",
      "description": "品类元数据（R4 起模板单源，投影 categories 与 TTL 品类个体由此生成）；common 基类模板无需声明。",
      "required": [
        "product_line",
        "is_main_offer",
        "required_elements"
      ],
      "additionalProperties": false,
      "properties": {
        "product_line": {
          "type": "string",
          "enum": [
            "个人",
            "宽带",
            "家庭"
          ]
        },
        "is_main_offer": {
          "type": "boolean"
        },
        "required_elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][a-zA-Z]*$"
          }
        }
      }
    },
    "matchers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "priority": {
          "type": "integer"
        },
        "abstract": {
          "type": "boolean"
        }
      }
    },
    "extraction": {
      "type": "object",
      "description": "抽取策略声明（模板驱动，P2-2 扩展）：required_slots 为该品类最小可用要素（field_code 数组），智聊参数抽取环节缺要素判定（missing_slots）依据；未声明回落调用方缺省口径。",
      "additionalProperties": false,
      "properties": {
        "required_slots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "label",
          "message_path"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "message_path": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9.]*$"
          },
          "component": {
            "type": "boolean",
            "description": "子对象/列表容器 section（TemplateConstraintCompiler.section_component）"
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/field"
      }
    },
    "derive_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "set_default": {
            "type": "object",
            "description": "field_code → 默认值（display 契约）；配 if_missing 仅在缺省时回填。",
            "minProperties": 1
          },
          "if_missing": {
            "type": "boolean"
          },
          "when": {
            "type": "object",
            "description": "条件：field_code(display 值) → 期望值；visible/hidden 目标为字段数组。",
            "minProperties": 1
          },
          "visible": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hidden": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "compliance_bindings": {
      "type": "object",
      "required": [
        "rule_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^R-(C|D|CONF)\\d{2,3}$"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "message_projection": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "observe",
            "source"
          ],
          "description": "observe=仅对齐观察；source=模板即投影单源（R4 起品类模板取 source，映射经 business_key 声明）。"
        },
        "root_key": {
          "type": "string"
        },
        "aligned_with": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "defaults": {
          "type": "object",
          "description": "品类报文投影默认值（业务键→默认值；生成 config_message_projection.json#defaultsByCategory）。语义与 ConfigMessageProjector.applyCategoryDefaults 对齐：仅当草稿缺省时回填。",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "field": {
      "type": "object",
      "required": [
        "field_code",
        "label",
        "type",
        "required",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "field_code": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "type": {
          "type": "string",
          "enum": [
            "input",
            "select",
            "multiselect",
            "number",
            "date",
            "textarea"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "section": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        },
        "field_class": {
          "type": "string",
          "enum": [
            "draft",
            "projection",
            "readonly"
          ],
          "description": "draft=用户填写；projection=系统投影；readonly=查询返回（不出表单）。"
        },
        "source": {
          "type": "string",
          "enum": [
            "fs",
            "dict",
            "generated",
            "hidden",
            "remote"
          ],
          "description": "hidden 元素不出现在渲染表单（buildFormSchema 契约）。"
        },
        "business_key": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "description": "R4 单源：业务草稿键（报文投影 mapping.business）；与 field_code 同名时仍显式声明，缺失则该字段不参与投影映射生成。"
        },
        "draft_aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*$"
          },
          "description": "业务草稿兼容别名（投影 mapping.aliases 单源）。"
        },
        "slot_aliases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "自然语言抽取别名（意图层槽位对齐，非草稿键）。"
        },
        "extract_hint": {
          "type": "string",
          "maxLength": 200
        },
        "rule_description": {
          "type": "string",
          "maxLength": 300
        },
        "default_value": {},
        "enum_config": {
          "$ref": "#/definitions/enumConfig"
        },
        "precision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "decimal_places": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "unit": {
          "type": "string",
          "maxLength": 12
        },
        "pattern": {
          "type": "string"
        },
        "min_value": {
          "type": "number"
        },
        "max_value": {
          "type": "number"
        },
        "visible_when": {
          "type": "object",
          "description": "单条件显隐：field_code → 期望 display 值。",
          "minProperties": 1
        },
        "mutex_value_groups": {
          "type": "array",
          "minItems": 2,
          "description": "值域内互斥组（如 chnClassLimit 营业前台 vs 电子渠道/大掌柜）。",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "message_path": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]+(\\.[a-zA-Z0-9]+)*$",
          "description": "报文投影路径（如 baseInfo.prodPrcName）；段由外部报文契约决定，允许数字开头（如 baseInfo.5GUser）。"
        }
      }
    },
    "enumConfig": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "static",
            "remote"
          ]
        },
        "enum_map": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "display"
            ],
            "additionalProperties": false,
            "properties": {
              "display": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              }
            }
          }
        },
        "dict_code": {
          "type": "string",
          "pattern": "^[A-Z_]+$"
        }
      }
    }
  }
}
