{
  "template_id": "familyAddPrc",
  "template_name": "家庭附加业务",
  "version": "1.0.0",
  "extends": "commonBasePrc",
  "status": "published",
  "category_code": "familyAddPrc",
  "message_root_key": "familyAddPrc",
  "matchers": {
    "keywords": ["家庭附加", "附加业务", "权益包", "电视权益", "宽带权益", "家庭加装"],
    "priority": 30
  },
  "sections": [
    { "code": "addInfo", "label": "附加业务信息", "message_path": "baseInfo" },
    { "code": "equityContent", "label": "权益内容", "message_path": "optionalInfo.equityContent", "component": true },
    { "code": "billGprsCfg", "label": "流量资源配置", "message_path": "optionalInfo.billGprsCfg", "component": true },
    { "code": "billVoiceCfg", "label": "语音资源配置", "message_path": "optionalInfo.billVoiceCfg", "component": true }
  ],
  "fields": [
    {
      "field_code": "prodType",
      "label": "附加业务类型",
      "type": "select",
      "required": true,
      "section": "addInfo",
      "field_class": "draft",
      "source": "dict",
      "enum_config": {
        "type": "static",
        "enum_map": [
          { "display": "电视权益", "value": "1" },
          { "display": "宽带权益", "value": "2" },
          { "display": "通话权益", "value": "3" }
        ]
      },
      "slot_aliases": ["附加类型", "权益类型", "电视包", "宽带包"],
      "message_path": "baseInfo.prodType"
    },
    {
      "field_code": "prcEffCycle",
      "label": "资费有效期类型",
      "type": "select",
      "required": true,
      "section": "addInfo",
      "field_class": "projection",
      "source": "dict",
      "default_value": "长期有效",
      "enum_config": {
        "type": "static",
        "enum_map": [
          { "display": "长期有效", "value": "1" },
          { "display": "有限期", "value": "2" }
        ]
      },
      "message_path": "baseInfo.prcEffCycle"
    },
    {
      "field_code": "prcEffType",
      "label": "有效期单位类型",
      "type": "select",
      "required": false,
      "section": "addInfo",
      "field_class": "projection",
      "source": "dict",
      "visible_when": { "prcEffCycle": "有限期" },
      "message_path": "baseInfo.prcEffType"
    },
    {
      "field_code": "prcEffNum",
      "label": "有效期数值",
      "type": "number",
      "required": false,
      "section": "addInfo",
      "field_class": "projection",
      "source": "fs",
      "precision": 3,
      "visible_when": { "prcEffCycle": "有限期" },
      "message_path": "baseInfo.prcEffNum"
    },
    {
      "field_code": "prcEffDate",
      "label": "有效期截止日期",
      "type": "date",
      "required": false,
      "section": "addInfo",
      "field_class": "projection",
      "source": "fs",
      "visible_when": { "prcEffCycle": "有限期" },
      "message_path": "baseInfo.prcEffDate"
    },
    {
      "field_code": "effNum",
      "label": "生效延迟数量",
      "type": "number",
      "required": false,
      "section": "addInfo",
      "field_class": "projection",
      "source": "fs",
      "precision": 2,
      "message_path": "baseInfo.effNum"
    },
    {
      "field_code": "reFeeFlag",
      "label": "续费标识",
      "type": "select",
      "required": false,
      "section": "addInfo",
      "field_class": "projection",
      "source": "dict",
      "default_value": "否",
      "message_path": "baseInfo.reFeeFlag"
    },
    {
      "field_code": "canBaseFamilyPrc",
      "label": "可绑定家庭基础套餐",
      "type": "select",
      "required": false,
      "section": "addInfo",
      "field_class": "projection",
      "source": "dict",
      "default_value": "是",
      "message_path": "baseInfo.canBaseFamilyPrc"
    },
    {
      "field_code": "familyUpIfEnd",
      "label": "家庭升档是否终止",
      "type": "select",
      "required": false,
      "section": "addInfo",
      "field_class": "projection",
      "source": "dict",
      "default_value": "否",
      "message_path": "baseInfo.familyUpIfEnd"
    },
    {
      "field_code": "chgYueIfCanDown",
      "label": "月费变更可否下调",
      "type": "select",
      "required": false,
      "section": "addInfo",
      "field_class": "projection",
      "source": "dict",
      "default_value": "否",
      "message_path": "baseInfo.chgYueIfCanDown"
    },
    {
      "field_code": "chgYue",
      "label": "月费变更值（元）",
      "type": "number",
      "required": false,
      "section": "addInfo",
      "field_class": "projection",
      "source": "fs",
      "unit": "元",
      "precision": 2,
      "decimal_places": 2,
      "message_path": "baseInfo.chgYue"
    },
    {
      "field_code": "fixCircle",
      "label": "多月收取期数",
      "type": "number",
      "required": false,
      "section": "acctMonth",
      "field_class": "projection",
      "source": "fs",
      "precision": 2,
      "visible_when": { "calcMode": "多月收取" },
      "rule_description": "家庭附加 acctMonth 特有 fixCircle",
      "message_path": "optionalInfo.acctMonth.fixCircle"
    },
    {
      "field_code": "kdEquity",
      "label": "宽带权益内容",
      "type": "input",
      "required": false,
      "section": "equityContent",
      "field_class": "draft",
      "source": "fs",
      "slot_aliases": ["宽带权益", "宽带加速"],
      "message_path": "optionalInfo.equityContent.kdEquity"
    },
    {
      "field_code": "tvEquity",
      "label": "电视权益内容",
      "type": "input",
      "required": false,
      "section": "equityContent",
      "field_class": "draft",
      "source": "fs",
      "slot_aliases": ["电视权益", "高清电视", "魔百和"],
      "message_path": "optionalInfo.equityContent.tvEquity"
    },
    {
      "field_code": "gprsResourceType",
      "label": "流量资源类型",
      "type": "select",
      "required": false,
      "section": "billGprsCfg",
      "field_class": "projection",
      "source": "dict",
      "message_path": "optionalInfo.billGprsCfg.resourceType"
    },
    {
      "field_code": "gprsThreshold",
      "label": "流量额度",
      "type": "number",
      "required": false,
      "section": "billGprsCfg",
      "field_class": "draft",
      "source": "fs",
      "unit": "GB",
      "slot_aliases": ["多少流量", "包含流量", "几个G"],
      "message_path": "optionalInfo.billGprsCfg.theshold"
    },
    {
      "field_code": "gprsUnit",
      "label": "流量单位",
      "type": "select",
      "required": false,
      "section": "billGprsCfg",
      "field_class": "projection",
      "source": "dict",
      "default_value": "GB",
      "message_path": "optionalInfo.billGprsCfg.unit"
    },
    {
      "field_code": "gprsAdjust",
      "label": "流量计费调整",
      "type": "select",
      "required": false,
      "section": "billGprsCfg",
      "field_class": "projection",
      "source": "dict",
      "message_path": "optionalInfo.billGprsCfg.adjust"
    },
    {
      "field_code": "gprsRemindFlag",
      "label": "流量提醒开关",
      "type": "select",
      "required": false,
      "section": "billGprsCfg",
      "field_class": "projection",
      "source": "dict",
      "default_value": "是",
      "message_path": "optionalInfo.billGprsCfg.remindFlag"
    },
    {
      "field_code": "voiceResourceType",
      "label": "语音资源类型",
      "type": "select",
      "required": false,
      "section": "billVoiceCfg",
      "field_class": "projection",
      "source": "dict",
      "message_path": "optionalInfo.billVoiceCfg.resourceType"
    },
    {
      "field_code": "voiceThreshold",
      "label": "语音时长（分钟）",
      "type": "number",
      "required": false,
      "section": "billVoiceCfg",
      "field_class": "draft",
      "source": "fs",
      "unit": "分钟",
      "slot_aliases": ["多少分钟", "包含通话", "通话时长"],
      "message_path": "optionalInfo.billVoiceCfg.theshold"
    },
    {
      "field_code": "voiceAdjust",
      "label": "语音计费调整",
      "type": "select",
      "required": false,
      "section": "billVoiceCfg",
      "field_class": "projection",
      "source": "dict",
      "message_path": "optionalInfo.billVoiceCfg.adjust"
    },
    {
      "field_code": "voiceOutCharge",
      "label": "语音套外计费",
      "type": "input",
      "required": false,
      "section": "billVoiceCfg",
      "field_class": "projection",
      "source": "fs",
      "message_path": "optionalInfo.billVoiceCfg.outCharge"
    },
    {
      "field_code": "voiceRemindFlag",
      "label": "语音提醒开关",
      "type": "select",
      "required": false,
      "section": "billVoiceCfg",
      "field_class": "projection",
      "source": "dict",
      "default_value": "是",
      "message_path": "optionalInfo.billVoiceCfg.remindFlag"
    }
  ],
  "derive_rules": [
    { "set_default": { "channelScope": "全渠道" }, "if_missing": true },
    { "set_default": { "categoryCode": "familyAddPrc" }, "if_missing": true },
    { "set_default": { "messageRootKey": "familyAddPrc" }, "if_missing": true },
    { "when": { "prcEffCycle": "长期有效" }, "hidden": ["prcEffType", "prcEffNum", "prcEffDate"] },
    { "when": { "prcEffCycle": "有限期" }, "visible": ["prcEffType", "prcEffNum", "prcEffDate"] },
    { "when": { "calcMode": "多月收取" }, "visible": ["fixCircle"] }
  ],
  "compliance_bindings": {
    "rule_ids": ["R-C01", "R-C03", "R-C04", "R-C05", "R-C06", "R-C07", "R-C08", "R-C09"]
  },
  "message_projection": {
    "mode": "observe",
    "root_key": "familyAddPrc",
    "aligned_with": "ontology/config_message_projection.json#categoryMappings.familyAddPrc"
  }
}
