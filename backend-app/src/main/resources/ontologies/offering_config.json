{
  "formCode": "offering_config",
  "formName": "产商品配置方案",
  "description": "产商品配置本体 v2.2：业务四层建模，报文为投影；覆盖智聊/智读/智查与合规校验",
  "category": "product",
  "entities": [
    {
      "entityCode": "offering_config",
      "entityName": "配置方案草稿",
      "fields": [
        {
          "fieldCode": "offerName",
          "fieldName": "资费名称",
          "fieldType": "input",
          "required": true,
          "ruleDescription": "对应报文 prodPrcName，如：家庭融合畅享158"
        },
        {
          "fieldCode": "offeringName",
          "fieldName": "资费名称(兼容)",
          "fieldType": "input",
          "required": false,
          "ruleDescription": "兼容旧字段，与 offerName 同步"
        },
        {
          "fieldCode": "categoryCode",
          "fieldName": "产品品类",
          "fieldType": "select",
          "required": true,
          "enumConfig": {
            "type": "static",
            "options": [
              { "value": "personMainPrc", "label": "个人主资费" },
              { "value": "broadBandMainPrc", "label": "宽带主资费" },
              { "value": "personAddPrc", "label": "个人附加资费" },
              { "value": "broadBandOptSpeedPrc", "label": "宽带加速包" },
              { "value": "familyBasePrc", "label": "家庭基础套餐" },
              { "value": "familyAddPrc", "label": "家庭附加业务" }
            ]
          },
          "defaultValue": "personMainPrc",
          "ruleDescription": "决定 messageRootKey 与必备要素组合"
        },
        {
          "fieldCode": "messageRootKey",
          "fieldName": "报文根键",
          "fieldType": "input",
          "required": true,
          "ruleDescription": "与品类一致：personMainPrc / familyBasePrc 等"
        },
        {
          "fieldCode": "bizScenario",
          "fieldName": "业务场景",
          "fieldType": "select",
          "required": false,
          "enumConfig": {
            "type": "static",
            "options": [
              { "value": "大众-个人主资费", "label": "大众-个人主资费" },
              { "value": "5G个人主套餐", "label": "5G个人主套餐" },
              { "value": "校园-个人附加", "label": "校园-个人附加" },
              { "value": "校园体验", "label": "校园体验" },
              { "value": "家庭-基础套餐", "label": "家庭-基础套餐" },
              { "value": "家庭融合", "label": "家庭融合" },
              { "value": "家庭-宽带主资费", "label": "家庭-宽带主资费" }
            ]
          }
        },
        {
          "fieldCode": "targetUser",
          "fieldName": "目标用户",
          "fieldType": "select",
          "required": false,
          "enumConfig": {
            "type": "static",
            "options": [
              { "value": "家庭", "label": "家庭" },
              { "value": "校园", "label": "校园" },
              { "value": "个人", "label": "个人" },
              { "value": "政企", "label": "政企" }
            ]
          }
        },
        {
          "fieldCode": "channelScope",
          "fieldName": "销售渠道",
          "fieldType": "select",
          "required": true,
          "enumConfig": {
            "type": "static",
            "options": [
              { "value": "A7", "label": "营业前台+电渠等(A7)" },
              { "value": "全渠道", "label": "全渠道" },
              { "value": "仅电渠", "label": "仅电渠" },
              { "value": "电渠+厅店", "label": "电渠+厅店" },
              { "value": "内部验证", "label": "内部验证" }
            ]
          }
        },
        {
          "fieldCode": "regionScope",
          "fieldName": "发布地市",
          "fieldType": "input",
          "required": false,
          "ruleDescription": "对应报文 groupId，如 10001=全省"
        },
        {
          "fieldCode": "fixedFeeAmount",
          "fieldName": "固费金额(元)",
          "fieldType": "number",
          "required": true,
          "ruleDescription": "ChargePlan.fixedFeeAmount → acctMonth.fixFee"
        },
        {
          "fieldCode": "monthlyFee",
          "fieldName": "月费(兼容)",
          "fieldType": "number",
          "required": false,
          "ruleDescription": "兼容旧字段，与 fixedFeeAmount 同步"
        },
        {
          "fieldCode": "oneTimeFee",
          "fieldName": "一次性费用",
          "fieldType": "number",
          "required": false,
          "defaultValue": 0
        },
        {
          "fieldCode": "includeVoice",
          "fieldName": "包含语音",
          "fieldType": "input",
          "required": false,
          "ruleDescription": "语音资源摘要，如 500分钟"
        },
        {
          "fieldCode": "includeData",
          "fieldName": "包含流量",
          "fieldType": "input",
          "required": false,
          "ruleDescription": "流量资源摘要，如 40GB"
        },
        {
          "fieldCode": "includeBroadband",
          "fieldName": "包含宽带",
          "fieldType": "input",
          "required": false,
          "ruleDescription": "宽带带宽摘要，如 500M"
        },
        {
          "fieldCode": "downstreamBandwidth",
          "fieldName": "下行带宽",
          "fieldType": "input",
          "required": false,
          "ruleDescription": "NetworkCapability → baseInfo.downStreamId"
        },
        {
          "fieldCode": "upstreamBandwidth",
          "fieldName": "上行带宽",
          "fieldType": "input",
          "required": false
        },
        {
          "fieldCode": "mutexGroup",
          "fieldName": "互斥组",
          "fieldType": "input",
          "required": false,
          "defaultValue": "MAIN_PKG",
          "ruleDescription": "主资费互斥组；附加资费一般为 ADDON"
        },
        {
          "fieldCode": "dependOn",
          "fieldName": "依赖主资费",
          "fieldType": "input",
          "required": false,
          "ruleDescription": "附加品类必填，指向主资费互斥组或编码"
        },
        {
          "fieldCode": "workOrderId",
          "fieldName": "需求工单号",
          "fieldType": "input",
          "required": false,
          "ruleDescription": "ConfigScheme.workOrderId → baseInfo.templateId"
        },
        {
          "fieldCode": "offeringType",
          "fieldName": "主附类型(兼容)",
          "fieldType": "select",
          "required": false,
          "enumConfig": {
            "type": "static",
            "options": [
              { "value": "main_pkg", "label": "主套餐" },
              { "value": "addon", "label": "附加包" },
              { "value": "fusion", "label": "融合套餐" },
              { "value": "promo", "label": "促销商品" }
            ]
          }
        }
      ]
    }
  ]
}
