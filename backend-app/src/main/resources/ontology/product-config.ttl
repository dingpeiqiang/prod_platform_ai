@prefix : <http://www.telecom-ontology.org/prod-config#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.telecom-ontology.org/prod-config#> .

<http://www.telecom-ontology.org/prod-config> rdf:type owl:Ontology ;
  rdfs:label "产商品配置本体模型"@zh ;
  rdfs:comment "v2.2业务视角优化：四层架构；拆分胖类；工单归方案；主附关系与配置变更显式建模；报文为投影。"@zh ;
  owl:versionInfo "2.2" .

# Object Properties
:configuresProduct rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :PricingProduct ;
  rdfs:comment "方案配置产商品资费"@zh ; rdfs:label "configuresProduct"@en .

:belongsToCategory rdf:type owl:ObjectProperty ;
  rdfs:domain :PricingProduct ; rdfs:range :ProductCategory ;
  rdfs:comment "资费属于品类"@zh ; rdfs:label "belongsToCategory"@en .

:hasSalesPolicy rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :SalesPolicy ;
  rdfs:comment "方案含销售策略"@zh ; rdfs:label "hasSalesPolicy"@en .

:hasReleaseScope rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :ReleaseScope ;
  rdfs:comment "方案含发布范围"@zh ; rdfs:label "hasReleaseScope"@en .

:hasNetworkCapability rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :NetworkCapability ;
  rdfs:comment "方案含网络能力"@zh ; rdfs:label "hasNetworkCapability"@en .

:hasFamilyOfferPolicy rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :FamilyOfferPolicy ;
  rdfs:comment "方案含家庭资费策略"@zh ; rdfs:label "hasFamilyOfferPolicy"@en .

:hasChargePlan rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :ChargePlan ;
  rdfs:comment "方案含固费方案"@zh ; rdfs:label "hasChargePlan"@en .

:hasPreferentialPlan rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :PreferentialPlan ;
  rdfs:comment "方案含优惠（含子类实例）"@zh ; rdfs:label "hasPreferentialPlan"@en .

:hasResourceEntitlement rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :ResourceEntitlement ;
  rdfs:comment "方案含资源权益（含子类）"@zh ; rdfs:label "hasResourceEntitlement"@en .

:hasPrintNotice rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :PrintNotice ;
  rdfs:comment "方案含免填单告知"@zh ; rdfs:label "hasPrintNotice"@en .

:hasSmsNotice rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :SmsNotice ;
  rdfs:comment "方案含短信告知"@zh ; rdfs:label "hasSmsNotice"@en .

:hasValueAddedEquity rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :ValueAddedEquity ;
  rdfs:comment "方案含增值权益"@zh ; rdfs:label "hasValueAddedEquity"@en .

:hasOfferCompatibility rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :OfferCompatibility ;
  rdfs:comment "方案含资费相容关系"@zh ; rdfs:label "hasOfferCompatibility"@en .

:hasConfigChange rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :ConfigChange ;
  rdfs:comment "方案含变更意图"@zh ; rdfs:label "hasConfigChange"@en .

:governedBy rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :ComplianceRule ;
  rdfs:comment "受合规治理"@zh ; rdfs:label "governedBy"@en .

:appliesScene rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :BusinessScene ;
  rdfs:comment "适用业务场景"@zh ; rdfs:label "appliesScene"@en .

:similarTo rdf:type owl:ObjectProperty ;
  rdfs:domain :ConfigScheme ; rdfs:range :ConfigScheme ;
  rdfs:comment "方案相似复用"@zh ; rdfs:label "similarTo"@en .

:appliesConstraint rdf:type owl:ObjectProperty ;
  rdfs:domain :ProductCategory ; rdfs:range :BusinessConstraint ;
  rdfs:comment "品类适用业务约束"@zh ; rdfs:label "appliesConstraint"@en .

:constrainsScheme rdf:type owl:ObjectProperty ;
  rdfs:domain :BusinessConstraint ; rdfs:range :ConfigScheme ;
  rdfs:comment "约束作用于配置方案"@zh ; rdfs:label "constrainsScheme"@en .

# Data Properties
:offerName rdf:type owl:DatatypeProperty ;
