:categoryCode rdf:type owl:DatatypeProperty ;
  rdfs:domain :ProductCategory ;
  rdfs:range xsd:string ;
  rdfs:label "categoryCode"@en , "品类编码"@zh .

:categoryName rdf:type owl:DatatypeProperty ;
  rdfs:domain :ProductCategory ;
  rdfs:range xsd:string ;
  rdfs:label "categoryName"@en , "品类名称"@zh .

:productLine rdf:type owl:DatatypeProperty ;
