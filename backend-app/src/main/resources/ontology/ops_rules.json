{
  "version": "OpsRules-v1.2",
  "description": "产商品运营规则单源。正式 OWL SWRL 仅 Openllet（OpsSwrlReasoner）；策略集阈值见 policy；旧 SwrlRuleEngine 为伪条件 DSL。",
  "engines": {
    "openllet-swrl": {
      "primary": true,
      "impl": "OpsSwrlReasoner",
      "covers": ["R-A01", "R-A02", "R-A03", "R-A04", "R-A05", "R-B01", "R-B02", "R-B03", "R-B04", "R-B05"],
      "note": "运营归因与风险正式 OWL SWRL；失败回退 java-rules"
    },
    "java-rules": {
      "primary": false,
      "impl": "ProductOntologyService",
      "covers": ["R-A01", "R-A02", "R-A03", "R-A04", "R-A05", "R-B01", "R-B02", "R-B03", "R-B04", "R-B05", "R-C01", "R-C02", "R-C03", "R-C04", "R-C05", "R-C06", "R-C07", "R-C08", "R-C09", "R-D01", "R-D05"],
      "note": "SWRL 回退 + 配置侧 R-C*（仍 Java）；阈值全部外置；非 Drools"
    },
    "policy-java": {
      "primary": false,
      "impl": "OntologyService",
      "covers": ["PS_PRODUCT_ONLINE_V1", "PS_PRODUCT_RISK_V1", "PS_MARKETING_RECOMMEND_V1", "PS_BILLING_REFUND_V1"]
    },
    "condition-dsl": {
      "deprecated": true,
      "impl": "SwrlRuleEngine",
      "note": "名含 SWRL 实为字符串条件表达式，仅营销策略遗留路径使用"
    }
  },
  "policy": {
    "sets": {
      "PS_PRODUCT_ONLINE_V1": {
        "name": "新品立项策略集",
        "description": "用于产商品新品立项门槛校验",
        "reasoning": "新品立项依据市场规模、产品类型和上线门槛进行校验",
        "triggeredRules": ["R-ONLINE-001"],
        "thresholds": {
          "marketSizeGte": 100000,
          "denyProductTypeOnLowMarket": "5G套餐"
        }
      },
      "PS_PRODUCT_RISK_V1": {
        "name": "产品风险稽核策略集",
        "description": "用于零资费与低效产品风险判定",
        "reasoning": "依据零资费、在售周期、新增和流失情况进行风险判定",
        "triggeredRules": ["R-RISK-001", "R-RISK-002"],
        "thresholds": {
          "zeroFeeOnlineMonthsGte": 3,
          "zeroFeeNewUsersLt": 50,
          "revenueGrowthLt": 0.03,
          "churnRateGt": 0.08,
          "onSaleStatus": "在售"
        }
      },
      "PS_MARKETING_RECOMMEND_V1": {
        "name": "营销推荐策略集",
        "description": "用于营销推荐场景的规则校验",
        "reasoning": "依据消费能力、会员等级和候选动作进行推荐校验",
        "triggeredRules": ["R001", "R003"],
        "thresholds": {
          "premiumSpendGte": 50000,
          "bundleSpendGte": 30000,
          "allowVipLevels": ["Gold", "Platinum"],
          "allowVipAlone": ["Platinum"]
        }
      },
      "PS_BILLING_REFUND_V1": {
        "name": "账单退款策略集",
        "description": "用于账单退款场景的规则校验",
        "reasoning": "依据退款类型与信用分进行合规校验",
        "triggeredRules": ["B001"],
        "thresholds": {
          "fullRefundCreditScoreGte": 700
        }
      }
    }
  },
  "rootCause": {
    "topN": 3,
    "rules": {
      "R-A01": {
        "name": "异动确认",
        "enabled": true,
        "engine": "swrl",
        "metricDeltaLte": -0.10,
        "honorAnomalyFlag": true
      },
      "R-A02": {
        "name": "渠道归因",
        "enabled": true,
        "engine": "swrl",
        "orderDeltaLte": -0.20,
        "contribRatioGte": 0.30
      },
      "R-A03": {
        "name": "促销归因",
        "enabled": true,
        "engine": "swrl",
        "daysToExpireLte": 7,
        "drivenOrderRatioGte": 0.25
      },
      "R-A04": {
        "name": "竞品冲击",
        "enabled": true,
        "engine": "swrl",
        "priceGapRatioGte": 0.15,
        "penetrationDeltaPpGt": 0
      },
      "R-A05": {
        "name": "行为变化",
        "enabled": true,
        "engine": "swrl",
        "minWeightHint": 0.08,
        "includeWhenRanked": true
      }
    }
  },
  "risk": {
    "defaults": {
      "ruleVersion": "RiskRules-v1.2",
      "zeroSalesShelfDays": 180,
      "zeroSalesDaysWindow": 30,
      "highRiskReviewDays": 30,
      "lowRevenuePercentile": 0.05
    },
    "scoring": {
      "high": 92,
      "medium": 70,
      "low": 40,
      "urgentBump": 5,
      "urgentCap": 99
    },
    "rules": {
      "R-B01": {
        "name": "高风险命中",
        "enabled": true,
        "engine": "swrl",
        "zeroFeeRequiresWhitelist": true,
        "fullDiscountPercentGte": 100,
        "fullDiscountNeedsRepeatable": true,
        "fullDiscountNeedsEmptyTargetGroup": true
      },
      "R-B02": {
        "name": "零元无合约在架",
        "enabled": true,
        "engine": "swrl",
        "requireOnShelf": true,
        "requireNoContract": true
      },
      "R-B03": {
        "name": "长期零销",
        "enabled": true,
        "engine": "swrl",
        "salesCntEq": 0,
        "useZeroSalesShelfDays": true
      },
      "R-B04": {
        "name": "优胜劣汰",
        "enabled": true,
        "engine": "swrl",
        "categories": ["low_eff", "threshold_demo"],
        "requireNoStrategicTag": true,
        "useLowRevenuePercentile": true
      },
      "R-B05": {
        "name": "风险复核",
        "enabled": true,
        "engine": "swrl",
        "requireHighRisk": true,
        "useHighRiskReviewDays": true
      }
    }
  },
  "config": {
    "defaults": {
      "channelScope": "全渠道",
      "mutexGroup": "MAIN_PKG",
      "includeBroadband": "500M",
      "campusMonthlyFee": 59,
      "monthlyFeeMin": 9,
      "monthlyFeeMax": 599,
      "fixedFeeMin": 9,
      "fixedFeeMax": 599
    },
    "rules": {
      "R-C01": {
        "name": "场景/品类默认补全",
        "enabled": true,
        "engine": "java",
        "proposalAlias": "SWRL-模板匹配",
        "fields": ["messageRootKey", "categoryCode", "requiredElements", "channelScope", "mutexGroup"]
      },
      "R-C02": {
        "name": "品类模板补全",
        "enabled": true,
        "engine": "java",
        "proposalAlias": "SWRL-模板补全",
        "fields": ["fixedFeeAmount", "includeVoice", "includeData", "includeBroadband", "downstreamBandwidth"]
      },
      "R-C03": {
        "name": "互斥/优惠冲突",
        "enabled": true,
        "engine": "java",
        "proposalAlias": "R-CONF-002",
        "fields": ["mutexGroup", "prefDiscount", "prefFee", "bindExistingMainPkg"]
      },
      "R-C04": {
        "name": "附加依赖主资费",
        "enabled": true,
        "engine": "java",
        "fields": ["isMainOffer", "dependOn", "sourceOfferRef", "offeringType"]
      },
      "R-C05": {
        "name": "高风险零固费",
        "enabled": true,
        "engine": "java",
        "fields": ["fixedFeeAmount", "oneTimeFee", "hasContract", "channelScope"]
      },
      "R-C06": {
        "name": "必填缺失",
        "enabled": true,
        "engine": "java",
        "fields": ["offeringName", "offerName", "messageRootKey", "fixedFeeAmount", "channelScope"]
      },
      "R-C07": {
        "name": "异常优惠漏洞",
        "enabled": true,
        "engine": "java",
        "fields": ["prefDiscount", "discountPercent", "repeatChargeFlag", "repeatable"]
      },
      "R-C08": {
        "name": "合规通过",
        "enabled": true,
        "engine": "java"
      },
      "R-C09": {
        "name": "固费上下限校验",
        "enabled": true,
        "engine": "java",
        "proposalAlias": "R-CONF-001",
        "fields": ["fixedFeeAmount", "monthlyFee", "chargePlan.fixedFeeAmount"]
      }
    },
    "proposalMapping": {
      "R-CONF-001": { "impl": "R-C09", "name": "固费上下限校验", "engineNote": "Java规则（非Drools），刚性校验不可被大模型覆盖；字段对齐 ChargePlan.fixedFeeAmount" },
      "R-CONF-002": { "impl": "R-C03", "name": "折扣与赠费/互斥冲突", "engineNote": "Java规则（非Drools），冲突需人工复核或拦截；对齐 PreferentialPlan" },
      "SWRL-模板匹配": { "impl": "R-C01/R-C02", "name": "场景与品类模板补全", "engineNote": "配置侧由Java按 ProductCategory.messageRootKey 推理补全；Openllet SWRL仅用于运营归因R-A*" }
    },
    "engineNarrative": "配置合规由 ProductOntologyService Java 规则执行（R-C*），业务属性对齐配置本体 v2.2；报文经 ConfigMessageProjector 投影；存储引擎为 RDF4J（非 Jena）。"
  },
  "extraction": {
    "aliases": {
      "畅享128": "OF-HF-128",
      "家庭融合128": "OF-HF-128",
      "家庭融合畅享128": "OF-HF-128",
      "OF-HF-128": "OF-HF-128"
    },
    "bindTriggers": ["再绑", "再加", "一起上"],
    "clearBindTriggers": ["不加128", "不加畅享128", "不绑128", "单独上", "取消绑定", "解除互斥"]
  },
  "ui": {
    "previewOfferingIds": ["OF-HF-128"],
    "previewLimit": 40
  },
  "batch": {
    "rules": {
      "R-D01": { "name": "批量映射", "enabled": true, "engine": "java", "note": "文档抽取槽位 → 业务属性（含 messageRootKey/fixedFeeAmount）" },
      "R-D02": { "name": "批量推理", "enabled": true, "engine": "java", "note": "按 ProductCategory 补全必备要素" },
      "R-D03": { "name": "批量合规", "enabled": true, "engine": "java", "note": "逐案执行 R-C* 合规" },
      "R-D04": { "name": "批量证据", "enabled": true, "engine": "java", "note": "汇总 issues/appliedRules/messagePreview" },
      "R-D05": { "name": "批量汇总", "enabled": true, "engine": "java", "note": "通过数/待修正数/品类分布" }
    }
  }
}
