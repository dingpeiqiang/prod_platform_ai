# 模块四：SWRL 规则（TBox 规则骨架 + 命名阈值个体）
# 模块三：SWRL 规则（TBox 规则骨架 + 命名阈值个体）
# 阈值以 :thresholdValue 断言；运行时由 OpsSwrlReasoner 按
# ops_rules.json / ops_rules.alertGrading 覆写对应阈值个体，
# 规则本体无需重建。规则标题见 rdfs:label（R-* 规则ID）。
#################################################################

# 阈值载体属性：阈值个体 -> 数值（运行时覆写）
:thresholdValue rdf:type owl:DatatypeProperty ;
    rdfs:domain :ThresholdHolder ;
    rdfs:range xsd:decimal ;
    rdfs:label "规则阈值"@zh ;
    rdfs:comment "SWRL body 中经 ?t 绑定；运行时按 ops_rules.json 覆写"@zh .

# ---------- 阈值个体（R-A 归因） ----------
:th_RA01_metricDeltaLte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "-0.10"^^xsd:decimal ; rdfs:label "指标环比跌幅阈值"@zh , "R-A01.metricDeltaLte"@en .
:th_RA02_orderDeltaLte  rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "-0.20"^^xsd:decimal ; rdfs:label "渠道订单跌幅阈值"@zh , "R-A02.orderDeltaLte"@en .
:th_RA02_contribRatioGte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "0.30"^^xsd:decimal ; rdfs:label "渠道贡献占比阈值"@zh , "R-A02.contribRatioGte"@en .
:th_RA03_daysToExpireLte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "7"^^xsd:decimal ; rdfs:label "优惠将到期天数阈值"@zh , "R-A03.daysToExpireLte"@en .
:th_RA03_drivenOrderRatioGte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "0.25"^^xsd:decimal ; rdfs:label "优惠驱动订单占比阈值"@zh , "R-A03.drivenOrderRatioGte"@en .
:th_RA04_priceGapRatioGte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "0.15"^^xsd:decimal ; rdfs:label "竞品价差比例阈值"@zh , "R-A04.priceGapRatioGte"@en .
:th_RA04_penetrationDeltaPpGt rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "0"^^xsd:decimal ; rdfs:label "竞品渗透率增幅阈值"@zh , "R-A04.penetrationDeltaPpGt"@en .
:th_RA05_minWeightHint rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "0.08"^^xsd:decimal ; rdfs:label "行为权重下限阈值"@zh , "R-A05.minWeightHint"@en .

# ---------- 阈值个体（R-B 风险） ----------
:th_RB01_fullDiscountPercentGte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "100"^^xsd:decimal ; rdfs:label "全额折扣比例阈值"@zh , "R-B01.fullDiscountPercentGte"@en .
:th_RB03_zeroSalesShelfDays rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "180"^^xsd:decimal ; rdfs:label "零销量在架天数阈值"@zh , "R-B03.zeroSalesShelfDays"@en .
:th_RB05_highRiskReviewDays rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "30"^^xsd:decimal ; rdfs:label "高风险复核天数阈值"@zh , "R-B05.highRiskReviewDays"@en .

# ---------- 阈值个体（R-E 告警） ----------
:th_RE01_feeErrorRateGte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "0.05"^^xsd:decimal ; rdfs:label "资费差错率阈值"@zh , "R-E01.feeErrorRateGte"@en .
:th_RE01_errorCountGte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "10"^^xsd:decimal ; rdfs:label "差错笔数阈值"@zh , "R-E01.errorCountGte"@en .
:th_RE02_errorCountGte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "1"^^xsd:decimal ; rdfs:label "差错笔数阈值"@zh , "R-E02.errorCountGte"@en .
