  rdfs:comment "报文键:planFlag"@zh ;
  rdfs:label "是否5G资费"@zh .

:addonProductType rdf:type owl:DatatypeProperty ;
  rdfs:domain :PricingProduct ;
  rdfs:range xsd:string ;
  rdfs:comment "报文键:prodType"@zh ;
  rdfs:label "附加产品类型"@zh .

:categoryCode rdf:type owl:DatatypeProperty ;
