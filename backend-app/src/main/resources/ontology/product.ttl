  rdfs:range xsd:string ;
  rdfs:comment "报文键:prodPrcName"@zh ;
  rdfs:label "资费名称"@zh .

:productCode rdf:type owl:DatatypeProperty ;
  rdfs:domain :PricingProduct ;
  rdfs:range xsd:string ;
  rdfs:comment "报文键:prodId"@zh ;
  rdfs:label "产品代码"@zh .

:pricingCode rdf:type owl:DatatypeProperty ;
  rdfs:domain :PricingProduct ;
  rdfs:range xsd:string ;
  rdfs:comment "报文键:prodPrcId"@zh ;
  rdfs:label "资费代码"@zh .

:splitCode rdf:type owl:DatatypeProperty ;
  rdfs:domain :PricingProduct ;
  rdfs:range xsd:string ;
  rdfs:comment "报文键:pricingId"@zh ;
  rdfs:label "拆分代码"@zh .

:is5GOffer rdf:type owl:DatatypeProperty ;
