  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_ro5 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :churnUsersRiseFlag ; swrl:argument1 :v_ro5 ; swrl:argument2 :v_ro6 ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_ro6 "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :RetentionOffering ; swrl:argument1 :v_ro5 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "搭载率下跌捆绑建议"@zh , "R-O03.attach"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_ro7 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :attachRateDropFlag ; swrl:argument1 :v_ro7 ; swrl:argument2 :v_ro8 ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_ro8 "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :BundleUpsellOffering ; swrl:argument1 :v_ro7 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "ARPU 下滑提档建议"@zh , "R-O04.arpu"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_ro7 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :arpuDropFlag ; swrl:argument1 :v_ro7 ; swrl:argument2 :v_ro9 ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_ro9 "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :PriceOptimizeOffering ; swrl:argument1 :v_ro7 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "活跃度下滑促活建议"@zh , "R-O05.active"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_ro7 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :activeUsersDropFlag ; swrl:argument1 :v_ro7 ; swrl:argument2 :v_ro10 ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_ro10 "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :EngagementOffering ; swrl:argument1 :v_ro7 ] ) ] .

# ---------- 阈值个体（R-C 配置合规） ----------
:th_RC07_discountFull rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "100"^^xsd:decimal ; rdfs:label "折扣全额比例阈值"@zh , "R-C07.discountFull"@en .
:th_RC09_feeMin rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "9"^^xsd:decimal ; rdfs:label "固费下限阈值"@zh , "R-C09.feeMin"@en .
:th_RC09_feeMax rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "599"^^xsd:decimal ; rdfs:label "固费上限阈值"@zh , "R-C09.feeMax"@en .

# ---------- SWRL 变量声明（R-C） ----------
:v_c6n rdf:type swrl:Variable . :v_c6c rdf:type swrl:Variable . :v_c6f rdf:type swrl:Variable . :v_c6h rdf:type swrl:Variable .
:v_c6na rdf:type swrl:Variable . :v_c6ca rdf:type swrl:Variable . :v_c6fa rdf:type swrl:Variable . :v_c6ha rdf:type swrl:Variable .
:v_c3m rdf:type swrl:Variable . :v_c3b rdf:type swrl:Variable . :v_c3d rdf:type swrl:Variable . :v_c3g rdf:type swrl:Variable .
:v_c4 rdf:type swrl:Variable . :v_c4a rdf:type swrl:Variable . :v_c4p rdf:type swrl:Variable .
:v_cpt5 rdf:type swrl:Variable .
:v_c5 rdf:type swrl:Variable . :v_c5m rdf:type swrl:Variable . :v_c5o rdf:type swrl:Variable .
:v_c5c rdf:type swrl:Variable . :v_c5w rdf:type swrl:Variable . :v_c5i rdf:type swrl:Variable .
:v_c7 rdf:type swrl:Variable . :v_c7d rdf:type swrl:Variable . :v_c7r rdf:type swrl:Variable . :v_c7t rdf:type swrl:Variable .
:v_c9 rdf:type swrl:Variable . :v_c9f rdf:type swrl:Variable . :v_c9t rdf:type swrl:Variable .
:v_c9b rdf:type swrl:Variable . :v_c9g rdf:type swrl:Variable . :v_c9u rdf:type swrl:Variable .
:v_c8 rdf:type swrl:Variable . :v_c8v rdf:type swrl:Variable .

# ---------- 配置合规规则（R-C） ----------
[ rdf:type swrl:Imp ;
  rdfs:label "必填校验-名称缺失"@zh , "R-C06.name"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c6n ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :c06MissingName ; swrl:argument1 :v_c6n ; swrl:argument2 :v_c6na ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c6na "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C06MissingRequired ; swrl:argument1 :v_c6n ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "必填校验-品类缺失"@zh , "R-C06.category"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c6c ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :c06MissingCategory ; swrl:argument1 :v_c6c ; swrl:argument2 :v_c6ca ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c6ca "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C06MissingRequired ; swrl:argument1 :v_c6c ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "必填校验-资费缺失"@zh , "R-C06.fee"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c6f ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :c06MissingFee ; swrl:argument1 :v_c6f ; swrl:argument2 :v_c6fa ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c6fa "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C06MissingRequired ; swrl:argument1 :v_c6f ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "必填校验-渠道缺失"@zh , "R-C06.channel"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c6h ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :c06MissingChannel ; swrl:argument1 :v_c6h ; swrl:argument2 :v_c6ha ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c6ha "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C06MissingRequired ; swrl:argument1 :v_c6h ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "互斥组冲突"@zh , "R-C03.mutex"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c3m ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :bindsExistingMainPkg ; swrl:argument1 :v_c3m ; swrl:argument2 :v_c3b ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :sameMutexGroup ; swrl:argument1 :v_c3m ; swrl:argument2 :v_c3d ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c3b "true"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c3d "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C03MutualExclusiveConflict ; swrl:argument1 :v_c3m ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "折扣与赠费冲突"@zh , "R-C03.discountGift"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c3m ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasPreferredDiscount ; swrl:argument1 :v_c3m ; swrl:argument2 :v_c3d ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasGiftFee ; swrl:argument1 :v_c3m ; swrl:argument2 :v_c3g ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c3d "true"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c3g "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C03MutualExclusiveConflict ; swrl:argument1 :v_c3m ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "附加缺依赖"@zh , "R-C04"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c4 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :isAddonFlag ; swrl:argument1 :v_c4 ; swrl:argument2 :v_c4a ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasDependOn ; swrl:argument1 :v_c4 ; swrl:argument2 :v_c4p ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c4a "true"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c4p "false"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C04OrphanAddon ; swrl:argument1 :v_c4 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "高风险零固费"@zh , "R-C05"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c5 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :offeringFixedFee ; swrl:argument1 :v_c5 ; swrl:argument2 :v_c5m ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :oneTimeFee ; swrl:argument1 :v_c5 ; swrl:argument2 :v_c5o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasContract ; swrl:argument1 :v_c5 ; swrl:argument2 :v_c5c ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :inWhitelistFlag ; swrl:argument1 :v_c5 ; swrl:argument2 :v_c5w ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :internalTestFlag ; swrl:argument1 :v_c5 ; swrl:argument2 :v_c5i ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c5m "0"^^xsd:decimal ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c5o "0"^^xsd:decimal ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c5c "false"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c5w "false"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c5i "false"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C05HighRiskZeroFee ; swrl:argument1 :v_c5 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "异常优惠漏洞"@zh , "R-C07"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c7 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :discountPercent ; swrl:argument1 :v_c7 ; swrl:argument2 :v_c7d ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :repeatableOrderFlag ; swrl:argument1 :v_c7 ; swrl:argument2 :v_c7r ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RC07_discountFull ; swrl:argument2 :v_c7t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :v_c7d :v_c7t ) ]
              [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c7 ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c7r "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C07AbnormalDiscount ; swrl:argument1 :v_c7 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "固费低于下限"@zh , "R-C09.below"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c9b ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :offeringFixedFee ; swrl:argument1 :v_c9b ; swrl:argument2 :v_c9f ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RC09_feeMin ; swrl:argument2 :v_c9t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:lessThan ; swrl:arguments ( :v_c9f :v_c9t ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C09FeeRangeViolation ; swrl:argument1 :v_c9b ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "固费超出上限"@zh , "R-C09.above"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c9u ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :offeringFixedFee ; swrl:argument1 :v_c9u ; swrl:argument2 :v_c9f ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RC09_feeMax ; swrl:argument2 :v_c9t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( :v_c9f :v_c9t ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C09FeeRangeViolation ; swrl:argument1 :v_c9u ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "配置合规通过"@zh , "R-C08"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_c8 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasViolation ; swrl:argument1 :v_c8 ; swrl:argument2 :v_c8v ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_c8v "false"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :C08Compliant ; swrl:argument1 :v_c8 ] ) ] .

###############################################################################
# ABox — 场景验证实例
#
# 用途：供 Protege / Pellet / HermiT / Openllet 本地导入后直接推理，验证各场景
#       SWRL 规则能否命中对应结论类。每个实例都带齐规则前件所需的全部属性，
#       数值取到能必然命中（或必然不命中）的一侧，不依赖外部数据。
#
# 约定：
#   1. 实例一律以 :probe_ 开头，与业务品类个体区分；
#   2. R-C08 依赖 :hasViolation，凡期望合规的实例显式写 false，期望违规的写 true；
#   3. 每组实例的 rdfs:comment 标注期望推理结论，便于断言。
###############################################################################

# ---------- 场景 01 风险识别（R-B01 / R-B02） ----------
:probe_rb01ZeroFee rdf:type owl:NamedIndividual , :Offering ;
  :monthlyFee "0"^^xsd:decimal ;
  :oneTimeFee "0"^^xsd:decimal ;
  :inWhitelist "false"^^xsd:boolean ;
  :onShelf "true"^^xsd:boolean ;
  :hasContract "false"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-B01.zeroFee → ZeroFeeRiskOffering，再命中 R-B02 → ZeroFeeNoContractOffering"@zh ;
  rdfs:label "验证-零元资费在架无合约"@zh .

:probe_rb01Discount rdf:type owl:NamedIndividual , :Offering ;
  :discountPercent "100"^^xsd:decimal ;
  :repeatableFlag "true"^^xsd:boolean ;
  :emptyTargetGroup "true"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-B01.discount → AbnormalDiscountOffering"@zh ;
  rdfs:label "验证-异常全额赠送"@zh .

:probe_rb03ZeroSales rdf:type owl:NamedIndividual , :Offering ;
  :salesCnt30d "0"^^xsd:decimal ;
  :shelfDays "200"^^xsd:decimal ;
  rdfs:comment "期望：命中 R-B03 → ZeroSalesOffering（阈值 180）"@zh ;
  rdfs:label "验证-长期零销"@zh .

# ---------- 场景 02 配置合规（R-C03~C09） ----------
:probe_c06Missing rdf:type owl:NamedIndividual , :Offering ;
  :c06MissingName "true"^^xsd:boolean ;
  :hasViolation "true"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-C06.name → C06MissingRequired"@zh ;
  rdfs:label "验证-必填名称缺失"@zh .

:probe_c03Mutex rdf:type owl:NamedIndividual , :Offering ;
  :bindsExistingMainPkg "true"^^xsd:boolean ;
  :sameMutexGroup "true"^^xsd:boolean ;
  :hasViolation "true"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-C03.mutex → C03MutualExclusiveConflict"@zh ;
  rdfs:label "验证-互斥组冲突"@zh .

:probe_c04OrphanAddon rdf:type owl:NamedIndividual , :Offering ;
  :isAddonFlag "true"^^xsd:boolean ;
  :hasDependOn "false"^^xsd:boolean ;
  :hasViolation "true"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-C04 → C04OrphanAddon"@zh ;
  rdfs:label "验证-附加缺依赖"@zh .

:probe_c05HighRiskZeroFee rdf:type owl:NamedIndividual , :Offering ;
  :offeringFixedFee "0"^^xsd:float ;
  :oneTimeFee "0"^^xsd:decimal ;
  :hasContract "false"^^xsd:boolean ;
  :inWhitelistFlag "false"^^xsd:boolean ;
  :internalTestFlag "false"^^xsd:boolean ;
  :hasViolation "true"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-C05 → C05HighRiskZeroFee"@zh ;
  rdfs:label "验证-高风险零固费"@zh .

:probe_c07AbnormalDiscount rdf:type owl:NamedIndividual , :Offering ;
  :discountPercent "100"^^xsd:decimal ;
  :repeatableOrderFlag "true"^^xsd:boolean ;
  :hasViolation "true"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-C07 → C07AbnormalDiscount（阈值 100）"@zh ;
  rdfs:label "验证-异常优惠漏洞"@zh .

:probe_c09Above rdf:type owl:NamedIndividual , :Offering ;
  :offeringFixedFee "999"^^xsd:float ;
  :hasViolation "true"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-C09.above → C09FeeRangeViolation（上限 599）"@zh ;
  rdfs:label "验证-固费超上限"@zh .

:probe_c09Below rdf:type owl:NamedIndividual , :Offering ;
  :offeringFixedFee "1"^^xsd:float ;
  :hasViolation "true"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-C09.below → C09FeeRangeViolation（下限 9）"@zh ;
  rdfs:label "验证-固费低于下限"@zh .

:probe_c08Compliant rdf:type owl:NamedIndividual , :Offering ;
  :offeringFixedFee "128"^^xsd:float ;
  :oneTimeFee "0"^^xsd:decimal ;
  :hasViolation "false"^^xsd:boolean ;
  rdfs:comment "期望：无任何 C0x 违规，命中 R-C08 → C08Compliant（反例）"@zh ;
  rdfs:label "验证-合规通过"@zh .

# ---------- 场景 03 指标归因（R-A01 / R-A02） ----------
:probe_a01Metric rdf:type owl:NamedIndividual , :Metric ;
  :metricDelta "-0.20"^^xsd:decimal ;
  rdfs:comment "期望：metricDelta -0.20 <= -0.10，命中 R-A01.delta"@zh ;
  rdfs:label "验证-指标下滑"@zh .

:probe_a01AnomalyOffering rdf:type owl:NamedIndividual , :Offering ;
  :hasMetric :probe_a01Metric ;
  rdfs:comment "期望：经 R-A01.delta 归入 AnomalyOffering"@zh ;
  rdfs:label "验证-异常品类（归因入口）"@zh .

:probe_a02Channel rdf:type owl:NamedIndividual , :Channel ;
  :orderDelta "-0.30"^^xsd:decimal ;
  :contribRatio "0.50"^^xsd:decimal ;
  rdfs:comment "期望：经 R-A02 归入 ChannelRootCause（前件要求品类已入 AnomalyOffering 且 soldOn 该渠道）"@zh ;
  rdfs:label "验证-渠道量效下滑"@zh .

:probe_a02AnomalyOffering rdf:type owl:NamedIndividual , :AnomalyOffering , :Offering ;
  :soldOn :probe_a02Channel ;
  rdfs:comment "期望：orderDelta<=-0.20 且 contribRatio>=0.30，经 R-A02 推出 ChannelRootCause"@zh ;
  rdfs:label "验证-渠道归因入口品类"@zh .

# ---------- 场景 04 告警分级（R-E01~R-E04） ----------
:probe_re01P0 rdf:type owl:NamedIndividual , :Offering ;
  :feeErrorRate "0.10"^^xsd:decimal ;
  rdfs:comment "期望：feeErrorRate 0.10 >= 0.05，命中 R-E01.fee → P0AlertOffering，并连推 R-E04.p0 → NeedWorkOrderOffering"@zh ;
  rdfs:label "验证-P0 资费差错率高"@zh .

:probe_re02P1 rdf:type owl:NamedIndividual , :Offering ;
  :errorCount "3"^^xsd:decimal ;
  rdfs:comment "期望：errorCount 3 >= 1，命中 R-E02.err → P1AlertOffering"@zh ;
  rdfs:label "验证-P1 差错笔数"@zh .

:probe_re03P2 rdf:type owl:NamedIndividual , :Offering ;
  :errorTrendUp "true"^^xsd:boolean ;
  rdfs:comment "期望：命中 R-E03.errTrend → P2AlertOffering"@zh ;
  rdfs:label "验证-P2 差错上行趋势"@zh .


