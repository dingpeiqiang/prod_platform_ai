# Classes
:PricingProduct rdf:type owl:Class ;
  rdfs:comment "可销售的产商品资费业务主体，仅承载资费身份与命名；不承载工单、销售期等过程或策略信息"@zh ;
  rdfs:label "产商品资费"@zh .

:ProductCategory rdf:type owl:Class ;
  rdfs:comment "按产品线与主附关系划分的品类，决定配置方案须装配的业务要素组合；对接时映射逻辑报文根键"@zh ;
  rdfs:label "产品品类"@zh .

:OfferCompatibility rdf:type owl:Class ;
  rdfs:comment "描述主资费与附加资费、升档/变更之间的可办、互斥与连带业务关系"@zh ;
  rdfs:label "资费相容关系"@zh .

:ConfigScheme rdf:type owl:Class ;
  rdfs:comment "一次产商品配置的过程与结果载体：关联需求工单、装配业务要素、经历审核上线，并可投影为逻辑报文"@zh ;
  rdfs:label "配置方案"@zh .

:ConfigChange rdf:type owl:Class ;
  rdfs:comment "对已有资费配置的增量变更意图，记录变更操作类型与变更内容，对应业务上的改资费/改组件"@zh ;
  rdfs:label "配置变更"@zh .

:SalesPolicy rdf:type owl:Class ;
  rdfs:comment "规范订购、退订、销售期、资费有效期与重复订购等销售侧规则"@zh ;
  rdfs:label "销售策略"@zh .

:ReleaseScope rdf:type owl:Class ;
  rdfs:comment "资费可销售的渠道与地域边界"@zh ;
  rdfs:label "发布范围"@zh .

:NetworkCapability rdf:type owl:Class ;
  rdfs:comment "资费承诺的网络侧能力规格，如带宽、域名、5G速率、是否可加入家庭组网"@zh ;
  rdfs:label "网络能力"@zh .

:FamilyOfferPolicy rdf:type owl:Class ;
  rdfs:comment "家庭类资费的组网与成员业务约定：套餐类型、成员规模、统付、协议期、主副宽及成员月租等"@zh ;
  rdfs:label "家庭资费策略"@zh .

:ChargePlan rdf:type owl:Class ;
  rdfs:comment "账务固费收取安排：收费方式、固定费、科目、税率拆分与收费有效期"@zh ;
  rdfs:label "固费收费方案"@zh .

:PreferentialPlan rdf:type owl:Class ;
  rdfs:comment "账务侧让利安排的抽象父类；具体分为账务优惠、保底、话单优惠等子类"@zh ;
  rdfs:label "优惠方案"@zh .

:AccountPreferential rdf:type owl:Class ;
  rdfs:subClassOf :PreferentialPlan ;
  rdfs:comment "无条件/首月等账务优惠，含送费或打折及作用科目"@zh ;
  rdfs:label "账务优惠"@zh .

:FloorGuarantee rdf:type owl:Class ;
  rdfs:subClassOf :PreferentialPlan ;
  rdfs:comment "消费保底方式、保底金额与作用科目及有效期"@zh ;
  rdfs:label "保底约定"@zh .

:CdrPreferential rdf:type owl:Class ;
  rdfs:subClassOf :PreferentialPlan ;
  rdfs:comment "基于话单维度的优惠开关与安排"@zh ;
  rdfs:label "话单优惠"@zh .

:ResourceEntitlement rdf:type owl:Class ;
  rdfs:comment "通信资源赠送与套外计费的抽象父类；按流量/语音/短信分子类"@zh ;
  rdfs:label "资源权益"@zh .

:DataResource rdf:type owl:Class ;
  rdfs:subClassOf :ResourceEntitlement ;
  rdfs:comment "流量类资源权益：类型、单位、定向内容、地域、周期、结转与套外标准"@zh ;
  rdfs:label "流量资源"@zh .

:VoiceResource rdf:type owl:Class ;
  rdfs:subClassOf :ResourceEntitlement ;
  rdfs:comment "语音类资源权益：资源类型、套外费率等"@zh ;
  rdfs:label "语音资源"@zh .

:SmsResource rdf:type owl:Class ;
  rdfs:subClassOf :ResourceEntitlement ;
  rdfs:comment "短信/彩信类资源权益"@zh ;
  rdfs:label "短信资源"@zh .

:PrintNotice rdf:type owl:Class ;
  rdfs:comment "免填单等书面对客展示文案，属于告知材料，不等于账务/资源真值"@zh ;
  rdfs:label "免填单告知"@zh .

:SmsNotice rdf:type owl:Class ;
  rdfs:comment "订购/退订/二确/到期等短信通知内容与指令配置"@zh ;
  rdfs:label "短信告知"@zh .

:ValueAddedEquity rdf:type owl:Class ;
  rdfs:comment "非基础通信类增值权益内容配置"@zh ;
  rdfs:label "增值权益"@zh .

:BusinessConstraint rdf:type owl:Class ;
  rdfs:comment "配置合法性约束：条件必填、互斥、派生、跨要素连带，供推理与页面联动"@zh ;
  rdfs:label "业务约束"@zh .

:ComplianceRule rdf:type owl:Class ;
  rdfs:comment "监管与企业红线，由规则引擎刚性执行，不可被大模型覆盖"@zh ;
  rdfs:label "合规规则"@zh .

:BusinessScene rdf:type owl:Class ;
  rdfs:comment "投放与检索用的场景标签：渠道/用户群/地域"@zh ;
  rdfs:label "业务场景"@zh .

:CodeDictionary rdf:type owl:Class ;
  rdfs:comment "业务枚举字典，统一配置取值口径"@zh ;
  rdfs:label "业务码表"@zh .

#################################################################
# 模块二：运营归因与风险本体（原 product-ops.ttl，v1.1）
# 产商品 / 指标 / 渠道 / 促销 / 竞品 / 行为 / 风险。
#################################################################

# Classes — 主体与证据
:Offering rdf:type owl:Class ;
    rdfs:label "产商品"@zh ;
    rdfs:comment "监控/归因/分级的统一业务主体；运行时以 offeringId 断言，承载指标事实"@zh .

:Metric rdf:type owl:Class ; rdfs:label "指标"@zh .
:Channel rdf:type owl:Class ; rdfs:label "渠道"@zh .
:Promotion rdf:type owl:Class ; rdfs:label "促销"@zh .
:Competitor rdf:type owl:Class ; rdfs:label "竞品"@zh .
:UserBehavior rdf:type owl:Class ; rdfs:label "用户行为"@zh .
:ThresholdHolder rdf:type owl:Class ;
    rdfs:label "阈值载体"@zh ;
    rdfs:comment "承载 SWRL 规则命名阈值的个体类，运行时由 OpsSwrlReasoner 覆写"@zh .

# Classes — 归因结论（SWRL head）
:AnomalyOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "异动产商品"@zh ;
    rdfs:comment "R-A01 点火"@zh .
:ChannelRootCause rdf:type owl:Class ;
    rdfs:subClassOf :Channel ;
    rdfs:label "渠道根因候选"@zh ;
    rdfs:comment "R-A02 点火"@zh .
:PromotionRootCause rdf:type owl:Class ;
    rdfs:subClassOf :Promotion ;
    rdfs:label "促销根因候选"@zh ;
    rdfs:comment "R-A03 点火"@zh .
:CompetitorRootCause rdf:type owl:Class ;
    rdfs:subClassOf :Competitor ;
    rdfs:label "竞品根因候选"@zh ;
    rdfs:comment "R-A04 点火"@zh .
:BehaviorRootCause rdf:type owl:Class ;
    rdfs:subClassOf :UserBehavior ;
    rdfs:label "行为根因候选"@zh ;
    rdfs:comment "R-A05 点火"@zh .

# Classes — 风险结论（SWRL head）
:ZeroFeeRiskOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "零元资费风险"@zh ;
    rdfs:comment "R-B01 零元"@zh .
:AbnormalDiscountOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "异常全额赠送"@zh ;
    rdfs:comment "R-B01 全额折扣"@zh .
:ZeroFeeNoContractOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "零元无合约在架"@zh ;
    rdfs:comment "R-B02"@zh .
:ZeroSalesOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "长期零销"@zh ;
    rdfs:comment "R-B03"@zh .
:LowEffOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "低效产商品"@zh ;
    rdfs:comment "R-B04"@zh .
:HighRiskOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "高风险产商品"@zh ;
    rdfs:comment "由 B01/B02 等高风险规则归入"@zh .
:UrgentReviewOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "需紧急复核"@zh ;
    rdfs:comment "R-B05"@zh .

# Classes — 配置合规结论（SWRL head，R-C*；每规则一类便于回读命中）
:ConfigViolation rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "配置违规"@zh ;
    rdfs:comment "R-C03/04/05/06/07/09 违规结论抽象父类"@zh .
:C06MissingRequired rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "必填缺失"@zh ;
    rdfs:comment "R-C06 必填字段缺失"@zh .
:C03MutualExclusiveConflict rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "互斥冲突"@zh ;
    rdfs:comment "R-C03 与在架互斥组冲突 / 折扣与赠费并存"@zh .
:C04OrphanAddon rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "附加缺依赖"@zh ;
    rdfs:comment "R-C04 附加资费缺少依赖主资费"@zh .
:C05HighRiskZeroFee rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "高风险零固费"@zh ;
    rdfs:comment "R-C05 固费/一次性费为0且无合约、非白名单"@zh .
:C07AbnormalDiscount rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "异常优惠漏洞"@zh ;
    rdfs:comment "R-C07 折扣100%且可重复订购"@zh .
:C09FeeRangeViolation rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "资费区间违规"@zh ;
    rdfs:comment "R-C09 固费超出合规上下限"@zh .
:C08Compliant rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "合规通过"@zh ;
    rdfs:comment "R-C08 无任何 ConfigViolation 命中"@zh .

# Object properties
:hasMetric rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :Metric ; rdfs:label "拥有指标"@zh .
:soldOn rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :Channel ; rdfs:label "销售渠道"@zh .
:participatesIn rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :Promotion ; rdfs:label "参与促销"@zh .
:competesWith rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :Competitor ; rdfs:label "对标竞品"@zh .
:influencedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :UserBehavior ; rdfs:label "受行为影响"@zh .

# Datatype properties — Offering / Metric / Channel
:offeringId rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:string ;
    rdfs:label "销售品ID"@zh .
:offeringName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:string ;
    rdfs:label "产商品名称"@zh .
:metricCode rdf:type owl:DatatypeProperty ;
    rdfs:domain :Metric ; rdfs:range xsd:string ;
    rdfs:label "指标编码"@zh .
:metricDelta rdf:type owl:DatatypeProperty ;
    rdfs:domain :Metric ; rdfs:range xsd:decimal ;
    rdfs:label "指标环比变化量"@zh ;
    rdfs:comment "指标相对上期的环比变化量"@zh .
:metricDeltaPp rdf:type owl:DatatypeProperty ;
    rdfs:domain :Metric ; rdfs:range xsd:decimal ;
    rdfs:label "指标增幅（百分点）"@zh ;
    rdfs:comment "指标相对上期的增幅，单位为百分点"@zh .
:anomalyFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Metric ; rdfs:range xsd:boolean ;
    rdfs:label "异常标志"@zh ;
    rdfs:comment "指标是否命中异常的预计算标志"@zh .
:channelId rdf:type owl:DatatypeProperty ;
    rdfs:domain :Channel ; rdfs:range xsd:string ;
    rdfs:label "渠道ID"@zh ;
    rdfs:comment "渠道编码"@zh .
:channelName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Channel ; rdfs:range xsd:string ;
    rdfs:label "渠道名称"@zh ;
    rdfs:comment "渠道显示名称"@zh .
:orderDelta rdf:type owl:DatatypeProperty ;
    rdfs:domain :Channel ; rdfs:range xsd:decimal .
:contribRatio rdf:type owl:DatatypeProperty ;
    rdfs:domain :Channel ; rdfs:range xsd:decimal .
:weightHint rdf:type owl:DatatypeProperty ;
    rdfs:domain :UserBehavior ; rdfs:range xsd:decimal ;
    rdfs:label "行为权重"@zh ;
    rdfs:comment "用户行为对归因结论的权重提示值"@zh .

# Datatype properties — Promotion / Competitor / Behavior
:promoId rdf:type owl:DatatypeProperty ;
    rdfs:domain :Promotion ; rdfs:range xsd:string ;
    rdfs:label "促销ID"@zh ;
    rdfs:comment "促销编码"@zh .
:promoName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Promotion ; rdfs:range xsd:string ;
    rdfs:label "促销名称"@zh ;
    rdfs:comment "促销显示名称"@zh .
:daysToExpire rdf:type owl:DatatypeProperty ;
    rdfs:domain :Promotion ; rdfs:range xsd:decimal ;
    rdfs:label "优惠剩余天数"@zh ;
    rdfs:comment "促销距到期剩余天数"@zh .
:drivenOrderRatio rdf:type owl:DatatypeProperty ;
    rdfs:domain :Promotion ; rdfs:range xsd:decimal ;
    rdfs:label "优惠驱动订单占比"@zh ;
    rdfs:comment "由该优惠驱动的订单占比"@zh .
:competitorId rdf:type owl:DatatypeProperty ;
    rdfs:domain :Competitor ; rdfs:range xsd:string ;
    rdfs:label "竞品ID"@zh ;
    rdfs:comment "竞品编码"@zh .
:competitorName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Competitor ; rdfs:range xsd:string ;
    rdfs:label "竞品名称"@zh ;
    rdfs:comment "竞品显示名称"@zh .
:priceGap rdf:type owl:DatatypeProperty ;
    rdfs:domain :Competitor ; rdfs:range xsd:decimal ;
    rdfs:label "竞品价差"@zh ;
    rdfs:comment "与竞品价格的绝对差额"@zh .
:priceGapRatio rdf:type owl:DatatypeProperty ;
    rdfs:domain :Competitor ; rdfs:range xsd:decimal ;
    rdfs:label "竞品价差比例"@zh ;
    rdfs:comment "与竞品价差占本品的比例"@zh .
:penetrationDeltaPp rdf:type owl:DatatypeProperty ;
    rdfs:domain :Competitor ; rdfs:range xsd:decimal ;
    rdfs:label "竞品渗透增幅（百分点）"@zh ;
    rdfs:comment "竞品渗透率的增幅，单位为百分点"@zh .
:behaviorId rdf:type owl:DatatypeProperty ;
    rdfs:domain :UserBehavior ; rdfs:range xsd:string ;
    rdfs:label "行为ID"@zh ;
    rdfs:comment "用户行为编码"@zh .
:behaviorName rdf:type owl:DatatypeProperty ;
    rdfs:domain :UserBehavior ; rdfs:range xsd:string ;
    rdfs:label "行为名称"@zh ;
    rdfs:comment "用户行为显示名称"@zh .

# Datatype properties — 风险事实（运行时断言，含预计算布尔）
:monthlyFee rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "月费"@zh ;
    rdfs:comment "月固定资费金额"@zh .
:oneTimeFee rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "一次性费用"@zh ;
    rdfs:comment "一次性收取的费用金额"@zh .
:offeringFixedFee rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "商品固定月费"@zh ;
    rdfs:comment "风险与合规规则（R-C05/R-C09）在 Offering 侧断言的固定月费；区别于 ChargePlan 侧的 :fixedFeeAmount"@zh .
:salesCnt30d rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "近30天销量"@zh ;
    rdfs:comment "近 30 天销售笔数"@zh .
:shelfDays rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "在架天数"@zh ;
    rdfs:comment "商品已上架的天数"@zh .
:revenue30d rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "近30天收入"@zh ;
    rdfs:comment "近 30 天收入金额"@zh .
:discountPercent rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "折扣比例"@zh ;
    rdfs:comment "优惠折扣百分比"@zh .
:hasContract rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "有无合约"@zh ;
    rdfs:comment "是否签订合约"@zh .
:onShelf rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "是否在架"@zh ;
    rdfs:comment "商品是否处于在架状态"@zh .
:inWhitelist rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "是否在白名单"@zh ;
    rdfs:comment "是否命中白名单"@zh .
:repeatableFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "是否可重复办理"@zh ;
    rdfs:comment "商品是否允许重复办理"@zh .
:emptyTargetGroup rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "目标群是否为空"@zh ;
    rdfs:comment "目标群是否为空"@zh .
:strategicTagFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "战略标签标志"@zh ;
    rdfs:comment "是否带战略标签"@zh .
:lowEffCategoryFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "低效品类标志"@zh ;
    rdfs:comment "是否属于低效品类"@zh .
:lowRevenueFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "低收入标志"@zh ;
    rdfs:comment "是否属于低收入商品"@zh .

# Datatype properties — 配置合规事实（运行时断言，R-C*）
:isAddonFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "是附加品标志"@zh ;
    rdfs:comment "是否为附加品"@zh .
:hasDependOn rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "有依赖项"@zh ;
    rdfs:comment "是否存在依赖项"@zh .
:inWhitelistFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "白名单标志"@zh ;
    rdfs:comment "是否在白名单内"@zh .
:internalTestFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "内测标志"@zh ;
    rdfs:comment "是否为内测商品"@zh .
:repeatableOrderFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "可重复订购标志"@zh ;
    rdfs:comment "是否允许重复订购"@zh .
:hasPreferredDiscount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "有优选优惠"@zh ;
    rdfs:comment "是否配置优选优惠"@zh .
:isMainOfferFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "主资费标志"@zh ;
    rdfs:comment "是否为主资费"@zh .
:bindsExistingMainPkg rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "绑定现有主套餐"@zh ;
    rdfs:comment "是否绑定现有主套餐"@zh .
:c06MissingName rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "缺商品名称"@zh ;
    rdfs:comment "校验项：商品名称缺失"@zh .
:c06MissingCategory rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "缺品类"@zh ;
    rdfs:comment "校验项：品类缺失"@zh .
:c06MissingFee rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "缺资费"@zh ;
    rdfs:comment "校验项：资费缺失"@zh .
:c06MissingChannel rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "缺渠道"@zh ;
    rdfs:comment "校验项：渠道缺失"@zh .
:sameMutexGroup rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "同互斥组"@zh ;
    rdfs:comment "是否与同组商品互斥"@zh .
:hasGiftFee rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "有赠送费用"@zh ;
    rdfs:comment "是否含赠送费用"@zh .
:hasViolation rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "有违规"@zh ;
    rdfs:comment "是否已判定存在违规"@zh .

#################################################################
# 模块三：运行告警分级本体（原 product-alert.ttl，v1.0）
# 运行监控事实 / 告警等级 / SLA。分级仅依据指标事实，不编造根因。
#################################################################

# Classes — 运行指标
:MonitorMetric rdf:type owl:Class ;
    rdfs:label "运行指标"@zh ;
    rdfs:comment "订单量/异常量/计费差错率等逐品指标快照"@zh .

# Classes — 告警等级（SWRL head，分级结论）
:AlertOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "告警产商品"@zh ;
    rdfs:comment "R-E00 点火：任一指标触阈即归入"@zh .

:P0AlertOffering rdf:type owl:Class ;
    rdfs:subClassOf :AlertOffering ;
    rdfs:label "P0严重告警"@zh ;
    rdfs:comment "R-E01：计费差错率高企 / 异常量达到严重阈值，需立即处置"@zh .

:P1AlertOffering rdf:type owl:Class ;
    rdfs:subClassOf :AlertOffering ;
    rdfs:label "P1重要告警"@zh ;
    rdfs:comment "R-E02：存在异常量或计费差错，需当日处置"@zh .

:P2AlertOffering rdf:type owl:Class ;
    rdfs:subClassOf :AlertOffering ;
    rdfs:label "P2提示告警"@zh ;
    rdfs:comment "R-E03：仅趋势劣化无实量异常，观察即可"@zh .

:NeedWorkOrderOffering rdf:type owl:Class ;
    rdfs:subClassOf :AlertOffering ;
    rdfs:label "需建工单产商品"@zh ;
    rdfs:comment "R-E04：P0/P1 强制建单闭环，P2 不建单"@zh .

# Object properties — 运行监控事实
:hasMonitorMetric rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :MonitorMetric ;
    rdfs:label "拥有运行指标"@zh .

# Datatype properties — 监控事实（运行时断言）
:orderCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "订单量"@zh .

:errorCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "异常量"@zh .

:feeErrorRate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "计费差错率"@zh .

:orderTrendDown rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "订单量下滑"@zh ;
    rdfs:comment "预计算布尔：order_trend=下降"@zh .

:errorTrendUp rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "异常量上升"@zh ;
    rdfs:comment "预计算布尔：error_trend=上升"@zh .

:feeTrendUp rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "计费差错率上升"@zh ;
    rdfs:comment "预计算布尔：fee_trend=上升"@zh .

:alertLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain :AlertOffering ; rdfs:range xsd:string ;
    rdfs:label "告警等级"@zh ;
    rdfs:comment "P0/P1/P2，由 SWRL 分级结论映射写回"@zh .

:needWorkOrder rdf:type owl:DatatypeProperty ;
    rdfs:domain :AlertOffering ; rdfs:range xsd:boolean ;
    rdfs:label "需建工单"@zh .

# ---------- 指标异常属性（R-O 优化建议，运行时由 OpsSwrlReasoner 按实际指标断言） ----------
:revenueDropFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "\u6536\u5165\u4e0b\u964d"@zh ;
    rdfs:comment "\u9884\u7b97\u5e03\u5c40\u4e8e revenue_trend=\u4e0b\u964d\u4e14\u5e45\u5ea6\u8d85\u9608"@zh .

:newUsersDropFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "\u65b0\u589e\u7528\u6237\u4e0b\u964d"@zh .

:churnUsersRiseFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "\u6d41\u5931\u7528\u6237\u4e0a\u5347"@zh .

:activeUsersDropFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "\u6d3b\u8dc3\u7528\u6237\u4e0b\u964d"@zh .

:arpuDropFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "ARPU \u4e0b\u964d"@zh .

:attachRateDropFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "\u7ed1\u5b9a\u7387\u4e0b\u964d"@zh .

:orderDropFlag rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "\u8ba2\u5355\u91cf\u4e0b\u964d"@zh .

# ---------- \u4f18\u5316\u5efa\u8bae\u5206\u7c7b\uff08SWRL head\uff0cR-O01~R-O05\uff09 ----------
:SuggestionOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "\u53ef\u4f18\u5316\u5546\u54c1"@zh ;
    rdfs:comment "\u5b58\u5728\u6307\u6807\u5f02\u5e38\u3001\u53ef\u7ed9\u51fa\u8fd0\u8425\u4f18\u5316\u5efa\u8bae\u7684\u5546\u54c1"@zh .

:ChannelPromotionOffering rdf:type owl:Class ;
    rdfs:subClassOf :SuggestionOffering ;
    rdfs:label "\u6e20\u9053\u4fc3\u9500\u5efa\u8bae"@zh ;
    rdfs:comment "R-O01\uff1a\u6536\u5165/\u8ba2\u5355\u4e0b\u964d \u2192 \u6e20\u9053\u4fc3\u9500"@zh .

:RetentionOffering rdf:type owl:Class ;
    rdfs:subClassOf :SuggestionOffering ;
    rdfs:label "\u5ba2\u6237\u4fdd\u7559\u5efa\u8bae"@zh ;
    rdfs:comment "R-O02\uff1a\u6d41\u5931\u7528\u6237\u4e0a\u5347 \u2192 \u4fdd\u7559\u6d3b\u52a8"@zh .

:BundleUpsellOffering rdf:type owl:Class ;
    rdfs:subClassOf :SuggestionOffering ;
    rdfs:label "\u7ec4\u5408\u4ea4\u53c9\u9500\u552e\u5efa\u8bae"@zh ;
