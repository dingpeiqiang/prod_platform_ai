# ---------- 阈值个体（R-O 优化建议，趋势劣化布尔，运行时由 reasoner 直接断言） ----------
:th_RO01_revenueDropLte rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "-0.10"^^xsd:decimal ; rdfs:label "收入跌幅阈值"@zh , "R-O01.revenueDropLte"@en .
:th_RO02_churnRiseGte   rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "0.05"^^xsd:decimal ; rdfs:label "离网率升幅阈值"@zh , "R-O02.churnRiseGte"@en .
:th_RO03_attachDropLte  rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "-0.05"^^xsd:decimal ; rdfs:label "搭载率跌幅阈值"@zh , "R-O03.attachDropLte"@en .
:th_RO04_arpuDropLte    rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "-0.05"^^xsd:decimal ; rdfs:label "ARPU 跌幅阈值"@zh , "R-O04.arpuDropLte"@en .
:th_RO05_activeDropLte  rdf:type owl:NamedIndividual , :ThresholdHolder ; :thresholdValue "-0.05"^^xsd:decimal ; rdfs:label "活跃度跌幅阈值"@zh , "R-O05.activeDropLte"@en .

