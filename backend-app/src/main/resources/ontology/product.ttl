  rdfs:comment "报文键:canAddFamilyPrc/inProdPrcId"@zh ;
  rdfs:label "目标资费引用"@zh .

:upgradeEndsAddon rdf:type owl:DatatypeProperty ;
  rdfs:domain :OfferCompatibility ;
  rdfs:range xsd:boolean ;
  rdfs:comment "报文键:familyUpIfEnd"@zh ;
  rdfs:label "升档是否结束附加"@zh .

:allowChangeMainOffer rdf:type owl:DatatypeProperty ;
