#################################################################
# 模块三：运行告警分级本体（原 product-alert.ttl，v1.0）
# 运行监控事实 / 告警等级 / SLA。分级仅依据指标事实，不编造根因。
#################################################################

# Classes — 运行指标
:MonitorMetric rdf:type owl:Class ;
    rdfs:label "运行指标"@zh ;
    rdfs:comment "订单量/异常量/计费差错率等逐品指标快照"@zh .

# Classes — 告警等级（SWRL head，分级结论）
:AlertOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "告警产商品"@zh ;
    rdfs:comment "R-E00 点火：任一指标触阈即归入"@zh .

:P0AlertOffering rdf:type owl:Class ;
    rdfs:subClassOf :AlertOffering ;
    rdfs:label "P0严重告警"@zh ;
    rdfs:comment "R-E01：计费差错率高企 / 异常量达到严重阈值，需立即处置"@zh .

:P1AlertOffering rdf:type owl:Class ;
    rdfs:subClassOf :AlertOffering ;
    rdfs:label "P1重要告警"@zh ;
    rdfs:comment "R-E02：存在异常量或计费差错，需当日处置"@zh .

:P2AlertOffering rdf:type owl:Class ;
    rdfs:subClassOf :AlertOffering ;
    rdfs:label "P2提示告警"@zh ;
    rdfs:comment "R-E03：仅趋势劣化无实量异常，观察即可"@zh .

:NeedWorkOrderOffering rdf:type owl:Class ;
    rdfs:subClassOf :AlertOffering ;
    rdfs:label "需建工单产商品"@zh ;
    rdfs:comment "R-E04：P0/P1 强制建单闭环，P2 不建单"@zh .

# Object properties — 运行监控事实
:hasMonitorMetric rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :MonitorMetric ;
    rdfs:label "拥有运行指标"@zh .

# Datatype properties — 监控事实（运行时断言）
:orderCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "订单量"@zh .

:errorCount rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "异常量"@zh .

:feeErrorRate rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:decimal ;
    rdfs:label "计费差错率"@zh .

:orderTrendDown rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "订单量下滑"@zh ;
    rdfs:comment "预计算布尔：order_trend=下降"@zh .

:errorTrendUp rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "异常量上升"@zh ;
    rdfs:comment "预计算布尔：error_trend=上升"@zh .

:feeTrendUp rdf:type owl:DatatypeProperty ;
    rdfs:domain :Offering ; rdfs:range xsd:boolean ;
    rdfs:label "计费差错率上升"@zh ;
    rdfs:comment "预计算布尔：fee_trend=上升"@zh .

:alertLevel rdf:type owl:DatatypeProperty ;
    rdfs:domain :AlertOffering ; rdfs:range xsd:string ;
    rdfs:label "告警等级"@zh ;
    rdfs:comment "P0/P1/P2，由 SWRL 分级结论映射写回"@zh .

:needWorkOrder rdf:type owl:DatatypeProperty ;
    rdfs:domain :AlertOffering ; rdfs:range xsd:boolean ;
    rdfs:label "需建工单"@zh .

