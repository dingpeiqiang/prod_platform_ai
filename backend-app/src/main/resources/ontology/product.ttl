# Classes
:PricingProduct rdf:type owl:Class ;
  rdfs:comment "可销售的产商品资费业务主体，仅承载资费身份与命名；不承载工单、销售期等过程或策略信息"@zh ;
  rdfs:label "PricingProduct"@en , "产商品资费"@zh .

:ProductCategory rdf:type owl:Class ;
  rdfs:comment "按产品线与主附关系划分的品类，决定配置方案须装配的业务要素组合；对接时映射逻辑报文根键"@zh ;
  rdfs:label "ProductCategory"@en , "产品品类"@zh .

:OfferCompatibility rdf:type owl:Class ;
  rdfs:comment "描述主资费与附加资费、升档/变更之间的可办、互斥与连带业务关系"@zh ;
  rdfs:label "OfferCompatibility"@en , "资费相容关系"@zh .

:ConfigScheme rdf:type owl:Class ;
  rdfs:comment "一次产商品配置的过程与结果载体：关联需求工单、装配业务要素、经历审核上线，并可投影为逻辑报文"@zh ;
  rdfs:label "ConfigScheme"@en , "配置方案"@zh .

:ConfigChange rdf:type owl:Class ;
  rdfs:comment "对已有资费配置的增量变更意图，记录变更操作类型与变更内容，对应业务上的改资费/改组件"@zh ;
  rdfs:label "ConfigChange"@en , "配置变更"@zh .

:SalesPolicy rdf:type owl:Class ;
  rdfs:comment "规范订购、退订、销售期、资费有效期与重复订购等销售侧规则"@zh ;
  rdfs:label "SalesPolicy"@en , "销售策略"@zh .

:ReleaseScope rdf:type owl:Class ;
  rdfs:comment "资费可销售的渠道与地域边界"@zh ;
  rdfs:label "ReleaseScope"@en , "发布范围"@zh .

:NetworkCapability rdf:type owl:Class ;
  rdfs:comment "资费承诺的网络侧能力规格，如带宽、域名、5G速率、是否可加入家庭组网"@zh ;
  rdfs:label "NetworkCapability"@en , "网络能力"@zh .

:FamilyOfferPolicy rdf:type owl:Class ;
  rdfs:comment "家庭类资费的组网与成员业务约定：套餐类型、成员规模、统付、协议期、主副宽及成员月租等"@zh ;
  rdfs:label "FamilyOfferPolicy"@en , "家庭资费策略"@zh .

:ChargePlan rdf:type owl:Class ;
  rdfs:comment "账务固费收取安排：收费方式、固定费、科目、税率拆分与收费有效期"@zh ;
  rdfs:label "ChargePlan"@en , "固费收费方案"@zh .

:PreferentialPlan rdf:type owl:Class ;
  rdfs:comment "账务侧让利安排的抽象父类；具体分为账务优惠、保底、话单优惠等子类"@zh ;
  rdfs:label "PreferentialPlan"@en , "优惠方案"@zh .

:AccountPreferential rdf:type owl:Class ;
  rdfs:subClassOf :PreferentialPlan ;
  rdfs:comment "无条件/首月等账务优惠，含送费或打折及作用科目"@zh ;
  rdfs:label "AccountPreferential"@en , "账务优惠"@zh .

:FloorGuarantee rdf:type owl:Class ;
  rdfs:subClassOf :PreferentialPlan ;
  rdfs:comment "消费保底方式、保底金额与作用科目及有效期"@zh ;
  rdfs:label "FloorGuarantee"@en , "保底约定"@zh .

:CdrPreferential rdf:type owl:Class ;
  rdfs:subClassOf :PreferentialPlan ;
  rdfs:comment "基于话单维度的优惠开关与安排"@zh ;
  rdfs:label "CdrPreferential"@en , "话单优惠"@zh .

:ResourceEntitlement rdf:type owl:Class ;
  rdfs:comment "通信资源赠送与套外计费的抽象父类；按流量/语音/短信分子类"@zh ;
  rdfs:label "ResourceEntitlement"@en , "资源权益"@zh .

:DataResource rdf:type owl:Class ;
  rdfs:subClassOf :ResourceEntitlement ;
  rdfs:comment "流量类资源权益：类型、单位、定向内容、地域、周期、结转与套外标准"@zh ;
  rdfs:label "DataResource"@en , "流量资源"@zh .

:VoiceResource rdf:type owl:Class ;
  rdfs:subClassOf :ResourceEntitlement ;
  rdfs:comment "语音类资源权益：资源类型、套外费率等"@zh ;
  rdfs:label "VoiceResource"@en , "语音资源"@zh .

:SmsResource rdf:type owl:Class ;
  rdfs:subClassOf :ResourceEntitlement ;
  rdfs:comment "短信/彩信类资源权益"@zh ;
  rdfs:label "SmsResource"@en , "短信资源"@zh .

:PrintNotice rdf:type owl:Class ;
  rdfs:comment "免填单等书面对客展示文案，属于告知材料，不等于账务/资源真值"@zh ;
  rdfs:label "PrintNotice"@en , "免填单告知"@zh .

:SmsNotice rdf:type owl:Class ;
  rdfs:comment "订购/退订/二确/到期等短信通知内容与指令配置"@zh ;
  rdfs:label "SmsNotice"@en , "短信告知"@zh .

:ValueAddedEquity rdf:type owl:Class ;
  rdfs:comment "非基础通信类增值权益内容配置"@zh ;
  rdfs:label "ValueAddedEquity"@en , "增值权益"@zh .

:BusinessConstraint rdf:type owl:Class ;
  rdfs:comment "配置合法性约束：条件必填、互斥、派生、跨要素连带，供推理与页面联动"@zh ;
  rdfs:label "BusinessConstraint"@en , "业务约束"@zh .

:ComplianceRule rdf:type owl:Class ;
  rdfs:comment "监管与企业红线，由规则引擎刚性执行，不可被大模型覆盖"@zh ;
  rdfs:label "ComplianceRule"@en , "合规规则"@zh .

:BusinessScene rdf:type owl:Class ;
  rdfs:comment "投放与检索用的场景标签：渠道/用户群/地域"@zh ;
  rdfs:label "BusinessScene"@en , "业务场景"@zh .

:CodeDictionary rdf:type owl:Class ;
  rdfs:comment "业务枚举字典，统一配置取值口径"@zh ;
  rdfs:label "CodeDictionary"@en , "业务码表"@zh .

#################################################################
# 模块二：运营归因与风险本体（原 product-ops.ttl，v1.1）
# 产商品 / 指标 / 渠道 / 促销 / 竞品 / 行为 / 风险。
#################################################################

# Classes — 主体与证据
:Offering rdf:type owl:Class ;
    rdfs:label "产商品"@zh ;
    rdfs:comment "监控/归因/分级的统一业务主体；运行时以 offeringId 断言，承载指标事实"@zh .

:Metric rdf:type owl:Class ; rdfs:label "指标"@zh .
:Channel rdf:type owl:Class ; rdfs:label "渠道"@zh .
:Promotion rdf:type owl:Class ; rdfs:label "促销"@zh .
:Competitor rdf:type owl:Class ; rdfs:label "竞品"@zh .
:UserBehavior rdf:type owl:Class ; rdfs:label "用户行为"@zh .

# Classes — 归因结论（SWRL head）
:AnomalyOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "异动产商品"@zh ;
    rdfs:comment "R-A01 点火"@zh .
:ChannelRootCause rdf:type owl:Class ;
    rdfs:subClassOf :Channel ;
    rdfs:label "渠道根因候选"@zh ;
    rdfs:comment "R-A02 点火"@zh .
:PromotionRootCause rdf:type owl:Class ;
    rdfs:subClassOf :Promotion ;
    rdfs:label "促销根因候选"@zh ;
    rdfs:comment "R-A03 点火"@zh .
:CompetitorRootCause rdf:type owl:Class ;
    rdfs:subClassOf :Competitor ;
    rdfs:label "竞品根因候选"@zh ;
    rdfs:comment "R-A04 点火"@zh .
:BehaviorRootCause rdf:type owl:Class ;
    rdfs:subClassOf :UserBehavior ;
    rdfs:label "行为根因候选"@zh ;
    rdfs:comment "R-A05 点火"@zh .

# Classes — 风险结论（SWRL head）
:ZeroFeeRiskOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "零元资费风险"@zh ;
    rdfs:comment "R-B01 零元"@zh .
:AbnormalDiscountOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "异常全额赠送"@zh ;
    rdfs:comment "R-B01 全额折扣"@zh .
:ZeroFeeNoContractOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "零元无合约在架"@zh ;
    rdfs:comment "R-B02"@zh .
:ZeroSalesOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "长期零销"@zh ;
    rdfs:comment "R-B03"@zh .
:LowEffOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "低效产商品"@zh ;
    rdfs:comment "R-B04"@zh .
:HighRiskOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "高风险产商品"@zh ;
    rdfs:comment "由 B01/B02 等高风险规则归入"@zh .
:UrgentReviewOffering rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "需紧急复核"@zh ;
    rdfs:comment "R-B05"@zh .

# Classes — 配置合规结论（SWRL head，R-C*；每规则一类便于回读命中）
:ConfigViolation rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "配置违规"@zh ;
    rdfs:comment "R-C03/04/05/06/07/09 违规结论抽象父类"@zh .
:C06MissingRequired rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "必填缺失"@zh ;
    rdfs:comment "R-C06 必填字段缺失"@zh .
:C03MutualExclusiveConflict rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "互斥冲突"@zh ;
    rdfs:comment "R-C03 与在架互斥组冲突 / 折扣与赠费并存"@zh .
:C04OrphanAddon rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "附加缺依赖"@zh ;
    rdfs:comment "R-C04 附加资费缺少依赖主资费"@zh .
:C05HighRiskZeroFee rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "高风险零固费"@zh ;
    rdfs:comment "R-C05 固费/一次性费为0且无合约、非白名单"@zh .
:C07AbnormalDiscount rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "异常优惠漏洞"@zh ;
    rdfs:comment "R-C07 折扣100%且可重复订购"@zh .
:C09FeeRangeViolation rdf:type owl:Class ;
    rdfs:subClassOf :ConfigViolation ;
    rdfs:label "资费区间违规"@zh ;
    rdfs:comment "R-C09 固费超出合规上下限"@zh .
:C08Compliant rdf:type owl:Class ;
    rdfs:subClassOf :Offering ;
    rdfs:label "合规通过"@zh ;
    rdfs:comment "R-C08 无任何 ConfigViolation 命中"@zh .

# Object properties
:hasMetric rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :Metric ; rdfs:label "拥有指标"@zh .
:soldOn rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :Channel ; rdfs:label "销售渠道"@zh .
:participatesIn rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :Promotion ; rdfs:label "参与促销"@zh .
:competesWith rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :Competitor ; rdfs:label "对标竞品"@zh .
:influencedBy rdf:type owl:ObjectProperty ;
    rdfs:domain :Offering ; rdfs:range :UserBehavior ; rdfs:label "受行为影响"@zh .

# Datatype properties — Offering / Metric / Channel
:offeringId rdf:type owl:DatatypeProperty ;
