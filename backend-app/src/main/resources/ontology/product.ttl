# ---------- 归因规则（R-A） ----------
[ rdf:type swrl:Imp ;
  rdfs:label "指标下滑归因"@zh , "R-A01.delta"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_o ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasMetric ; swrl:argument1 :v_o ; swrl:argument2 :v_m ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :metricDelta ; swrl:argument1 :v_m ; swrl:argument2 :v_d ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA01_metricDeltaLte ; swrl:argument2 :v_t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( :v_d :v_t ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "指标异常标记归因"@zh , "R-A01.flag"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_o2 ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasMetric ; swrl:argument1 :v_o2 ; swrl:argument2 :v_m2 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :anomalyFlag ; swrl:argument1 :v_m2 ; swrl:argument2 :v_f2 ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_f2 "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o2 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "渠道量效下滑归因"@zh , "R-A02"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o3 ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :soldOn ; swrl:argument1 :v_o3 ; swrl:argument2 :v_c3 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :orderDelta ; swrl:argument1 :v_c3 ; swrl:argument2 :v_od3 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :contribRatio ; swrl:argument1 :v_c3 ; swrl:argument2 :v_cr3 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA02_orderDeltaLte ; swrl:argument2 :v_tod ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA02_contribRatioGte ; swrl:argument2 :v_tcr ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( :v_od3 :v_tod ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :v_cr3 :v_tcr ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ChannelRootCause ; swrl:argument1 :v_c3 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "优惠到期驱动归因"@zh , "R-A03"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o4 ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :participatesIn ; swrl:argument1 :v_o4 ; swrl:argument2 :v_p4 ]
