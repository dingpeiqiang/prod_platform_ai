  rdfs:range xsd:string ;
  rdfs:label "品类编码"@zh .

:categoryName rdf:type owl:DatatypeProperty ;
  rdfs:domain :ProductCategory ;
  rdfs:range xsd:string ;
  rdfs:label "品类名称"@zh .

:productLine rdf:type owl:DatatypeProperty ;
  rdfs:domain :ProductCategory ;
  rdfs:range xsd:string ;
  rdfs:label "产品线"@zh .

:isMainOffer rdf:type owl:DatatypeProperty ;
