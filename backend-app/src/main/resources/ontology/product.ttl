#################################################################
# 模块三：SWRL 规则（TBox 规则骨架 + 命名阈值个体）
# 阈值以 :thresholdValue 断言；运行时由 OpsSwrlReasoner 按
# ops_rules.json / ops_rules.alertGrading 覆写对应阈值个体，
# 规则本体无需重建。规则标题见 rdfs:label（R-* 规则ID）。
#################################################################

# 阈值载体属性：阈值个体 -> 数值（运行时覆写）
:thresholdValue rdf:type owl:DatatypeProperty ;
    rdfs:label "规则阈值"@zh ;
    rdfs:comment "SWRL body 中经 ?t 绑定；运行时按 ops_rules.json 覆写"@zh .

# ---------- 阈值个体（R-A 归因） ----------
:th_RA01_metricDeltaLte rdf:type owl:NamedIndividual ; :thresholdValue "-0.10"^^xsd:decimal ; rdfs:label "R-A01.metricDeltaLte"@en .
:th_RA02_orderDeltaLte  rdf:type owl:NamedIndividual ; :thresholdValue "-0.20"^^xsd:decimal ; rdfs:label "R-A02.orderDeltaLte"@en .
:th_RA02_contribRatioGte rdf:type owl:NamedIndividual ; :thresholdValue "0.30"^^xsd:decimal ; rdfs:label "R-A02.contribRatioGte"@en .
:th_RA03_daysToExpireLte rdf:type owl:NamedIndividual ; :thresholdValue "7"^^xsd:decimal ; rdfs:label "R-A03.daysToExpireLte"@en .
:th_RA03_drivenOrderRatioGte rdf:type owl:NamedIndividual ; :thresholdValue "0.25"^^xsd:decimal ; rdfs:label "R-A03.drivenOrderRatioGte"@en .
:th_RA04_priceGapRatioGte rdf:type owl:NamedIndividual ; :thresholdValue "0.15"^^xsd:decimal ; rdfs:label "R-A04.priceGapRatioGte"@en .
:th_RA04_penetrationDeltaPpGt rdf:type owl:NamedIndividual ; :thresholdValue "0"^^xsd:decimal ; rdfs:label "R-A04.penetrationDeltaPpGt"@en .
:th_RA05_minWeightHint rdf:type owl:NamedIndividual ; :thresholdValue "0.08"^^xsd:decimal ; rdfs:label "R-A05.minWeightHint"@en .

# ---------- 阈值个体（R-B 风险） ----------
:th_RB01_fullDiscountPercentGte rdf:type owl:NamedIndividual ; :thresholdValue "100"^^xsd:decimal ; rdfs:label "R-B01.fullDiscountPercentGte"@en .
:th_RB03_zeroSalesShelfDays rdf:type owl:NamedIndividual ; :thresholdValue "180"^^xsd:decimal ; rdfs:label "R-B03.zeroSalesShelfDays"@en .
:th_RB05_highRiskReviewDays rdf:type owl:NamedIndividual ; :thresholdValue "30"^^xsd:decimal ; rdfs:label "R-B05.highRiskReviewDays"@en .

# ---------- 阈值个体（R-E 告警） ----------
:th_RE01_feeErrorRateGte rdf:type owl:NamedIndividual ; :thresholdValue "0.05"^^xsd:decimal ; rdfs:label "R-E01.feeErrorRateGte"@en .
:th_RE01_errorCountGte rdf:type owl:NamedIndividual ; :thresholdValue "10"^^xsd:decimal ; rdfs:label "R-E01.errorCountGte"@en .
:th_RE02_errorCountGte rdf:type owl:NamedIndividual ; :thresholdValue "1"^^xsd:decimal ; rdfs:label "R-E02.errorCountGte"@en .
:th_RE02_feeErrorRateGte rdf:type owl:NamedIndividual ; :thresholdValue "0.01"^^xsd:decimal ; rdfs:label "R-E02.feeErrorRateGte"@en .

# ---------- SWRL 变量声明 ----------
:v_o rdf:type swrl:Variable . :v_m rdf:type swrl:Variable . :v_d rdf:type swrl:Variable . :v_t rdf:type swrl:Variable .
:v_o2 rdf:type swrl:Variable . :v_m2 rdf:type swrl:Variable . :v_f2 rdf:type swrl:Variable .
:v_o3 rdf:type swrl:Variable . :v_c3 rdf:type swrl:Variable . :v_od3 rdf:type swrl:Variable . :v_cr3 rdf:type swrl:Variable .
:v_tod rdf:type swrl:Variable . :v_tcr rdf:type swrl:Variable .
:v_o4 rdf:type swrl:Variable . :v_p4 rdf:type swrl:Variable . :v_d4 rdf:type swrl:Variable . :v_r4 rdf:type swrl:Variable .
:v_td rdf:type swrl:Variable . :v_tr rdf:type swrl:Variable .
:v_o5 rdf:type swrl:Variable . :v_c5 rdf:type swrl:Variable . :v_g5 rdf:type swrl:Variable . :v_pp5 rdf:type swrl:Variable .
:v_tg rdf:type swrl:Variable . :v_tp rdf:type swrl:Variable .
:v_o6 rdf:type swrl:Variable . :v_b6 rdf:type swrl:Variable . :v_w6 rdf:type swrl:Variable . :v_tw rdf:type swrl:Variable .
:v_rb1o rdf:type swrl:Variable . :v_rb1mf rdf:type swrl:Variable . :v_rb1ot rdf:type swrl:Variable . :v_rb1wl rdf:type swrl:Variable .
:v_rb1do rdf:type swrl:Variable . :v_rb1dd rdf:type swrl:Variable . :v_rb1dr rdf:type swrl:Variable . :v_rb1de rdf:type swrl:Variable .
:v_rb1t rdf:type swrl:Variable .
:v_rb2o rdf:type swrl:Variable . :v_rb2s rdf:type swrl:Variable . :v_rb2c rdf:type swrl:Variable .
:v_rb3o rdf:type swrl:Variable . :v_rb3s rdf:type swrl:Variable . :v_rb3d rdf:type swrl:Variable . :v_rb3t rdf:type swrl:Variable .
:v_rb4o rdf:type swrl:Variable . :v_rb4c rdf:type swrl:Variable . :v_rb4r rdf:type swrl:Variable . :v_rb4s rdf:type swrl:Variable .
:v_rb5o rdf:type swrl:Variable . :v_rb5d rdf:type swrl:Variable . :v_rb5t rdf:type swrl:Variable .
:v_hr1 rdf:type swrl:Variable . :v_hr2 rdf:type swrl:Variable .
:v_re1fo rdf:type swrl:Variable . :v_re1ff rdf:type swrl:Variable . :v_re1ft rdf:type swrl:Variable .
:v_re1eo rdf:type swrl:Variable . :v_re1ee rdf:type swrl:Variable . :v_re1et rdf:type swrl:Variable .
:v_re2eo rdf:type swrl:Variable . :v_re2ee rdf:type swrl:Variable . :v_re2et rdf:type swrl:Variable .
:v_re2fo rdf:type swrl:Variable . :v_re2ff rdf:type swrl:Variable . :v_re2ft rdf:type swrl:Variable .
:v_re3eo rdf:type swrl:Variable . :v_re3ef rdf:type swrl:Variable . :v_re3fo rdf:type swrl:Variable . :v_re3ff rdf:type swrl:Variable .
:v_re3do rdf:type swrl:Variable . :v_re3df rdf:type swrl:Variable .
:v_re4o rdf:type swrl:Variable . :v_re4bo rdf:type swrl:Variable .

# ---------- 归因规则（R-A） ----------
[ rdf:type swrl:Imp ;
  rdfs:label "R-A01.delta"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_o ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasMetric ; swrl:argument1 :v_o ; swrl:argument2 :v_m ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :metricDelta ; swrl:argument1 :v_m ; swrl:argument2 :v_d ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA01_metricDeltaLte ; swrl:argument2 :v_t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( :v_d :v_t ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "R-A01.flag"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_o2 ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :hasMetric ; swrl:argument1 :v_o2 ; swrl:argument2 :v_m2 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :anomalyFlag ; swrl:argument1 :v_m2 ; swrl:argument2 :v_f2 ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_f2 "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o2 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "R-A02"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o3 ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :soldOn ; swrl:argument1 :v_o3 ; swrl:argument2 :v_c3 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :orderDelta ; swrl:argument1 :v_c3 ; swrl:argument2 :v_od3 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :contribRatio ; swrl:argument1 :v_c3 ; swrl:argument2 :v_cr3 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA02_orderDeltaLte ; swrl:argument2 :v_tod ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA02_contribRatioGte ; swrl:argument2 :v_tcr ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( :v_od3 :v_tod ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :v_cr3 :v_tcr ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ChannelRootCause ; swrl:argument1 :v_c3 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "R-A03"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o4 ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :participatesIn ; swrl:argument1 :v_o4 ; swrl:argument2 :v_p4 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :daysToExpire ; swrl:argument1 :v_p4 ; swrl:argument2 :v_d4 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :drivenOrderRatio ; swrl:argument1 :v_p4 ; swrl:argument2 :v_r4 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA03_daysToExpireLte ; swrl:argument2 :v_td ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA03_drivenOrderRatioGte ; swrl:argument2 :v_tr ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:lessThanOrEqual ; swrl:arguments ( :v_d4 :v_td ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :v_r4 :v_tr ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :PromotionRootCause ; swrl:argument1 :v_p4 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "R-A04"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o5 ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :competesWith ; swrl:argument1 :v_o5 ; swrl:argument2 :v_c5 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :priceGapRatio ; swrl:argument1 :v_c5 ; swrl:argument2 :v_g5 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :penetrationDeltaPp ; swrl:argument1 :v_c5 ; swrl:argument2 :v_pp5 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA04_priceGapRatioGte ; swrl:argument2 :v_tg ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA04_penetrationDeltaPpGt ; swrl:argument2 :v_tp ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :v_g5 :v_tg ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( :v_pp5 :v_tp ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :CompetitorRootCause ; swrl:argument1 :v_c5 ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "R-A05"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AnomalyOffering ; swrl:argument1 :v_o6 ]
              [ rdf:type swrl:IndividualPropertyAtom ; swrl:propertyPredicate :influencedBy ; swrl:argument1 :v_o6 ; swrl:argument2 :v_b6 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :weightHint ; swrl:argument1 :v_b6 ; swrl:argument2 :v_w6 ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RA05_minWeightHint ; swrl:argument2 :v_tw ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :v_w6 :v_tw ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :BehaviorRootCause ; swrl:argument1 :v_b6 ] ) ] .

# ---------- 风险规则（R-B） ----------
[ rdf:type swrl:Imp ;
  rdfs:label "R-B01.zeroFee"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_rb1o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :monthlyFee ; swrl:argument1 :v_rb1o ; swrl:argument2 :v_rb1mf ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :oneTimeFee ; swrl:argument1 :v_rb1o ; swrl:argument2 :v_rb1ot ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :inWhitelist ; swrl:argument1 :v_rb1o ; swrl:argument2 :v_rb1wl ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_rb1mf "0"^^xsd:decimal ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_rb1ot "0"^^xsd:decimal ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_rb1wl "false"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ZeroFeeRiskOffering ; swrl:argument1 :v_rb1o ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "R-B01.discount"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_rb1do ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :discountPercent ; swrl:argument1 :v_rb1do ; swrl:argument2 :v_rb1dd ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :repeatableFlag ; swrl:argument1 :v_rb1do ; swrl:argument2 :v_rb1dr ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :emptyTargetGroup ; swrl:argument1 :v_rb1do ; swrl:argument2 :v_rb1de ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RB01_fullDiscountPercentGte ; swrl:argument2 :v_rb1t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThanOrEqual ; swrl:arguments ( :v_rb1dd :v_rb1t ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_rb1dr "true"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_rb1de "true"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :AbnormalDiscountOffering ; swrl:argument1 :v_rb1do ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "R-B02"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ZeroFeeRiskOffering ; swrl:argument1 :v_rb2o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :onShelf ; swrl:argument1 :v_rb2o ; swrl:argument2 :v_rb2s ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :hasContract ; swrl:argument1 :v_rb2o ; swrl:argument2 :v_rb2c ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_rb2s "true"^^xsd:boolean ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_rb2c "false"^^xsd:boolean ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ZeroFeeNoContractOffering ; swrl:argument1 :v_rb2o ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "R-B03"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_rb3o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :salesCnt30d ; swrl:argument1 :v_rb3o ; swrl:argument2 :v_rb3s ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :shelfDays ; swrl:argument1 :v_rb3o ; swrl:argument2 :v_rb3d ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :thresholdValue ; swrl:argument1 :th_RB03_zeroSalesShelfDays ; swrl:argument2 :v_rb3t ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:equal ; swrl:arguments ( :v_rb3s "0"^^xsd:decimal ) ]
              [ rdf:type swrl:BuiltinAtom ; swrl:builtin swrlb:greaterThan ; swrl:arguments ( :v_rb3d :v_rb3t ) ] ) ;
  swrl:head ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :ZeroSalesOffering ; swrl:argument1 :v_rb3o ] ) ] .

[ rdf:type swrl:Imp ;
  rdfs:label "R-B04"@en ;
  swrl:body ( [ rdf:type swrl:ClassAtom ; swrl:classPredicate :Offering ; swrl:argument1 :v_rb4o ]
              [ rdf:type swrl:DatavaluedPropertyAtom ; swrl:propertyPredicate :lowEffCategoryFlag ; swrl:argument1 :v_rb4o ; swrl:argument2 :v_rb4c ]
