{
  "app": {
    "name": "AI驱动动态表单底层框架",
    "version": "2.0.0",
    "debug": true
  },
  "dataSource": {
    "type": "database",
    "fallbackToFile": false
  },
  "llm": {
    "enabled": true,
    "provider": "custom",
    "thinking": true,
    "temperature": 0.5,
    "maxTokens": 4096,
    "maxInputTokens": 180000,
    
    "bufferSize": 20,
    "flushInterval": 0.05,
    "_note": "LLM 配置已迁移至前端动态管理，此处仅保留默认参数"
  },
  "features": {
    "enableHotReload": true,
    "enableCache": true,
    "cacheTTL": 3600
  },
  "logging": {
    "level": "DEBUG",
    "enableConsole": true,
    "enableFile": false,
    "filePath": "app/logs/app.log",
    "llmCallLogger": {
      "enableConsole": true,
      "enableFile": false,
      "enableDetailedRequest": true,
      "enableDetailedResponse": true,
      "maxPromptPreview": 500,
      "maxResponsePreview": 1000,
      "maxHistory": 1000
    },
    "sql": {
      "enableLogging": false,
      "enableConsole": false,
      "level": "INFO"
    },
    "modules": {
      "llm_service": "DEBUG",
      "chat_api": "DEBUG",
      "llm.minimax": "DEBUG",
      "config_loader": "INFO",
      "agent_executor": "INFO",
      "form_service": "INFO",
      "uvicorn.access": "WARNING",
      "httpx": "WARNING"
    }
  },
  "recommendation": {
    "countScoreWeight": 0.4,
    "userScoreWeight": 0.4,
    "timeScoreWeight": 0.2,
    "countScorePerUnit": 0.1,
    "userScorePerUnit": 0.2,
    "timeDecayDays": 30,
    "historyQueryLimit": 1000,
    "recommendationLimit": 3,
    "confidenceThreshold": 0.4,
    "enableSmartFilter": true
  },
  "smartRecommend": {
    "enableRuleInference": true,
    "enableStaticFallback": true,
    "enableHistoryInference": true,
    "maxRecommendationsPerField": 5
  },
  "sceneRecognition": {
    "defaultScene": "generic"
  },
  "fieldExtraction": {
    "separators": ["是", "为", "：", ":", " "]
  }
}