          "label": "解析用户输入",
          "model": "gpt-4",
          "temperature": 0.1,
          "topK": 20,
          "topP": 0.9,
          "maxTokens": 1024,
          "systemPrompt": "你是一个专业的资费备案助手，负责从用户输入中提取套餐相关信息。",
          "prompt": "从用户输入中提取套餐编码和操作类型：\n\n用户输入：{{user_input}}\n\n请输出JSON格式结果：\n{\n  \"tariff_code\": \"提取的套餐编码，如果没有则为空字符串\",\n  \"action_type\": \"新增/A, 修改/M, 删除/D，如果不确定则为A\"\n}",
          "keepHistory": false,
          "inputs": [
            { "name": "user_input", "valueType": "reference" }
          ],
          "outputs": [
            { "name": "parsed_result", "type": "object" }
          ],
          "outputVar": "parsed_result"
        },
        "position": {
          "x": 220,
          "y": 200
        }
      },
      {
        "id": "extract_tariff_code",
        "type": "variable",
        "data": {
