    "nodes": [
      {
        "id": "start",
        "type": "start",
        "data": {
          "label": "开始"
        },
        "position": {
          "x": 60,
          "y": 200
        }
      },
      {
        "id": "llm_parse",
        "type": "llm",
        "data": {
          "label": "解析用户输入",
          "prompt": "从用户输入中提取套餐编码和操作类型：\n\n用户输入：{{user_input}}\n\n请输出JSON格式结果：\n{\n  \"tariff_code\": \"提取的套餐编码，如果没有则为空字符串\",\n  \"action_type\": \"新增/A, 修改/M, 删除/D，如果不确定则为A\"\n}",
          "model": "gpt-4",
          "temperature": 0.1,
          "outputVar": "parsed_result"
        },
        "position": {
          "x": 220,
          "y": 200
        }
      },
      {
        "id": "check_code",
        "type": "condition",
        "data": {
          "label": "检查套餐编码",
          "condition": "{{parsed_result.tariff_code}} !== undefined && {{parsed_result.tariff_code}} !== ''"
        },
        "position": {
          "x": 380,
          "y": 200
        }
      },
      {
        "id": "ask_user",
        "type": "userInput",
        "data": {
          "label": "询问用户",
          "required": true,
          "inputType": "text",
          "prompt": "请提供您要备案的套餐编码（字母开头+数字组合）：",
          "outputVar": "user_tariff_code"
        },
        "position": {
          "x": 520,
          "y": 80
        }
      },
      {
        "id": "tool_query",
        "type": "tool",
        "data": {
          "label": "查询套餐信息",
          "toolType": "mcp",
          "toolName": "query_tariff_by_code",
          "params": {
            "tariff_code": "{{parsed_result.tariff_code || user_tariff_code}}"
          },
          "retryCount": 2,
          "retryDelay": 1,
          "outputVar": "tariff_info"
        },
        "position": {
          "x": 540,
          "y": 200
        }
      },
      {
        "id": "generate_form",
        "type": "form",
        "data": {
          "label": "生成备案表单",
