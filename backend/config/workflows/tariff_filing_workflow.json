          "valueSource": "reference",
          "varValue": "{{parsed_result.tariff_code}}",
          "scope": "workflow",
          "bindToOutput": true
        },
        "position": {
          "x": 300,
          "y": 200
        }
      },
      {
        "id": "check_code",
        "type": "condition",
        "data": {
          "label": "检查套餐编码",
          "branches": [
            {
              "type": "if",
              "expanded": true,
              "conditions": [
                {
                  "variable": "tariff_code",
                  "operator": "!=",
                  "valueType": "input",
                  "value": ""
                }
              ]
            },
            {
              "type": "else",
              "expanded": true,
              "conditions": []
            }
          ]
        },
        "position": {
          "x": 380,
          "y": 200
