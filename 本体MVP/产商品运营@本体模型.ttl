              :participatesIn :Promotion_PROMO_HF_GIFT ;
              :soldOn :Channel_CH_STORE ,
                           :Channel_CH_ONLINE ,
                           :Channel_CH_GRID ;
              :hasUserBehavior :Behavior_BEH_STORE_ORD ,
                           :Behavior_BEH_ONLINE_ORD ,
                           :Behavior_BEH_BB_RENEW ;
              :competesWith :Competitor_CMP_F120 ;
              :belongsToMarket :Market_MKT_HF ;
              :hasMetric :Metric_MET_HF_REV_202607 ,
                           :Metric_MET_HF_RET_202607 ;
              :producesAttribution :RCA_HF_202607 ;
              :offeringId "OF-HF-128" ;
              :offeringName "家庭融合畅享128" ;
              :state "上架" ;
              :shelfDays 400 ;
              :offeringType "主套餐" ;
              :hasContract 1 ;
              :strategicTag "普通" ;
              :salesCnt30d 5600 ;
              :revenue30d "718000.0"^^xsd:float ;
              :monthlyUsers 95000 .

