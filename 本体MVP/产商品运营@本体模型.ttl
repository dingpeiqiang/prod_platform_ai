@prefix : <http://www.telecom-ontology.org/productops#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@base <http://www.telecom-ontology.org/productops#> .

<http://www.telecom-ontology.org/productops> rdf:type owl:Ontology ;
                                            owl:imports <http://www.w3.org/2003/11/swrl> ;
                                            rdfs:comment "电信产商品运营领域本体模型，基于企业本体架构框架与产商品中心规范设计，覆盖运营指标异动智能根因分析与高风险产商品智能稽核/优胜劣汰两大MVP场景，用于推理引擎的知识表示与推理。"@zh ;
                                            rdfs:label "产商品运营本体模型"@zh ;
                                            owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2002/07/owl#functionalProperty
owl:functionalProperty rdf:type owl:AnnotationProperty .

#################################################################
#    Object Properties
#################################################################

###  http://www.telecom-ontology.org/productops#hasPricePlan
:hasPricePlan rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :price_plan ;
                 rdfs:comment "一个商品拥有零个或多个商品定价"@zh ;
                 rdfs:label "拥有定价"@zh .

###  http://www.telecom-ontology.org/productops#hasFavRule
:hasFavRule rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :fav_rule ;
                 rdfs:comment "一个商品关联零个或多个优惠规则"@zh ;
                 rdfs:label "关联优惠"@zh .

###  http://www.telecom-ontology.org/productops#participatesIn
:participatesIn rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :promotion ;
                 rdfs:comment "一个商品可参与多个促销活动"@zh ;
                 rdfs:label "参与促销"@zh .

###  http://www.telecom-ontology.org/productops#soldOn
:soldOn rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :channel ;
                 rdfs:comment "一个商品可上架到多个销售渠道"@zh ;
                 rdfs:label "上架于"@zh .

###  http://www.telecom-ontology.org/productops#hasUserBehavior
:hasUserBehavior rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :user_behavior ;
                 rdfs:comment "一个商品产生多条用户行为统计"@zh ;
                 rdfs:label "产生行为"@zh .

###  http://www.telecom-ontology.org/productops#competesWith
:competesWith rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :competitor_offer ;
                 rdfs:comment "一个商品可对标多个竞品"@zh ;
                 rdfs:label "对标竞品"@zh .

###  http://www.telecom-ontology.org/productops#belongsToMarket
:belongsToMarket rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :market_scope ;
                 rdfs:comment "一个商品属于一个产品市场定位"@zh ;
                 rdfs:label "属于市场"@zh ;
                 owl:functionalProperty "true"^^xsd:boolean .

###  http://www.telecom-ontology.org/productops#hasMetric
:hasMetric rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :operation_metric ;
                 rdfs:comment "一个商品绑定多条运营指标快照"@zh ;
                 rdfs:label "监测指标"@zh .

###  http://www.telecom-ontology.org/productops#decomposedInto
:decomposedInto rdf:type owl:ObjectProperty ;
                 rdfs:domain :operation_metric ;
                 rdfs:range :metric_contribution ;
                 rdfs:comment "一条运营指标分解为多条指标贡献"@zh ;
                 rdfs:label "分解为"@zh .

###  http://www.telecom-ontology.org/productops#contributedByChannel
:contributedByChannel rdf:type owl:ObjectProperty ;
                 rdfs:domain :metric_contribution ;
                 rdfs:range :channel ;
                 rdfs:comment "指标贡献可关联销售渠道"@zh ;
                 rdfs:label "渠道贡献"@zh .

###  http://www.telecom-ontology.org/productops#contributedByBehavior
:contributedByBehavior rdf:type owl:ObjectProperty ;
                 rdfs:domain :metric_contribution ;
                 rdfs:range :user_behavior ;
                 rdfs:comment "指标贡献可关联用户行为"@zh ;
                 rdfs:label "行为贡献"@zh .

###  http://www.telecom-ontology.org/productops#contributedByPromotion
:contributedByPromotion rdf:type owl:ObjectProperty ;
                 rdfs:domain :metric_contribution ;
                 rdfs:range :promotion ;
                 rdfs:comment "指标贡献可关联促销活动"@zh ;
                 rdfs:label "促销贡献"@zh .

###  http://www.telecom-ontology.org/productops#contributedByCompetitor
:contributedByCompetitor rdf:type owl:ObjectProperty ;
                 rdfs:domain :metric_contribution ;
                 rdfs:range :competitor_offer ;
                 rdfs:comment "指标贡献可关联竞品"@zh ;
                 rdfs:label "竞品贡献"@zh .

###  http://www.telecom-ontology.org/productops#hasRiskFeature
:hasRiskFeature rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :risk_feature ;
                 rdfs:comment "商品按定价/销量等挂接风险特征"@zh ;
                 rdfs:label "存在风险"@zh .

###  http://www.telecom-ontology.org/productops#appliesPolicy
:appliesPolicy rdf:type owl:ObjectProperty ;
                 rdfs:domain :risk_feature ;
                 rdfs:range :risk_policy ;
                 rdfs:comment "一个风险特征适用多条风险政策"@zh ;
                 rdfs:label "适用政策"@zh .

###  http://www.telecom-ontology.org/productops#triggersFinding
:triggersFinding rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :audit_finding ;
                 rdfs:comment "对商品执行稽核后产生稽核发现"@zh ;
                 rdfs:label "触发稽核"@zh .

###  http://www.telecom-ontology.org/productops#basedOnPolicy
:basedOnPolicy rdf:type owl:ObjectProperty ;
                 rdfs:domain :audit_finding ;
                 rdfs:range :risk_policy ;
                 rdfs:comment "稽核发现基于一条风险政策条款"@zh ;
                 rdfs:label "基于政策"@zh ;
                 owl:functionalProperty "true"^^xsd:boolean .

###  http://www.telecom-ontology.org/productops#recommendsStrategy
:recommendsStrategy rdf:type owl:ObjectProperty ;
                 rdfs:domain :audit_finding ;
                 rdfs:range :optimization_strategy ;
                 rdfs:comment "稽核发现推荐一条或多条优化策略"@zh ;
                 rdfs:label "推荐策略"@zh .

###  http://www.telecom-ontology.org/productops#producesAttribution
:producesAttribution rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :attribution_result ;
                 rdfs:comment "对商品发起指标归因后产生归因结论"@zh ;
                 rdfs:label "产生归因"@zh .

###  http://www.telecom-ontology.org/productops#targetsMetric
:targetsMetric rdf:type owl:ObjectProperty ;
                 rdfs:domain :attribution_result ;
                 rdfs:range :operation_metric ;
                 rdfs:comment "归因结论针对一条异常运营指标"@zh ;
                 rdfs:label "针对指标"@zh ;
                 owl:functionalProperty "true"^^xsd:boolean .

###  http://www.telecom-ontology.org/productops#generatesReport
:generatesReport rdf:type owl:ObjectProperty ;
                 rdfs:domain :attribution_result ;
                 rdfs:range :analysis_report ;
                 rdfs:comment "归因结论可生成归因简报"@zh ;
                 rdfs:label "生成报告"@zh .

###  http://www.telecom-ontology.org/productops#generatesAuditReport
:generatesAuditReport rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :analysis_report ;
                 rdfs:comment "商品稽核完成后可生成稽核简报"@zh ;
                 rdfs:label "生成稽核报告"@zh .

###  http://www.telecom-ontology.org/productops#cannibalizes
:cannibalizes rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering ;
                 rdfs:range :offering ;
                 rdfs:comment "体验/零元商品对主力商品产生蚕食"@zh ;
                 rdfs:label "蚕食"@zh .

###  http://www.telecom-ontology.org/productops#triggersRiskByPrice
:triggersRiskByPrice rdf:type owl:ObjectProperty ;
                 rdfs:domain :price_plan ;
                 rdfs:range :risk_feature ;
                 rdfs:comment "零元定价触发零元资费风险特征"@zh ;
                 rdfs:label "定价触发风险"@zh .

###  http://www.telecom-ontology.org/productops#relatedToOffering
:relatedToOffering rdf:type owl:ObjectProperty ;
                 rdfs:domain :audit_finding ;
                 rdfs:range :offering ;
                 rdfs:comment "一条稽核发现关联一个目标商品"@zh ;
                 rdfs:label "关联商品"@zh ;
                 owl:functionalProperty "true"^^xsd:boolean .

#################################################################
#    Data properties
#################################################################

###  http://www.telecom-ontology.org/productops#offeringId
:offeringId rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :offering
                                     :price_plan
                                     :fav_rule
                                     :promotion
                                     :channel
                                     :user_behavior
                                     :competitor_offer
                                     :market_scope
                                     :operation_metric
                                     :audit_finding
                                     :optimization_strategy
                                     :attribution_result
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:label "offeringId"@en ,
                    "商品编码"@zh .

###  http://www.telecom-ontology.org/productops#offeringName
:offeringName rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:string ;
         rdfs:label "offeringName"@en ,
                    "商品名称"@zh .

###  http://www.telecom-ontology.org/productops#state
:state rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:string ;
         rdfs:comment "上架/下架/待生效/失效"@zh ;
         rdfs:label "state"@en ,
                    "商品状态"@zh .

###  http://www.telecom-ontology.org/productops#shelfDays
:shelfDays rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:integer ;
         rdfs:comment "≥0"@zh ;
         rdfs:label "shelfDays"@en ,
                    "在架天数"@zh .

###  http://www.telecom-ontology.org/productops#offeringType
:offeringType rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:string ;
         rdfs:comment "主套餐/附加/体验包/校园包"@zh ;
         rdfs:label "offeringType"@en ,
                    "商品类型"@zh .

###  http://www.telecom-ontology.org/productops#hasContract
:hasContract rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:integer ;
         rdfs:comment "0:无，1:有"@zh ;
         rdfs:label "hasContract"@en ,
                    "是否有合约"@zh .

###  http://www.telecom-ontology.org/productops#strategicTag
:strategicTag rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:string ;
         rdfs:comment "战略/普通/空"@zh ;
         rdfs:label "strategicTag"@en ,
                    "战略标签"@zh .

###  http://www.telecom-ontology.org/productops#salesCnt30d
:salesCnt30d rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:integer ;
         rdfs:comment "≥0"@zh ;
         rdfs:label "salesCnt30d"@en ,
                    "近30日销量"@zh .

###  http://www.telecom-ontology.org/productops#revenue30d
:revenue30d rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:float ;
         rdfs:comment "单位：元"@zh ;
         rdfs:label "revenue30d"@en ,
                    "近30日收入"@zh .

###  http://www.telecom-ontology.org/productops#conversionToPaidRate
:conversionToPaidRate rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:float ;
         rdfs:comment "0~1"@zh ;
         rdfs:label "conversionToPaidRate"@en ,
                    "转正率"@zh .

###  http://www.telecom-ontology.org/productops#monthlyUsers
:monthlyUsers rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:integer ;
         rdfs:comment "≥0"@zh ;
         rdfs:label "monthlyUsers"@en ,
                    "月活用户数"@zh .

###  http://www.telecom-ontology.org/productops#cannibalizeRate
:cannibalizeRate rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:float ;
         rdfs:comment "0~1"@zh ;
         rdfs:label "cannibalizeRate"@en ,
                    "蚕食率"@zh .

###  http://www.telecom-ontology.org/productops#cannibalizeTargetId
:cannibalizeTargetId rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering ;
         rdfs:range xsd:string ;
         rdfs:comment "被蚕食商品编码"@zh ;
         rdfs:label "cannibalizeTargetId"@en ,
                    "被蚕食商品编码"@zh .

###  http://www.telecom-ontology.org/productops#prcId
:prcId rdf:type owl:DatatypeProperty ;
         rdfs:domain :price_plan ;
         rdfs:range xsd:string ;
         rdfs:label "prcId"@en ,
                    "定价编码"@zh .

###  http://www.telecom-ontology.org/productops#monthlyFee
:monthlyFee rdf:type owl:DatatypeProperty ;
         rdfs:domain :price_plan ;
         rdfs:range xsd:float ;
         rdfs:comment "单位：元/月"@zh ;
         rdfs:label "monthlyFee"@en ,
                    "月资费"@zh .

###  http://www.telecom-ontology.org/productops#oneTimeFee
:oneTimeFee rdf:type owl:DatatypeProperty ;
         rdfs:domain :price_plan ;
         rdfs:range xsd:float ;
         rdfs:comment "营业费用"@zh ;
         rdfs:label "oneTimeFee"@en ,
                    "一次性费用"@zh .

###  http://www.telecom-ontology.org/productops#feeType
:feeType rdf:type owl:DatatypeProperty ;
         rdfs:domain :price_plan ;
         rdfs:range xsd:string ;
         rdfs:comment "标准/低价/零元/体验零元"@zh ;
         rdfs:label "feeType"@en ,
                    "资费类型"@zh .

###  http://www.telecom-ontology.org/productops#favId
:favId rdf:type owl:DatatypeProperty ;
         rdfs:domain :fav_rule ;
         rdfs:range xsd:string ;
         rdfs:label "favId"@en ,
                    "优惠编码"@zh .

###  http://www.telecom-ontology.org/productops#favType
:favType rdf:type owl:DatatypeProperty ;
         rdfs:domain :fav_rule ;
         rdfs:range xsd:string ;
         rdfs:comment "折扣/直降/赠送"@zh ;
         rdfs:label "favType"@en ,
                    "优惠类型"@zh .

###  http://www.telecom-ontology.org/productops#discountRate
:discountRate rdf:type owl:DatatypeProperty ;
         rdfs:domain :fav_rule ;
         rdfs:range xsd:float ;
         rdfs:comment "0~1，1表示全额赠送"@zh ;
         rdfs:label "discountRate"@en ,
                    "折扣比例"@zh .

###  http://www.telecom-ontology.org/productops#repeatable
:repeatable rdf:type owl:DatatypeProperty ;
         rdfs:domain :fav_rule ;
         rdfs:range xsd:integer ;
         rdfs:comment "0:否，1:是"@zh ;
         rdfs:label "repeatable"@en ,
                    "可重复订购"@zh .

###  http://www.telecom-ontology.org/productops#activityId
:activityId rdf:type owl:DatatypeProperty ;
         rdfs:domain :promotion ;
         rdfs:range xsd:string ;
         rdfs:label "activityId"@en ,
                    "促销编码"@zh .

###  http://www.telecom-ontology.org/productops#activityName
:activityName rdf:type owl:DatatypeProperty ;
         rdfs:domain :promotion ;
         rdfs:range xsd:string ;
         rdfs:label "activityName"@en ,
                    "促销名称"@zh .

###  http://www.telecom-ontology.org/productops#expDate
:expDate rdf:type owl:DatatypeProperty ;
         rdfs:domain :promotion ;
         rdfs:range xsd:date ;
         rdfs:comment "yyyy-mm-dd"@zh ;
         rdfs:label "expDate"@en ,
                    "结束时间"@zh .

###  http://www.telecom-ontology.org/productops#driveShare
:driveShare rdf:type owl:DatatypeProperty ;
         rdfs:domain :promotion ;
         rdfs:range xsd:float ;
         rdfs:comment "0~1"@zh ;
         rdfs:label "driveShare"@en ,
                    "历史带动订购占比"@zh .

###  http://www.telecom-ontology.org/productops#channelId
:channelId rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :channel
                                     :user_behavior
                                     :metric_contribution
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:label "channelId"@en ,
                    "渠道编码"@zh .

###  http://www.telecom-ontology.org/productops#channelName
:channelName rdf:type owl:DatatypeProperty ;
         rdfs:domain :channel ;
         rdfs:range xsd:string ;
         rdfs:label "channelName"@en ,
                    "渠道名称"@zh .

###  http://www.telecom-ontology.org/productops#channelType
:channelType rdf:type owl:DatatypeProperty ;
         rdfs:domain :channel ;
         rdfs:range xsd:string ;
         rdfs:comment "电渠/营业厅/网格/代理"@zh ;
         rdfs:label "channelType"@en ,
                    "渠道类型"@zh .

###  http://www.telecom-ontology.org/productops#behaviorId
:behaviorId rdf:type owl:DatatypeProperty ;
         rdfs:domain :user_behavior ;
         rdfs:range xsd:string ;
         rdfs:label "behaviorId"@en ,
                    "行为编码"@zh .

###  http://www.telecom-ontology.org/productops#behaviorType
:behaviorType rdf:type owl:DatatypeProperty ;
         rdfs:domain :user_behavior ;
         rdfs:range xsd:string ;
         rdfs:comment "订购量/退订量/续约率"@zh ;
         rdfs:label "behaviorType"@en ,
                    "行为类型"@zh .

###  http://www.telecom-ontology.org/productops#behaviorValue
:behaviorValue rdf:type owl:DatatypeProperty ;
         rdfs:domain :user_behavior ;
         rdfs:range xsd:float ;
         rdfs:label "behaviorValue"@en ,
                    "行为值"@zh .

###  http://www.telecom-ontology.org/productops#wowChange
:wowChange rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :user_behavior
                                     :operation_metric
                                   )
                     ] ;
         rdfs:range xsd:float ;
         rdfs:comment "如-0.18表示下降18%"@zh ;
         rdfs:label "wowChange"@en ,
                    "环比变化"@zh .

###  http://www.telecom-ontology.org/productops#competitorId
:competitorId rdf:type owl:DatatypeProperty ;
         rdfs:domain :competitor_offer ;
         rdfs:range xsd:string ;
         rdfs:label "competitorId"@en ,
                    "竞品编码"@zh .

###  http://www.telecom-ontology.org/productops#competitorName
:competitorName rdf:type owl:DatatypeProperty ;
         rdfs:domain :competitor_offer ;
         rdfs:range xsd:string ;
         rdfs:label "competitorName"@en ,
                    "竞品名称"@zh .

###  http://www.telecom-ontology.org/productops#actionDesc
:actionDesc rdf:type owl:DatatypeProperty ;
         rdfs:domain :competitor_offer ;
         rdfs:range xsd:string ;
         rdfs:label "actionDesc"@en ,
                    "动作描述"@zh .

###  http://www.telecom-ontology.org/productops#priceGap
:priceGap rdf:type owl:DatatypeProperty ;
         rdfs:domain :competitor_offer ;
         rdfs:range xsd:float ;
         rdfs:comment "本商品月费-竞品月费"@zh ;
         rdfs:label "priceGap"@en ,
                    "月费对标差"@zh .

###  http://www.telecom-ontology.org/productops#impactScore
:impactScore rdf:type owl:DatatypeProperty ;
         rdfs:domain :competitor_offer ;
         rdfs:range xsd:float ;
         rdfs:comment "0~1"@zh ;
         rdfs:label "impactScore"@en ,
                    "冲击评分"@zh .

###  http://www.telecom-ontology.org/productops#marketId
:marketId rdf:type owl:DatatypeProperty ;
         rdfs:domain :market_scope ;
         rdfs:range xsd:string ;
         rdfs:label "marketId"@en ,
                    "市场编码"@zh .

###  http://www.telecom-ontology.org/productops#marketPosition
:marketPosition rdf:type owl:DatatypeProperty ;
         rdfs:domain :market_scope ;
         rdfs:range xsd:string ;
         rdfs:comment "大众/家庭/校园/政企"@zh ;
         rdfs:label "marketPosition"@en ,
                    "市场定位"@zh .

###  http://www.telecom-ontology.org/productops#penetrationRate
:penetrationRate rdf:type owl:DatatypeProperty ;
         rdfs:domain :market_scope ;
         rdfs:range xsd:float ;
         rdfs:comment "0~1"@zh ;
         rdfs:label "penetrationRate"@en ,
                    "渗透率"@zh .

###  http://www.telecom-ontology.org/productops#metricId
:metricId rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :operation_metric
                                     :metric_contribution
                                     :attribution_result
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:label "metricId"@en ,
                    "指标编码"@zh .

###  http://www.telecom-ontology.org/productops#metricName
:metricName rdf:type owl:DatatypeProperty ;
         rdfs:domain :operation_metric ;
         rdfs:range xsd:string ;
         rdfs:comment "累计收入/留存率/离网率/转化率"@zh ;
         rdfs:label "metricName"@en ,
                    "指标名称"@zh .

###  http://www.telecom-ontology.org/productops#metricCode
:metricCode rdf:type owl:DatatypeProperty ;
         rdfs:domain :operation_metric ;
         rdfs:range xsd:string ;
