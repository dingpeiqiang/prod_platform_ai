#################################################################
#    Classes
#################################################################

###  http://www.telecom-ontology.org/productops#offering
:offering rdf:type owl:Class ;
           rdfs:comment "面向销售的产商品主体（对应规范商品实体），定义销售什么产品以及怎么销售，是运营监测、根因归因与风险稽核的图谱中心节点"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "offering"@en ,
                      "商品"@zh ;
           rdfs:seeAlso "销售品"@zh ,
           rdfs:seeAlso "套餐"@zh ,
           rdfs:seeAlso "产商品主体"@zh ,
           rdfs:seeAlso "商品"@zh .

###  http://www.telecom-ontology.org/productops#price_plan
:price_plan rdf:type owl:Class ;
           rdfs:comment "商品出售或租赁时设定的价格体系，含营业费用、账务/计费资费；定价上移至商品后，用于零元资费等高风险识别"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "price_plan"@en ,
                      "商品定价"@zh ;
           rdfs:seeAlso "定价计划"@zh ,
           rdfs:seeAlso "资费"@zh ,
           rdfs:seeAlso "套餐定价"@zh .

###  http://www.telecom-ontology.org/productops#fav_rule
:fav_rule rdf:type owl:Class ;
           rdfs:comment "对客户订购商品进行优惠的方式及规则（折扣/直降/赠送等），用于异常优惠与融合优惠稽核"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "fav_rule"@en ,
                      "优惠规则"@zh ;
           rdfs:seeAlso "优惠"@zh ,
           rdfs:seeAlso "折扣规则"@zh ,
           rdfs:seeAlso "优惠信息"@zh .

###  http://www.telecom-ontology.org/productops#promotion
:promotion rdf:type owl:Class ;
           rdfs:comment "在特定时间针对特定目标群体使用特定销售手段的促销（对原营销活动升级），可参与异动归因与团购优惠场景"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "promotion"@en ,
                      "促销活动"@zh ;
           rdfs:seeAlso "营销活动"@zh ,
           rdfs:seeAlso "促销"@zh ,
           rdfs:seeAlso "活动"@zh .

###  http://www.telecom-ontology.org/productops#channel
:channel rdf:type owl:Class ;
           rdfs:comment "商品可销售的渠道触点（电渠/营业厅/网格/代理等），用于将运营指标按渠道拆解贡献度"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "channel"@en ,
                      "销售渠道"@zh ;
           rdfs:seeAlso "渠道"@zh ,
           rdfs:seeAlso "办理渠道"@zh ,
           rdfs:seeAlso "分销渠道"@zh .

###  http://www.telecom-ontology.org/productops#user_behavior
:user_behavior rdf:type owl:Class ;
           rdfs:comment "与商品相关的订购、退订、转化、续约等行为统计，支撑异动根因中的行为佐证"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "user_behavior"@en ,
                      "用户行为"@zh ;
           rdfs:seeAlso "行为指标"@zh ,
           rdfs:seeAlso "订购行为"@zh ,
           rdfs:seeAlso "用户行为"@zh .

###  http://www.telecom-ontology.org/productops#competitor_offer
:competitor_offer rdf:type owl:Class ;
           rdfs:comment "外部友商同类商品或促销动作，用于竞争压力类根因推理"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "competitor_offer"@en ,
                      "竞品"@zh ;
           rdfs:seeAlso "竞品动作"@zh ,
           rdfs:seeAlso "友商产品"@zh ,
           rdfs:seeAlso "竞争分析"@zh .

###  http://www.telecom-ontology.org/productops#market_scope
:market_scope rdf:type owl:Class ;
           rdfs:comment "商品所属市场范围、容量、渗透率等市场侧属性，支撑市场饱和度等排除/佐证"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "market_scope"@en ,
                      "产品市场"@zh ;
           rdfs:seeAlso "市场属性"@zh ,
           rdfs:seeAlso "市场定位"@zh ,
           rdfs:seeAlso "产品市场"@zh .

###  http://www.telecom-ontology.org/productops#operation_metric
:operation_metric rdf:type owl:Class ;
           rdfs:comment "商品在指定周期的关键运营指标快照（累计收入、留存率、离网率、转化率等）及环比变化，支撑异动监测"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "operation_metric"@en ,
                      "运营指标"@zh ;
           rdfs:seeAlso "KPI"@zh ,
           rdfs:seeAlso "经营指标"@zh ,
           rdfs:seeAlso "监测指标"@zh .

###  http://www.telecom-ontology.org/productops#metric_contribution
:metric_contribution rdf:type owl:Class ;
           rdfs:comment "渠道或用户行为维度对某运营指标变化的量化贡献，含贡献降幅与占比，支撑主因认定"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "metric_contribution"@en ,
                      "指标贡献"@zh ;
           rdfs:seeAlso "贡献度"@zh ,
           rdfs:seeAlso "分解项"@zh ,
           rdfs:seeAlso "归因因子"@zh .

###  http://www.telecom-ontology.org/productops#risk_feature
:risk_feature rdf:type owl:Class ;
           rdfs:comment "商品可能触发的风险画像特征（零元资费、长期零销、异常优惠、套餐蚕食等）"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "risk_feature"@en ,
                      "风险特征"@zh ;
           rdfs:seeAlso "风险类型"@zh ,
           rdfs:seeAlso "风险画像"@zh ,
           rdfs:seeAlso "风险特征"@zh .

###  http://www.telecom-ontology.org/productops#risk_policy
:risk_policy rdf:type owl:Class ;
           rdfs:comment "预置的风险稽核政策条款，含阈值表达式与严重级别，命中后形成可审计证据链"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "risk_policy"@en ,
                      "风险政策"@zh ;
           rdfs:seeAlso "稽核政策"@zh ,
           rdfs:seeAlso "合规条款"@zh ,
           rdfs:seeAlso "规则阈值"@zh .

###  http://www.telecom-ontology.org/productops#audit_finding
:audit_finding rdf:type owl:Class ;
           rdfs:comment "风险政策命中后产生的结构化稽核记录，含证据、得分与关联商品"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "audit_finding"@en ,
                      "稽核发现"@zh ;
           rdfs:seeAlso "稽核命中"@zh ,
           rdfs:seeAlso "审计发现"@zh ,
           rdfs:seeAlso "风险证据"@zh .

###  http://www.telecom-ontology.org/productops#optimization_strategy
:optimization_strategy rdf:type owl:Class ;
           rdfs:comment "针对稽核发现或归因结论推荐的处置策略（限售/下架/续促销/厅店激励/转正引导等）"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "optimization_strategy"@en ,
                      "优化策略"@zh ;
           rdfs:seeAlso "处置建议"@zh ,
           rdfs:seeAlso "优化建议"@zh ,
           rdfs:seeAlso "整改策略"@zh .

###  http://www.telecom-ontology.org/productops#attribution_result
:attribution_result rdf:type owl:Class ;
           rdfs:comment "指标异动智能归因后输出的结构化根因结论，记录推理路径、主因、排除项、置信度与结论文本"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "attribution_result"@en ,
                      "归因结论"@zh ;
           rdfs:seeAlso "根因结论"@zh ,
           rdfs:seeAlso "异动归因"@zh ,
           rdfs:seeAlso "分析结论"@zh .

###  http://www.telecom-ontology.org/productops#analysis_report
:analysis_report rdf:type owl:Class ;
           rdfs:comment "智能体自动生成的业务简报载体（归因简报/稽核简报），绑定推理结果与自然语言叙述"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "analysis_report"@en ,
                      "分析报告"@zh ;
           rdfs:seeAlso "智能简报"@zh ,
           rdfs:seeAlso "稽核报告"@zh ,
           rdfs:seeAlso "归因报告"@zh .

