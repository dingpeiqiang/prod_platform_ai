#################################################################
#    Rules
#################################################################

[ rdfs:comment "IF 运营指标.环比变化 ≤ -10% AND 告警标识=1 AND 商品.商品状态=上架 → 触发归因工作流，进入多维根因推理"@zh ;
  rdfs:label "metric_anomaly_trigger"@en ,
             "指标异动触发"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 某渠道指标贡献.贡献占比 ≥ 30% AND 该渠道行为环比 ≤ -20% → 标记该渠道为primary_cause，写入主因列表"@zh ;
  rdfs:label "channel_primary_cause"@en ,
             "渠道主因认定"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 促销活动.结束时间距今 ≤ 7天 AND 历史带动订购占比 ≥ 25% → 将促销到期追加为次因/主因候选"@zh ;
  rdfs:label "promotion_expiry_cause"@en ,
             "促销到期主因认定"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 竞品.月费对标差 ≥ 15元 OR 冲击评分 ≥ 0.7 → 追加竞品压力路径并提升置信度"@zh ;
  rdfs:label "competitor_pressure_cause"@en ,
             "竞品压力主因认定"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 用户行为.环比变化显著恶化（如续约率下降） → 作为佐证节点挂接推理路径"@zh ;
  rdfs:label "behavior_evidence"@en ,
             "行为佐证"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 同城同类商品同周期指标环比中位数 > -5% → 将「全省/大盘下滑」写入排除项"@zh ;
  rdfs:label "exclude_macro_decline"@en ,
             "排除大盘因素"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 商品定价.月资费=0 AND 一次性费用=0 AND 非权益赠送白名单 AND 商品状态=上架 → 挂接风险特征「零元资费」，生成稽核发现（规则R-B01）"@zh ;
  rdfs:label "zero_fee_risk_hit"@en ,
             "零元资费风险命中"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 已命中零元资费 AND 是否有合约=0 → 风险等级=高，预警升级（规则R-B02）"@zh ;
  rdfs:label "zero_fee_no_contract_high"@en ,
             "零元无合约定级"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 近30日销量=0 AND 在架天数>180 AND 战略标签为空 → 挂接风险特征「长期零销」，建议下架（规则R-B03/B04）"@zh ;
  rdfs:label "long_zero_sales_hit"@en ,
             "长期零销命中"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 优惠规则.折扣比例=1 AND 可重复订购=1 AND 商品状态=上架 → 挂接风险特征「异常优惠」，建议限售+复核"@zh ;
  rdfs:label "abnormal_fav_hit"@en ,
             "异常优惠命中"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 蚕食率 ≥ 20% AND 存在被蚕食商品编码 → 挂接风险特征「套餐蚕食」，生成稽核发现"@zh ;
  rdfs:label "cannibalize_hit"@en ,
             "套餐蚕食命中"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 风险等级=高 AND （零元无合约 OR 稽核总分≥70） → 推荐「立即下架/转验证渠道」策略"@zh ;
  rdfs:label "strategy_map_offline"@en ,
             "策略映射_立即下架"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 风险等级=高 AND 异常优惠命中 → 推荐「限售+优惠规则复核」"@zh ;
  rdfs:label "strategy_map_limit"@en ,
             "策略映射_限售复核"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 长期零销命中 → 推荐「下架归档减负」"@zh ;
  rdfs:label "strategy_map_retire"@en ,
             "策略映射_优胜劣汰下架"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 主因=销售渠道 AND 渠道类型=营业厅 → 推荐「厅店专项激励/检查品类下沉」"@zh ;
  rdfs:label "strategy_channel_incentive"@en ,
             "归因策略_厅店激励"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

[ rdfs:comment "IF 主因=促销活动到期 → 推荐「续期或替换促销模板」"@zh ;
  rdfs:label "strategy_renew_promo"@en ,
             "归因策略_续促销"@zh ;
  rdf:type swrl:Imp ;
  swrl:body rdf:nil ;
  swrl:head rdf:nil
] .

