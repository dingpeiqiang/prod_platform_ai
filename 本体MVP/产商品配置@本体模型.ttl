@prefix : <http://www.telecom-ontology.org/productconfig#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@base <http://www.telecom-ontology.org/productconfig#> .

<http://www.telecom-ontology.org/productconfig> rdf:type owl:Ontology ;
                                                 owl:imports <http://www.w3.org/2003/11/swrl> ;
                                                 rdfs:comment "电信产商品配置领域本体模型，基于企业本体架构框架与《一级产商品中心与省级平台接口规范》设计。以商品配置草稿为中心，覆盖智聊对话配置与智读批量生成两大MVP，支撑字段推理填报、合规校验与逻辑报文导出。"@zh ;
                                                 rdfs:label "产商品配置本体模型"@zh ;
                                                 owl:versionInfo "1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2002/07/owl#functionalProperty
owl:functionalProperty rdf:type owl:AnnotationProperty .

#################################################################
#    Object Properties
#################################################################

###  http://www.telecom-ontology.org/productconfig#hasElement
:hasElement rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering_config ;
                 rdfs:range :product_element ;
                 rdfs:comment "一个商品配置草稿包含多个产品要素属性"@zh ;
                 rdfs:label "包含要素"@zh .

###  http://www.telecom-ontology.org/productconfig#hasPricePlan
:hasPricePlan rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering_config ;
                 rdfs:range :price_plan ;
                 rdfs:comment "一个商品配置草稿拥有商品定价"@zh ;
                 rdfs:label "拥有定价"@zh ;
                 owl:functionalProperty "true"^^xsd:boolean .

###  http://www.telecom-ontology.org/productconfig#constrainedBy
:constrainedBy rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering_config ;
                 rdfs:range :config_rule ;
                 rdfs:comment "一个草稿受多条配置规则约束"@zh ;
                 rdfs:label "受约束于"@zh .

###  http://www.telecom-ontology.org/productconfig#forTargetUser
:forTargetUser rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering_config ;
                 rdfs:range :target_user ;
                 rdfs:comment "一个草稿面向一个目标用户群"@zh ;
                 rdfs:label "面向用户"@zh ;
                 owl:functionalProperty "true"^^xsd:boolean .

###  http://www.telecom-ontology.org/productconfig#inScenario
:inScenario rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering_config ;
                 rdfs:range :biz_scenario ;
                 rdfs:comment "一个草稿归属一个业务场景"@zh ;
                 rdfs:label "归属场景"@zh ;
                 owl:functionalProperty "true"^^xsd:boolean .

###  http://www.telecom-ontology.org/productconfig#appliesPolicy
:appliesPolicy rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering_config ;
                 rdfs:range :market_policy ;
                 rdfs:comment "一个草稿可适用营销政策"@zh ;
                 rdfs:label "适用政策"@zh .

###  http://www.telecom-ontology.org/productconfig#basedOnTemplate
:basedOnTemplate rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering_config ;
                 rdfs:range :config_template ;
                 rdfs:comment "一个草稿可基于配置模板生成"@zh ;
                 rdfs:label "基于模板"@zh ;
                 owl:functionalProperty "true"^^xsd:boolean .

###  http://www.telecom-ontology.org/productconfig#hasRelation
:hasRelation rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering_config ;
                 rdfs:range :goods_relation ;
                 rdfs:comment "一个草稿可存在与在架商品的关系"@zh ;
                 rdfs:label "存在关系"@zh .

###  http://www.telecom-ontology.org/productconfig#hasIssue
:hasIssue rdf:type owl:ObjectProperty ;
                 rdfs:domain :offering_config ;
                 rdfs:range :compliance_issue ;
                 rdfs:comment "校验后草稿产生零条或多条合规问题"@zh ;
                 rdfs:label "产生问题"@zh .

###  http://www.telecom-ontology.org/productconfig#suggestsDefault
:suggestsDefault rdf:type owl:ObjectProperty ;
                 rdfs:domain :biz_scenario ;
                 rdfs:range :product_element ;
                 rdfs:comment "业务场景对产品要素给出缺省值"@zh ;
                 rdfs:label "缺省建议"@zh .

###  http://www.telecom-ontology.org/productconfig#matchesTemplate
:matchesTemplate rdf:type owl:ObjectProperty ;
                 rdfs:domain :biz_scenario ;
                 rdfs:range :config_template ;
                 rdfs:comment "业务场景匹配配置模板"@zh ;
                 rdfs:label "匹配模板"@zh .

###  http://www.telecom-ontology.org/productconfig#definesElement
:definesElement rdf:type owl:ObjectProperty ;
                 rdfs:domain :config_template ;
                 rdfs:range :product_element ;
                 rdfs:comment "配置模板定义缺省产品要素"@zh ;
                 rdfs:label "定义要素"@zh .

###  http://www.telecom-ontology.org/productconfig#definesField
:definesField rdf:type owl:ObjectProperty ;
                 rdfs:domain :config_template ;
                 rdfs:range :field_meta ;
                 rdfs:comment "配置模板定义字段元数据"@zh ;
                 rdfs:label "定义字段"@zh .

###  http://www.telecom-ontology.org/productconfig#mapsToElement
:mapsToElement rdf:type owl:ObjectProperty ;
                 rdfs:domain :field_meta ;
                 rdfs:range :product_element ;
                 rdfs:comment "字段元数据映射到业务产品要素"@zh ;
                 rdfs:label "映射要素"@zh .

###  http://www.telecom-ontology.org/productconfig#blocksDraft
:blocksDraft rdf:type owl:ObjectProperty ;
                 rdfs:domain :config_rule ;
                 rdfs:range :offering_config ;
                 rdfs:comment "高严重级别规则命中时阻断草稿提交"@zh ;
                 rdfs:label "阻断草稿"@zh .

###  http://www.telecom-ontology.org/productconfig#triggersJob
:triggersJob rdf:type owl:ObjectProperty ;
                 rdfs:domain :solution_document ;
                 rdfs:range :batch_job ;
                 rdfs:comment "方案文档触发批量任务"@zh ;
                 rdfs:label "触发任务"@zh .

###  http://www.telecom-ontology.org/productconfig#generatesDraft
:generatesDraft rdf:type owl:ObjectProperty ;
                 rdfs:domain :batch_job ;
                 rdfs:range :offering_config ;
                 rdfs:comment "批量任务生成多条配置草稿"@zh ;
                 rdfs:label "生成草稿"@zh .

###  http://www.telecom-ontology.org/productconfig#basedOnRule
:basedOnRule rdf:type owl:ObjectProperty ;
                 rdfs:domain :compliance_issue ;
                 rdfs:range :config_rule ;
                 rdfs:comment "合规问题基于一条配置规则"@zh ;
                 rdfs:label "基于规则"@zh ;
                 owl:functionalProperty "true"^^xsd:boolean .

#################################################################
#    Data properties
#################################################################

###  http://www.telecom-ontology.org/productconfig#draftId
:draftId rdf:type owl:DatatypeProperty ;
         rdfs:domain [ rdf:type owl:Class ;
                       owl:unionOf ( :offering_config
                                     :product_element
                                     :price_plan
                                     :market_policy
                                     :compliance_issue
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:label "draftId"@en ,
                    "草稿编码"@zh .

###  http://www.telecom-ontology.org/productconfig#offeringName
:offeringName rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering_config ;
         rdfs:range xsd:string ;
         rdfs:label "offeringName"@en ,
                    "商品名称"@zh .

###  http://www.telecom-ontology.org/productconfig#offeringType
:offeringType rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering_config ;
         rdfs:range xsd:string ;
         rdfs:comment "主套餐/附加/体验包/融合包"@zh ;
         rdfs:label "offeringType"@en ,
                    "商品类型"@zh .

###  http://www.telecom-ontology.org/productconfig#channelScope
:channelScope rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering_config ;
         rdfs:range xsd:string ;
         rdfs:label "channelScope"@en ,
                    "渠道范围"@zh .

###  http://www.telecom-ontology.org/productconfig#chnClassLimit
:chnClassLimit rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering_config ;
         rdfs:range xsd:string ;
         rdfs:comment "发布信息"@zh ;
         rdfs:label "chnClassLimit"@en ,
                    "发布渠道码"@zh .

###  http://www.telecom-ontology.org/productconfig#groupId
:groupId rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering_config ;
         rdfs:range xsd:string ;
         rdfs:comment "全省/非全省"@zh ;
         rdfs:label "groupId"@en ,
                    "发布地市"@zh .

###  http://www.telecom-ontology.org/productconfig#groupIdMessage
:groupIdMessage rdf:type owl:DatatypeProperty ;
