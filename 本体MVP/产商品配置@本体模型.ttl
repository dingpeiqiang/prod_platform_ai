                       owl:unionOf ( :offering_config
                                     :config_template
                                   )
                     ] ;
         rdfs:range xsd:string ;
         rdfs:comment "personMainPrc/broadBandMainPrc/personAddPrc/broadBandOptSpeedPrc/familyBasePrc/familyAddPrc"@zh ;
         rdfs:label "msgTemplateId"@en ,
                    "报文模板编码"@zh .

###  http://www.telecom-ontology.org/productconfig#opType
:opType rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering_config ;
         rdfs:range xsd:string ;
         rdfs:comment "a:新增，u:修改"@zh ;
         rdfs:label "opType"@en ,
                    "变更类型"@zh .

###  http://www.telecom-ontology.org/productconfig#prodId
:prodId rdf:type owl:DatatypeProperty ;
         rdfs:domain :offering_config ;
         rdfs:range xsd:string ;
