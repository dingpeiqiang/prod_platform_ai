#################################################################
#    Classes
#################################################################

###  http://www.telecom-ontology.org/productconfig#offering_config
:offering_config rdf:type owl:Class ;
           rdfs:comment "配置会话中待落库的商品实例，智聊画布与智读批量的中心节点"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "offering_config"@en ,
                      "商品配置草稿"@zh ;
           rdfs:seeAlso "配置草稿"@zh ,
           rdfs:seeAlso "商品草稿"@zh ,
           rdfs:seeAlso "销售品配置"@zh .

###  http://www.telecom-ontology.org/productconfig#product_element
:product_element rdf:type owl:Class ;
           rdfs:comment "可配置的产品/服务规格要素，如语音、流量、宽带、套外计费"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "product_element"@en ,
                      "产品要素属性"@zh ;
           rdfs:seeAlso "产品要素"@zh ,
           rdfs:seeAlso "规格属性"@zh ,
           rdfs:seeAlso "配置项"@zh .

###  http://www.telecom-ontology.org/productconfig#price_plan
:price_plan rdf:type owl:Class ;
           rdfs:comment "月资费、一次性费用、资费类型，用于资费冲突与零元风险判定"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "price_plan"@en ,
                      "商品定价"@zh ;
           rdfs:seeAlso "定价计划"@zh ,
           rdfs:seeAlso "资费"@zh ,
           rdfs:seeAlso "套餐定价"@zh .

###  http://www.telecom-ontology.org/productconfig#config_rule
:config_rule rdf:type owl:Class ;
           rdfs:comment "互斥、依赖、必填、资费风险及提交校验规则"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "config_rule"@en ,
                      "配置规则"@zh ;
           rdfs:seeAlso "销售规则"@zh ,
           rdfs:seeAlso "关系规则"@zh ,
           rdfs:seeAlso "校验规则"@zh .

###  http://www.telecom-ontology.org/productconfig#goods_relation
:goods_relation rdf:type owl:Class ;
           rdfs:comment "互斥、依赖、连带订购等商品关系"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "goods_relation"@en ,
                      "商品关系"@zh ;
           rdfs:seeAlso "互斥关系"@zh ,
           rdfs:seeAlso "依赖关系"@zh .

###  http://www.telecom-ontology.org/productconfig#config_template
:config_template rdf:type owl:Class ;
           rdfs:comment "配置母版，绑定六类报文模板编码之一"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "config_template"@en ,
                      "配置模板"@zh ;
           rdfs:seeAlso "商品模板"@zh ,
           rdfs:seeAlso "报文模板"@zh .

###  http://www.telecom-ontology.org/productconfig#field_meta
:field_meta rdf:type owl:Class ;
           rdfs:comment "对齐配置元素定义：jsonPath、必填、默认值、显隐条件"@zh ;
           rdfs:isDefinedBy "P_02 产品域" ;
           rdfs:label "field_meta"@en ,
                      "字段元数据"@zh ;
           rdfs:seeAlso "报文元素"@zh ,
           rdfs:seeAlso "配置字段"@zh .

###  http://www.telecom-ontology.org/productconfig#target_user
:target_user rdf:type owl:Class ;
           rdfs:comment "目标客户群：个人/家庭/政企/校园"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "target_user"@en ,
                      "目标用户"@zh ;
           rdfs:seeAlso "目标客户群"@zh ,
           rdfs:seeAlso "客群"@zh .

###  http://www.telecom-ontology.org/productconfig#biz_scenario
:biz_scenario rdf:type owl:Class ;
           rdfs:comment "驱动缺省字段与模板匹配的场景标签"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "biz_scenario"@en ,
                      "业务场景"@zh ;
           rdfs:seeAlso "配置场景"@zh ,
           rdfs:seeAlso "场景标签"@zh .

###  http://www.telecom-ontology.org/productconfig#market_policy
:market_policy rdf:type owl:Class ;
           rdfs:comment "折扣、赠送、合约等营销约束"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "market_policy"@en ,
                      "营销政策"@zh ;
           rdfs:seeAlso "促销政策"@zh ,
           rdfs:seeAlso "优惠规则"@zh .

###  http://www.telecom-ontology.org/productconfig#compliance_issue
:compliance_issue rdf:type owl:Class ;
           rdfs:comment "配置校验产生的结构化问题"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "compliance_issue"@en ,
                      "合规问题"@zh ;
           rdfs:seeAlso "校验问题"@zh ,
           rdfs:seeAlso "冲突项"@zh .

###  http://www.telecom-ontology.org/productconfig#solution_document
:solution_document rdf:type owl:Class ;
           rdfs:comment "智读上传的产品/营销方案文档"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "solution_document"@en ,
                      "方案文档"@zh ;
           rdfs:seeAlso "方案书"@zh ,
           rdfs:seeAlso "需求文档"@zh .

###  http://www.telecom-ontology.org/productconfig#batch_job
:batch_job rdf:type owl:Class ;
           rdfs:comment "一次智读批量映射任务"@zh ;
           rdfs:isDefinedBy "O_03 运营域" ;
           rdfs:label "batch_job"@en ,
                      "批量生成任务"@zh ;
           rdfs:seeAlso "批量任务"@zh ,
           rdfs:seeAlso "智读任务"@zh .

